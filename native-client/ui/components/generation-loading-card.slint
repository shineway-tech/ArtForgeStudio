import { AppState } from "../app-state.slint";
import { LoadingDots } from "loading-dots.slint";
import { AppTheme } from "../theme.slint";

export component GenerationLoadingCard {
    in property <length> card-width: 188px;
    in property <length> card-gap: 10px;
    in property <int> sequence-index: 0;
    in property <int> bounce-step: 0;
    property <bool> pulse-bright: false;
    width: root.card-width;
    height: root.card-width + root.card-gap;

    Timer {
        interval: AppState.reduced-motion ? 1400ms : 900ms;
        running: true;
        triggered => { root.pulse-bright = !root.pulse-bright; }
    }

    visual-card := Rectangle {
        y: root.bounce-offset();
        width: root.width;
        height: root.card-width;
        background: AppTheme.panel-soft;
        border-radius: 12px;
        border-width: 1px;
        border-color: AppTheme.border;
        LoadingDots {
            x: (parent.width - 64px) / 2;
            y: parent.height / 2 - 48px;
            width: 64px;
            height: 46px;
        }
        Text {
            x: 0px;
            y: parent.height / 2 + 6px;
            width: parent.width;
            height: 24px;
            text: AppState.en ? "Generating..." : "生成中...";
            color: AppTheme.accent-dark;
            font-size: 13px;
            font-weight: 400;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        breathing-border := Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;
            border-radius: 12px;
            border-width: 1px;
            border-color: AppTheme.accent;
            opacity: root.pulse-bright ? 0.78 : 0.18;
            animate opacity { duration: AppState.reduced-motion ? 0ms : 900ms; easing: ease-in-out; }
        }
        card-hover := TouchArea {
            width: parent.width;
            height: parent.height;
        }
        stop-button := Rectangle {
            x: parent.width - 38px;
            y: 10px;
            width: 28px;
            height: 28px;
            visible: card-hover.has-hover || stop-touch.has-hover;
            background: stop-touch.has-hover ? AppTheme.danger : AppTheme.panel.with-alpha(0.94);
            border-radius: 14px;
            border-width: 1px;
            border-color: AppTheme.danger.with-alpha(0.62);
            accessible-role: button;
            accessible-label: AppState.en ? "Stop generation" : "停止生成";

            Rectangle {
                x: (parent.width - 8px) / 2;
                y: (parent.height - 8px) / 2;
                width: 8px;
                height: 8px;
                border-radius: 2px;
                background: stop-touch.has-hover ? #ffffff : AppTheme.danger;
            }
            stop-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: pointer;
                clicked => { AppState.stop-generation(); }
            }
        }
        animate y { duration: AppState.reduced-motion ? 0ms : 65ms; easing: ease-in-out; }
    }

    function bounce-offset() -> length {
        let phase = Math.mod(root.bounce-step - root.sequence-index * 4 + 40, 40);
        return phase == 1 ? 0px - 1px
            : phase == 2 ? 0px - 2px
            : phase == 3 ? 0px - 4px
            : phase == 4 ? 0px - 6px
            : phase == 5 ? 0px - 7px
            : phase == 6 ? 0px - 6px
            : phase == 7 ? 0px - 4px
            : phase == 8 ? 0px - 2px
            : phase == 9 ? 0px - 1px
            : phase == 11 ? 1px
            : 0px;
    }
}
