import { ScrollView } from "std-widgets.slint";
import { AppState } from "../app-state.slint";
import { GenerateActionButton } from "generate-action-button.slint";
import { LoadingDots } from "loading-dots.slint";
import { InlineCustomPromptOverlay } from "inline-custom-prompt-overlay.slint";
import { PillButton } from "pill-button.slint";
import { ReferenceThumb } from "reference-thumb.slint";
import { UploadCard } from "upload-card.slint";
import { AppTheme } from "../theme.slint";

component PromptOptimizationAction {
    in property <string> text;
    in property <bool> active: false;
    in property <bool> disabled: false;
    callback clicked();
    height: 28px;

    Rectangle {
        opacity: root.disabled ? 0.38 : 1;
        background: transparent;
        border-width: 1px;
        border-color: root.active || (action-touch.has-hover && !root.disabled) ? AppTheme.accent : AppTheme.border;
        border-radius: 12px;

        Text {
            width: parent.width;
            height: parent.height;
            text: root.text;
            color: root.active || (action-touch.has-hover && !root.disabled) ? AppTheme.accent : AppTheme.muted;
            font-size: 12px;
            font-weight: 400;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
        }
        action-touch := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: root.disabled ? default : pointer;
            clicked => {
                if !root.disabled {
                    root.clicked();
                }
            }
        }
    }
}

export component PromptComposer {
    in property <bool> generation: false;
    in property <bool> show-generate-button: true;
    property <int> prompt-history-selected-index: 0;
    property <int> prompt-history-hovered-index: -1;
    property <bool> history-preview-close-pending: false;
    property <int> custom-prompt-selected-index: -1;
    property <length> prompt-history-scroll-y: 0px;
    property <length> custom-prompt-scroll-x: 0px;
    property <string> pending-custom-prompt-content: "";
    property <int> custom-prompt-insert-offset: 0;
    property <bool> custom-prompt-selection-pending: false;
    property <string> observed-prompt: AppState.prompt;
    property <string> prompt-editor-text: AppState.prompt;
    property <bool> prompt-editor-focus-pending: false;
    property <length> prompt-editor-font-size: AppState.settings-font-size * 1px + 2px;
    property <bool> geometry-sidebar-collapsed: AppState.sidebar-collapsed;
    property <bool> geometry-logged-in: AppState.logged-in;
    height: AppState.references.length > 0 || AppState.quote-title != "" ? 650px : 600px;

    function sync-reference-drop-bounds() {
        AppState.reference-drop-x = reference-drop.absolute-position.x / 1px;
        AppState.reference-drop-y = reference-drop.absolute-position.y / 1px;
        AppState.reference-drop-width = reference-drop.width / 1px;
        AppState.reference-drop-height = reference-drop.height / 1px;
    }

    init => { root.sync-reference-drop-bounds(); }
    changed width => { root.sync-reference-drop-bounds(); }
    changed height => { root.sync-reference-drop-bounds(); }
    changed geometry-sidebar-collapsed => { root.sync-reference-drop-bounds(); }
    changed geometry-logged-in => { root.sync-reference-drop-bounds(); }
    changed observed-prompt => { root.sync-prompt-editor-text(); }

    function sync-prompt-editor-text() {
        let expected = AppState.prompt;
        if root.prompt-editor-text != expected {
            root.prompt-editor-text = expected;
        }
    }

    function queue-custom-prompt-selection(value: string) {
        root.pending-custom-prompt-content = value;
        root.custom-prompt-selection-pending = true;
    }

    function apply-selected-prompt(value: string) {
        AppState.prompt-history-open = false;
        AppState.custom-prompt-open = false;
        root.close-history-preview();
        history-popup.close();
        custom-prompt-popup.close();
        prompt-input.focus();
        root.prompt-editor-text = value;
        AppState.normalize-prompt-editor-text(value, "");
        AppState.deep-optimization-applied-chinese = "";
        AppState.deep-optimization-applied-english = "";
        AppState.invalidate-deep-prompt-binding();
        prompt-input.set-selection-offsets(2147483647, 2147483647);
    }

    function clear-current-prompt() {
        AppState.prompt-history-open = false;
        AppState.custom-prompt-open = false;
        root.close-history-preview();
        history-popup.close();
        custom-prompt-popup.close();
        AppState.clear-custom-prompt-selections();
        AppState.prompt = "";
        root.prompt-editor-text = "";
        AppState.deep-optimization-applied-chinese = "";
        AppState.deep-optimization-applied-english = "";
        AppState.invalidate-deep-prompt-binding();
        prompt-input.focus();
        prompt-input.set-selection-offsets(0, 0);
    }

    function close-history-preview() {
        root.history-preview-close-pending = false;
        root.prompt-history-hovered-index = -1;
    }

    function sync-history-preview(index: int, hovered: bool) {
        if hovered {
            root.history-preview-close-pending = false;
            root.prompt-history-hovered-index = index;
        } else if root.prompt-history-hovered-index == index {
            root.history-preview-close-pending = true;
        }
    }

    function history-list-width() -> length {
        return root.width - 48px;
    }

    function history-list-height() -> length {
        return 52px + min(10, AppState.prompt-history.length) * 32px;
    }

    Timer {
        interval: 1ms;
        running: root.custom-prompt-selection-pending;
        triggered => {
            root.custom-prompt-selection-pending = false;
            let value = root.pending-custom-prompt-content;
            root.pending-custom-prompt-content = "";
            AppState.custom-prompt-open = false;
            custom-prompt-popup.close();
            let edit = AppState.apply-inline-custom-prompt(
                value,
                root.prompt-editor-text,
                root.custom-prompt-insert-offset,
            );
            root.prompt-editor-text = edit.text;
            prompt-input.focus();
            prompt-input.set-selection-offsets(edit.cursor-offset, edit.cursor-offset);
        }
    }

    Rectangle {
        background: AppTheme.panel-soft;
        border-radius: 16px;
        border-width: 1px;
        border-color: AppTheme.border;
        clip: false;

        reference-drop := DropArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            can-drop(event) => {
                return DragAction.copy;
            }
            dropped(event) => {
                return AppState.add-reference-from-transfer(event.data)
                    ? DragAction.copy
                    : DragAction.none;
            }
        }

        if AppState.quote-title != "": Rectangle {
            x: 24px;
            y: root.action-status-wraps() ? 76px : 50px;
            height: 34px;
            width: parent.width - 48px;
            background: AppTheme.panel-soft;
            border-radius: 8px;
            Text { x: 12px; width: parent.width - 54px; height: parent.height; text: (AppState.en ? "Quoted image: " : "引用图片：") + AppState.quote-title; color: AppTheme.muted; font-size: AppState.settings-font-size * 1px; font-weight: 400; vertical-alignment: center; overflow: elide; }
            Text { x: parent.width - 34px; width: 24px; height: parent.height; text: "×"; color: AppTheme.muted; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { width: parent.width; height: parent.height; clicked => { AppState.quote-title = ""; AppState.quote-prompt = ""; AppState.quote-ratio = ""; AppState.quote-quality = ""; AppState.quote-width = 0; AppState.quote-height = 0; } }
        }
        for ref[index] in AppState.references: ReferenceThumb {
            x: root.reference-x(index);
            y: root.reference-y(index);
            width: root.reference-card-size();
            height: root.reference-card-size();
            item: ref;
            ordinal: index + 1;
        }
        if AppState.references.length < root.max-reference-count(): UploadCard {
            x: root.reference-x(AppState.references.length);
            y: root.reference-y(AppState.references.length);
            width: root.reference-card-size();
            height: root.reference-card-size();
            label: AppState.en ? "Add image" : "添加图片";
            clicked => { AppState.add-reference(); }
        }
        PromptOptimizationAction {
            x: 24px;
            y: 14px;
            width: 64px;
            height: 24px;
            text: AppState.optimizing-prompt ? (AppState.en ? "Optimizing..." : "正在优化...") : (AppState.en ? "AI Optimize" : "AI优化");
            disabled: AppState.reasoning-model == "" || AppState.optimizing-prompt;
            clicked => { AppState.optimize-current-prompt(); }
        }
        PromptOptimizationAction {
            x: 94px;
            y: 14px;
            width: 112px;
            height: 24px;
            text: !AppState.style-analysis-available
                ? (AppState.en ? "Image analysis unavailable" : "图文优化不可用")
                : (AppState.en
                    ? "Image+Text · " + AppState.style-analysis-credit-cost + " cr"
                    : "图文优化 · " + AppState.style-analysis-credit-cost + " 积分");
            disabled: !AppState.style-analysis-available || AppState.optimizing-prompt || AppState.references.length == 0;
            clicked => { AppState.visual-optimize-current-prompt(); }
        }
        PromptOptimizationAction {
            x: 212px;
            y: 14px;
            width: AppState.deep-optimization-active ? 104px : 72px;
            height: 24px;
            text: AppState.deep-optimization-active
                ? (AppState.en ? "View Deep Optimize" : "查看深度优化")
                : (AppState.en ? "Deep Optimize" : "深度优化");
            active: AppState.deep-optimization-active;
            disabled: AppState.optimizing-prompt || AppState.translating-prompt;
            clicked => { AppState.open-deep-optimization(); }
        }
        PromptOptimizationAction {
            x: parent.width - 76px;
            y: 14px;
            width: 52px;
            height: 24px;
            text: AppState.en ? "Clear" : "清空";
            disabled: AppState.prompt == "" && AppState.selected-custom-prompt-items.length == 0;
            clicked => { root.clear-current-prompt(); }
        }
        if AppState.optimizing-prompt: LoadingDots {
            x: AppState.deep-optimization-active ? 322px : 290px;
            y: 7px;
            width: 30px;
            height: 30px;
        }
        Text {
            visible: AppState.optimizing-prompt || AppState.translating-prompt;
            x: root.action-status-wraps() ? 24px : (AppState.deep-optimization-active ? 358px : 326px);
            y: root.action-status-wraps() ? 48px : 20px;
            width: root.action-status-wraps() ? parent.width - 48px : parent.width - self.x - 88px;
            height: 18px;
            text: AppState.optimizing-prompt ? (AppState.en ? "Optimizing prompt..." : "正在优化提示词...")
                : (AppState.en ? "Translating prompt..." : "正在翻译提示词...");
            color: AppTheme.text;
            font-size: 13px;
            font-weight: 400;
            overflow: elide;
        }
        prompt-entry-area := Rectangle {
            x: 24px;
            y: root.prompt-input-y();
            width: parent.width - 48px;
            height: root.prompt-input-height();

            prompt-cursor-area := TouchArea {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: root.prompt-input-height();
                mouse-cursor: text;
                prompt-scroll := ScrollView {
                    y: 0px;
                    width: parent.width;
                    height: parent.height - 36px;
                    viewport-width: self.visible-width;
                    viewport-height: max(self.visible-height, prompt-input.preferred-height);
                    prompt-input := TextInput {
                    text <=> root.prompt-editor-text;
                    single-line: false;
                    color: AppTheme.text;
                    font-size: root.prompt-editor-font-size;
                    font-weight: 400;
                    wrap: word-wrap;
                    page-height: prompt-scroll.visible-height;
                    cursor-position-changed(position) => {
                        if position.y + prompt-scroll.viewport-y < 8px {
                            prompt-scroll.viewport-y = min(0px, max(prompt-scroll.visible-height - self.height, -position.y + 8px));
                        } else if position.y + prompt-scroll.viewport-y > prompt-scroll.visible-height - 28px {
                            prompt-scroll.viewport-y = min(0px, max(prompt-scroll.visible-height - self.height, prompt-scroll.visible-height - position.y - 28px));
                        }
                    }
                    edited => {
                        let normalized = AppState.normalize-prompt-editor-text(
                            self.text,
                            "",
                        );
                        if normalized != self.text {
                            root.prompt-editor-text = normalized;
                            self.set-selection-offsets(2147483647, 2147483647);
                        }
                        if AppState.deep-optimization-applied-chinese != ""
                            && AppState.prompt != AppState.deep-optimization-applied-chinese {
                            AppState.deep-optimization-applied-chinese = "";
                            AppState.deep-optimization-applied-english = "";
                            AppState.invalidate-deep-prompt-binding();
                        }
                        if AppState.prompt-history-open && AppState.prompt != "/" {
                            AppState.prompt-history-open = false;
                            root.close-history-preview();
                            history-popup.close();
                        }
                        if AppState.custom-prompt-open && AppState.prompt != "//" {
                            AppState.custom-prompt-open = false;
                            custom-prompt-popup.close();
                        }
                    }
                    key-pressed(event) => {
                    if event.text == "/" {
                        let trigger-edit = AppState.prepare-custom-prompt-insertion(
                            root.prompt-editor-text,
                            prompt-input.cursor-position-byte-offset,
                        );
                        if trigger-edit.cursor-offset >= 0 {
                            root.prompt-editor-text = trigger-edit.text;
                            root.custom-prompt-insert-offset = trigger-edit.cursor-offset;
                            prompt-input.set-selection-offsets(
                                trigger-edit.cursor-offset,
                                trigger-edit.cursor-offset,
                            );
                            AppState.prompt-history-open = false;
                            root.close-history-preview();
                            history-popup.close();
                            root.custom-prompt-selected-index = -1;
                            root.custom-prompt-scroll-x = 0px;
                            AppState.custom-prompt-open = true;
                            custom-prompt-popup.show();
                            prompt-input.focus();
                            return accept;
                        }
                    }
                    if AppState.prompt-history-open && AppState.prompt-history.length > 0 {
                        if event.text == Key.DownArrow {
                            root.prompt-history-selected-index = min(
                                AppState.prompt-history.length - 1,
                                root.prompt-history-selected-index + 1,
                            );
                            root.scroll-prompt-history-selection-into-view();
                            return accept;
                        }
                        if event.text == Key.UpArrow {
                            root.prompt-history-selected-index = max(0, root.prompt-history-selected-index - 1);
                            root.scroll-prompt-history-selection-into-view();
                            return accept;
                        }
                        if event.text == Key.Return && !event.modifiers.alt {
                            root.apply-selected-prompt(
                                AppState.prompt-history[root.prompt-history-selected-index],
                            );
                            return accept;
                        }
                        if event.text == Key.Escape {
                            AppState.prompt-history-open = false;
                            root.close-history-preview();
                            history-popup.close();
                            return accept;
                        }
                    }
                    if AppState.custom-prompt-open && AppState.custom-prompt-items.length > 0 {
                        if event.text == Key.DownArrow {
                            root.custom-prompt-selected-index = root.custom-prompt-selected-index < 0
                                ? 0
                                : min(
                                    AppState.custom-prompt-items.length - 1,
                                    root.custom-prompt-selected-index + 1,
                                );
                            root.scroll-custom-prompt-selection-into-view();
                            return accept;
                        }
                        if event.text == Key.UpArrow {
                            root.custom-prompt-selected-index = root.custom-prompt-selected-index < 0
                                ? AppState.custom-prompt-items.length - 1
                                : max(0, root.custom-prompt-selected-index - 1);
                            root.scroll-custom-prompt-selection-into-view();
                            return accept;
                        }
                        if event.text == Key.Return
                            && !event.modifiers.alt
                            && root.custom-prompt-selected-index >= 0 {
                            root.queue-custom-prompt-selection(
                                AppState.custom-prompt-items[root.custom-prompt-selected-index].content,
                            );
                            return accept;
                        }
                        if event.text == Key.Escape {
                            AppState.custom-prompt-open = false;
                            custom-prompt-popup.close();
                            return accept;
                        }
                    }
                    if event.text == Key.Return {
                        if event.modifiers.alt {
                            return reject;
                        }
                        if root.show-generate-button && !AppState.generating && AppState.reasoning-model != "" {
                            AppState.generate();
                        }
                        return accept;
                    }
                    if event.text == "/" && AppState.prompt == "" && AppState.prompt-history.length > 0 {
                        root.prompt-history-selected-index = 0;
                        root.prompt-history-hovered-index = -1;
                        root.prompt-history-scroll-y = 0px;
                        AppState.prompt-history-open = true;
                        history-popup.show();
                        prompt-input.focus();
                    }
                    if event.modifiers.control && (event.text == "v" || event.text == "V") {
                        if AppState.paste-reference() {
                            return accept;
                        }
                    }
                    return reject;
                    }
                }
            }

            for item[index] in AppState.selected-custom-prompt-items: InlineCustomPromptOverlay {
                x: 0px;
                y: 0px;
                prefix: item.prefix;
                name: item.name;
                editor-width: prompt-input.width;
                editor-visible-height: prompt-scroll.visible-height;
                viewport-y: prompt-scroll.viewport-y;
                editor-font-size: root.prompt-editor-font-size;
                editor-background: AppTheme.panel-soft;
                color-index: index;
            }

            prompt-expand-button := Rectangle {
                x: parent.width - 30px;
                y: parent.height - 30px;
                width: 28px;
                height: 28px;
                background: prompt-expand-touch.has-hover ? AppTheme.panel : transparent;
                border-radius: 7px;
                border-width: 1px;
                border-color: prompt-expand-touch.has-hover ? AppTheme.accent : AppTheme.border;

                Image {
                    x: 6px;
                    y: 6px;
                    width: 16px;
                    height: 16px;
                    source: @image-url("../../assets/icons/fit.svg");
                    colorize: prompt-expand-touch.has-hover ? AppTheme.accent : AppTheme.muted;
                    image-fit: contain;
                }

                prompt-expand-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => {
                        AppState.prompt-history-open = false;
                        AppState.custom-prompt-open = false;
                        root.close-history-preview();
                        history-popup.close();
                        custom-prompt-popup.close();
                        AppState.prompt-expanded-open = true;
                    }
                }
            }
        }
        }
        Text {
            visible: root.prompt-editor-text == ""
                && AppState.selected-custom-prompt-items.length == 0
                && !prompt-input.has-focus;
            x: 24px;
            y: root.prompt-input-y();
            width: parent.width - 48px;
            height: root.prompt-input-height();
            text: root.prompt-placeholder();
            color: AppTheme.weak;
            font-size: root.prompt-editor-font-size;
            font-weight: 400;
            wrap: word-wrap;
        }
        GenerateActionButton {
            x: root.width < 560px ? parent.width - 190px : parent.width - 178px;
            y: parent.height - 78px;
            width: root.width < 560px ? 166px : 154px;
            height: 54px;
            visible: root.show-generate-button;
            disabled: !AppState.generating && AppState.reasoning-model == "";
            clicked => {
                if AppState.generating {
                    AppState.stop-generation();
                } else {
                    AppState.generate();
                }
            }
        }
        Text {
            visible: root.show-generate-button && (AppState.optimizing-prompt || AppState.translating-prompt || AppState.generating || AppState.generation-status != "");
            x: 24px;
            y: parent.height - 24px;
            width: parent.width - 48px;
            height: 16px;
            text: AppState.optimizing-prompt ? (AppState.en ? "Optimizing prompt..." : "正在优化提示词...")
                : (AppState.translating-prompt ? (AppState.en ? "Translating prompt..." : "正在翻译提示词...")
                : (AppState.generating ? (AppState.en ? "Generating..." : "正在生成中...")
                : AppState.generation-status));
            color: AppTheme.text;
            font-size: 13px;
            font-weight: 400;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        if reference-drop.has-drag: Rectangle {
            x: reference-drop.x;
            y: reference-drop.y;
            width: reference-drop.width;
            height: reference-drop.height;
            background: #00d98218;
            border-radius: 14px;
            border-width: 2px;
            border-color: AppTheme.accent;
            Text {
                width: parent.width;
                height: parent.height;
                text: AppState.en ? "Drop to add reference" : "松开添加为参考图";
                color: AppTheme.accent;
                font-size: 16px;
                font-weight: 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    history-popup := PopupWindow {
        x: 24px;
        y: root.prompt-input-y() + 32px;
        width: root.history-list-width();
        height: root.history-list-height();
        close-policy: close-on-click-outside;
        history-list := Rectangle {
            width: root.history-list-width();
            height: root.history-list-height();
            visible: AppState.prompt-history-open && AppState.prompt-history.length > 0;
            background: AppTheme.panel;
            border-radius: 8px;
            border-width: 1px;
            border-color: AppTheme.border;
            history-scroll := ScrollView {
                viewport-y <=> root.prompt-history-scroll-y;
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: parent.height - 52px;
                viewport-width: self.width;
                viewport-height: AppState.prompt-history.length * 32px;
                VerticalLayout {
                    width: parent.width;
                    height: AppState.prompt-history.length * 32px;
                    for preview[index] in AppState.prompt-history-previews: Rectangle {
                        height: 32px;
                        background: root.prompt-history-hovered-index >= 0
                            ? (index == root.prompt-history-hovered-index ? AppTheme.panel-soft : transparent)
                            : (index == root.prompt-history-selected-index ? AppTheme.panel-soft : transparent);
                        border-radius: 6px;
                        Text {
                            x: 10px;
                            width: parent.width - 48px;
                            height: parent.height;
                            text: preview;
                            color: index == root.prompt-history-selected-index ? AppTheme.accent : AppTheme.text;
                            font-size: AppState.settings-font-size * 1px;
                            font-weight: 400;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                            wrap: no-wrap;
                            overflow: elide;
                        }
                        history-row := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: pointer;
                            changed has-hover => {
                                if self.has-hover {
                                    root.prompt-history-selected-index = index;
                                }
                                root.sync-history-preview(index, self.has-hover);
                                if self.has-hover {
                                    history-preview-popup.show();
                                }
                            }
                            clicked => {
                                root.apply-selected-prompt(AppState.prompt-history[index]);
                            }
                        }
                        Rectangle {
                            x: parent.width - 30px;
                            y: 4px;
                            width: 24px;
                            height: 24px;
                            background: history-delete.has-hover ? AppTheme.panel : transparent;
                            border-radius: 6px;
                            Image {
                                x: 5px;
                                y: 5px;
                                width: 14px;
                                height: 14px;
                                source: @image-url("../../assets/icons/trash.svg");
                                colorize: AppTheme.danger;
                            }
                            history-delete := TouchArea {
                                width: parent.width;
                                height: parent.height;
                                mouse-cursor: pointer;
                                changed has-hover => {
                                    if self.has-hover {
                                        root.prompt-history-selected-index = index;
                                    }
                                    root.sync-history-preview(index, self.has-hover);
                                    if self.has-hover {
                                        history-preview-popup.show();
                                    }
                                }
                                clicked => {
                                    AppState.remove-prompt-history(AppState.prompt-history[index]);
                                    if AppState.prompt-history.length == 0 {
                                        AppState.prompt-history-open = false;
                                        root.close-history-preview();
                                        history-popup.close();
                                    } else {
                                        root.prompt-history-selected-index = min(
                                            root.prompt-history-selected-index,
                                            AppState.prompt-history.length - 1,
                                        );
                                    }
                                }
                            }
                        }
                    }
                }
            }
            PillButton {
                x: parent.width - 96px;
                y: parent.height - 32px;
                width: 88px;
                height: 24px;
                text: AppState.en ? "Clear all" : "全部清空";
                primary: false;
                danger: true;
                label-font-size: AppState.settings-font-size * 1px - 2px;
                visual-opacity: 0.62;
                clicked => {
                    AppState.clear-prompt-history();
                    AppState.prompt-history-open = false;
                    root.close-history-preview();
                    history-popup.close();
                }
            }
        }

        history-preview-popup := PopupWindow {
            x: root.history-list-width() + 12px;
            y: 0px;
            width: 420px;
            height: 300px;
            close-policy: close-on-click-outside;

            history-preview := Rectangle {
                background: AppTheme.panel;
                border-radius: 10px;
                border-width: 1px;
                border-color: AppTheme.border;

                Text {
                    x: 16px;
                    y: 14px;
                    width: parent.width - 32px;
                    height: 22px;
                    text: AppState.en ? "Full prompt" : "完整提示词";
                    color: AppTheme.text;
                    font-size: AppState.settings-font-size * 1px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                history-preview-scroll := ScrollView {
                    x: 16px;
                    y: 46px;
                    width: parent.width - 32px;
                    height: parent.height - 62px;
                    viewport-width: self.visible-width;
                    viewport-height: max(self.visible-height, history-preview-text.preferred-height);
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    mouse-drag-pan-enabled: true;

                    history-preview-text := Text {
                        width: history-preview-scroll.visible-width - 10px;
                        height: max(history-preview-scroll.visible-height, self.preferred-height);
                        text: root.prompt-history-hovered-index >= 0
                            && root.prompt-history-hovered-index < AppState.prompt-history.length
                            ? AppState.prompt-history[root.prompt-history-hovered-index]
                            : "";
                        color: AppTheme.text;
                        font-size: AppState.settings-font-size * 1px;
                        font-weight: 400;
                        vertical-alignment: top;
                        wrap: word-wrap;
                    }
                }

                preview-hover := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    changed has-hover => {
                        root.history-preview-close-pending = !self.has-hover;
                    }
                    scroll-event(event) => { return reject; }
                }
            }

            Timer {
                interval: 160ms;
                running: root.history-preview-close-pending;
                triggered => {
                    if root.history-preview-close-pending {
                        root.close-history-preview();
                        history-preview-popup.close();
                    }
                }
            }
        }
    }

    Timer {
        interval: 1ms;
        running: root.prompt-editor-focus-pending;
        triggered => {
            root.prompt-editor-focus-pending = false;
            prompt-input.focus();
            prompt-input.set-selection-offsets(2147483647, 2147483647);
        }
    }

    custom-prompt-popup := PopupWindow {
        x: 24px;
        y: root.prompt-input-y() + 32px;
        width: root.width - 48px;
        height: AppState.custom-prompt-items.length > 0
            ? 88px
            : 54px;
        close-policy: close-on-click-outside;
        Rectangle {
            visible: AppState.custom-prompt-open;
            background: AppTheme.panel;
            border-radius: 8px;
            border-width: 1px;
            border-color: AppTheme.border;
            if AppState.custom-prompt-items.length == 0: Rectangle {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: parent.height - 16px;
                background: create-prompt-touch.has-hover ? AppTheme.panel-soft : transparent;
                border-radius: 6px;
                Text {
                    x: 10px;
                    width: parent.width - 20px;
                    height: parent.height;
                    text: AppState.en ? "No custom prompts. Click to create one" : "暂无自定义提示词，点击创建";
                    color: AppTheme.accent;
                    font-size: AppState.settings-font-size * 1px;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                }
                create-prompt-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => {
                        AppState.custom-prompt-open = false;
                        custom-prompt-popup.close();
                        AppState.settings-section = "prompts";
                        AppState.navigate("settings");
                    }
                }
            }
            custom-prompt-scroll := ScrollView {
                visible: AppState.custom-prompt-items.length > 0;
                viewport-x <=> root.custom-prompt-scroll-x;
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: 36px;
                viewport-width: max(self.width, custom-prompt-row.preferred-width);
                viewport-height: 36px;
                custom-prompt-row := HorizontalLayout {
                    width: max(parent.viewport-width, self.preferred-width);
                    height: 36px;
                    spacing: 8px;
                    alignment: start;
                    for item[index] in AppState.custom-prompt-items: Rectangle {
                        width: min(max(72px, tag-title.preferred-width + 28px), root.width - 64px);
                        height: 36px;
                        background: transparent;
                        Rectangle {
                            x: 0px;
                            y: 4px;
                            width: parent.width;
                            height: 28px;
                            background: item.selected || custom-row.has-hover || index == root.custom-prompt-selected-index
                                ? AppTheme.panel-soft
                                : transparent;
                            border-radius: 14px;
                            border-width: 1px;
                            border-color: item.selected
                                ? AppTheme.accent
                                : (index == root.custom-prompt-selected-index ? AppTheme.muted : AppTheme.border);
                            tag-title := Text {
                                x: 12px;
                                width: parent.width - 24px;
                                height: parent.height;
                                text: item.name;
                                color: item.selected ? AppTheme.accent-dark : AppTheme.text;
                                font-size: AppState.settings-font-size * 1px - 1px;
                                font-weight: 400;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                wrap: no-wrap;
                                overflow: clip;
                            }
                            custom-row := TouchArea {
                                width: parent.width;
                                height: parent.height;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.custom-prompt-selected-index = index;
                                    root.queue-custom-prompt-selection(item.content);
                                }
                            }
                        }
                    }
                }
            }
            if AppState.custom-prompt-items.length > 0: PillButton {
                x: parent.width - 160px;
                y: parent.height - 36px;
                width: 72px;
                height: 28px;
                text: AppState.en ? "Manage" : "管理";
                primary: false;
                clicked => {
                    AppState.custom-prompt-open = false;
                    custom-prompt-popup.close();
                    AppState.settings-section = "prompts";
                    AppState.navigate("settings");
                }
            }
            if AppState.custom-prompt-items.length > 0: PillButton {
                x: parent.width - 80px;
                y: parent.height - 36px;
                width: 72px;
                height: 28px;
                text: AppState.en ? "Create" : "创建";
                primary: false;
                clicked => {
                    AppState.custom-prompt-open = false;
                    custom-prompt-popup.close();
                    AppState.begin-new-custom-prompt();
                }
            }
        }
    }

    function scroll-prompt-history-selection-into-view() {
        let selected-top = root.prompt-history-selected-index * 32px;
        let selected-bottom = selected-top + 32px;
        let visible-height = min(10, AppState.prompt-history.length) * 32px;
        if selected-top + root.prompt-history-scroll-y < 0px {
            root.prompt-history-scroll-y = -selected-top;
        } else if selected-bottom + root.prompt-history-scroll-y > visible-height {
            root.prompt-history-scroll-y = visible-height - selected-bottom;
        }
    }

    function scroll-custom-prompt-selection-into-view() {
        if root.custom-prompt-selected-index < 0 {
            return;
        }
        let selected-left = root.custom-prompt-selected-index * 120px;
        let selected-right = selected-left + 120px;
        let visible-width = max(120px, root.width - 64px);
        if selected-left + root.custom-prompt-scroll-x < 0px {
            root.custom-prompt-scroll-x = -selected-left;
        } else if selected-right + root.custom-prompt-scroll-x > visible-width {
            root.custom-prompt-scroll-x = visible-width - selected-right;
        }
    }

    function reference-visible-count() -> int {
        return AppState.references.length + (AppState.references.length < root.max-reference-count() ? 1 : 0);
    }

    function max-reference-count() -> int {
        return 8;
    }

    function reference-columns() -> int {
        return 4;
    }

    function reference-card-size() -> length {
        return min(88px, max(56px, (root.width - 48px - 30px) / 4));
    }

    function reference-grid-width() -> length {
        return root.reference-columns() * root.reference-card-size()
            + (root.reference-columns() - 1) * 10px;
    }

    function reference-grid-x() -> length {
        return 24px;
    }

    function reference-row-height() -> length {
        return root.reference-card-size() + 10px;
    }

    function reference-row-count() -> int {
        return max(1, (root.reference-visible-count() + root.reference-columns() - 1) / root.reference-columns());
    }

    function reference-tray-y() -> length {
        return root.height
            - 24px
            - root.reference-card-size()
            - (root.reference-row-count() - 1) * root.reference-row-height();
    }

    function reference-x(index: int) -> length {
        return root.reference-grid-x()
            + Math.mod(index, root.reference-columns()) * root.reference-row-height();
    }

    function reference-y(index: int) -> length {
        return root.reference-tray-y()
            + floor(index / root.reference-columns()) * root.reference-row-height();
    }

    function prompt-input-y() -> length {
        if AppState.quote-title != "" {
            return root.action-status-wraps() ? 118px : 92px;
        }
        return root.action-status-wraps() ? 84px : 58px;
    }

    function action-status-wraps() -> bool {
        return (AppState.optimizing-prompt || AppState.translating-prompt)
            && (root.width < 680px || AppState.settings-font-size > 16);
    }

    function prompt-input-height() -> length {
        return max(96px, root.reference-tray-y() - root.prompt-input-y() - 12px);
    }

    function prompt-placeholder() -> string {
        if AppState.mode == "film" { return AppState.en ? "Describe the script, characters, scenes, storyboard, or video" : "描述你想创作的剧本、角色、场景、分镜或视频"; }
        if AppState.en {
            if AppState.asset-type == "scene" { return "Describe the scene you want to create...\nExample: a wasteland market at dusk, steam-powered mechanical stalls, cinematic lighting, game concept art style"; }
            if AppState.asset-type == "character" { return "Describe the character you want to create...\nExample: a female knight holding a flaming longsword, full armor, dark fantasy style, complete full-body illustration design"; }
            if AppState.asset-type == "ui" { return "Describe the UI screen you want to create...\nExample: dark control-console home page, modular card layout, cyan-blue highlights, hybrid game HUD and data dashboard style"; }
            if AppState.asset-type == "effect" { return "Describe the VFX, enchantment, skill release, or sprite-sheet animation effect you want...\nExample: blue-white lightning enchantment around a sword, 8-direction continuous flicker, suitable for pixel-style RPG battle skill VFX sprite sheet"; }
            return "Describe the character, scene, UI, or effect you want";
        }
        if AppState.asset-type == "scene" { return "描述你想要创作的场景...\n例如：黄昏中的废土集市，蒸汽机械摊位，电影感光影，游戏概念图风格"; }
        if AppState.asset-type == "character" { return "描述你想要创建的角色...\n例如：一位手持火焰长剑的女骑士，全身铠甲，暗黑奇幻风格，完整立绘设计"; }
        if AppState.asset-type == "ui" { return "描述你想要创建的 UI 界面...\n例如：暗黑风控制台首页，模块化卡片布局，蓝青色高亮，游戏 HUD + 数据看板混合风格"; }
        if AppState.asset-type == "effect" { return "描述你想生成的特效、附魔、技能释放或精灵图集动态效果...\n例如：蓝白雷电附魔环绕剑身，8方向连续闪烁，适合像素风 RPG 战斗技能特效精灵图集"; }
        return "描述你想生成的角色、场景、UI 或特效";
    }
}
