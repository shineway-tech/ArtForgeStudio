import { ScrollView } from "std-widgets.slint";
import { AppState } from "../app-state.slint";
import { AppTheme } from "../theme.slint";
import { PillButton } from "pill-button.slint";

export component PromptExpandedEditor {
    visible: AppState.prompt-expanded-open;
    property <bool> editor-focus-pending: false;

    changed visible => {
        if self.visible {
            root.editor-focus-pending = true;
        }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000070;

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { AppState.prompt-expanded-open = false; }
        }
    }

    editor-card := Rectangle {
        width: min(980px, parent.width - 80px);
        height: min(720px, parent.height - 80px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: AppTheme.panel;
        border-radius: 16px;
        border-width: 1px;
        border-color: AppTheme.border;
        drop-shadow-blur: 28px;
        drop-shadow-color: #00000048;
        drop-shadow-offset-y: 10px;

        TouchArea {
            width: parent.width;
            height: parent.height;
        }

        Text {
            x: 24px;
            y: 18px;
            width: parent.width - 96px;
            height: 32px;
            text: AppState.en ? "Edit prompt" : "编辑提示词";
            color: AppTheme.text;
            font-size: AppState.settings-font-size * 1px + 2px;
            font-weight: 600;
            vertical-alignment: center;
        }

        close-button := Rectangle {
            x: parent.width - 54px;
            y: 16px;
            width: 32px;
            height: 32px;
            background: close-touch.has-hover ? AppTheme.panel-soft : transparent;
            border-radius: 8px;

            Text {
                width: parent.width;
                height: parent.height;
                text: "×";
                color: AppTheme.muted;
                font-size: 22px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            close-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: pointer;
                clicked => { AppState.prompt-expanded-open = false; }
            }
        }

        if AppState.selected-custom-prompt-items.length > 0: Rectangle {
            x: 24px;
            y: 62px;
            width: parent.width - 48px;
            height: 38px;
            background: AppTheme.panel-soft;
            border-radius: 9px;

            Image {
                x: 12px;
                y: 11px;
                width: 16px;
                height: 16px;
                source: @image-url("../../assets/icons/custom-prompt-text.svg");
                colorize: AppTheme.custom-prompt-name;
                image-fit: contain;
            }

            for item in AppState.selected-custom-prompt-items: Text {
                x: 34px;
                width: parent.width - 46px;
                height: parent.height;
                text: item.name;
                color: AppTheme.custom-prompt-name;
                font-size: AppState.settings-font-size * 1px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        editor-frame := Rectangle {
            x: 24px;
            y: AppState.selected-custom-prompt-items.length > 0 ? 112px : 62px;
            width: parent.width - 48px;
            height: parent.height - self.y - 82px;
            background: AppTheme.panel-soft;
            border-radius: 10px;
            border-width: 1px;
            border-color: expanded-input.has-focus ? AppTheme.accent : AppTheme.border;

            expanded-scroll := ScrollView {
                x: 14px;
                y: 14px;
                width: parent.width - 28px;
                height: parent.height - 28px;
                viewport-width: self.visible-width;
                viewport-height: max(self.visible-height, expanded-input.preferred-height);
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                expanded-input := TextInput {
                    width: expanded-scroll.visible-width - 10px;
                    text <=> AppState.prompt;
                    single-line: false;
                    color: AppTheme.text;
                    font-size: AppState.settings-font-size * 1px + 1px;
                    font-weight: 400;
                    wrap: word-wrap;
                    page-height: expanded-scroll.visible-height;
                    edited => {
                        AppState.deep-optimization-applied-chinese = "";
                        AppState.deep-optimization-applied-english = "";
                        AppState.invalidate-deep-prompt-binding();
                    }
                    key-pressed(event) => {
                        if event.text == Key.Escape {
                            AppState.prompt-expanded-open = false;
                            return accept;
                        }
                        return reject;
                    }
                }
            }
        }

        PillButton {
            x: parent.width - 116px;
            y: parent.height - 58px;
            width: 92px;
            height: 36px;
            text: AppState.en ? "Done" : "完成";
            primary: true;
            clicked => { AppState.prompt-expanded-open = false; }
        }
    }

    Timer {
        interval: 1ms;
        running: root.editor-focus-pending;
        triggered => {
            root.editor-focus-pending = false;
            expanded-input.focus();
            expanded-input.set-selection-offsets(2147483647, 2147483647);
        }
    }
}
