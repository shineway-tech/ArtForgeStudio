import { AppState } from "../app-state.slint";
import { EmptyState } from "empty-state.slint";
import { GalleryLayoutToggle } from "gallery-layout-toggle.slint";
import { VirtualizedGallery } from "virtualized-gallery.slint";
import { AppTheme } from "../theme.slint";

export component GenerationResultPanel {
    property <string> pagination-key: AppState.asset-type;
    property <bool> load-more-armed: true;
    property <length> last-load-bottom: -10000px;
    property <string> viewport-key: root.pagination-key + ":" + AppState.generation-gallery-layout + ":" + AppState.language + ":" + root.loading-count();
    changed pagination-key => { root.reset-pagination-latch(); }
    init => { root.update-viewport(); }
    changed viewport-key => { root.update-viewport(); }
    changed width => { root.update-viewport(); }
    changed height => { root.update-viewport(); }
    Rectangle {
        background: AppTheme.panel;
        border-width: 1px;
        border-color: AppTheme.border;
        Text {
            x: 20px;
            y: 18px;
            width: parent.width - 164px;
            text: AppState.en ? "Generated Images" : "生成结果";
            color: AppTheme.text;
            font-size: 16px;
            font-weight: 500;
        }
        GalleryLayoutToggle {
            x: parent.width - 132px;
            y: 14px;
            mode <=> AppState.generation-gallery-layout;
            preference-key: "generation";
        }
        Rectangle { x: 20px; y: 52px; width: parent.width - 40px; height: 1px; background: AppTheme.border; }
        Rectangle {
            x: 20px;
            y: 70px;
            width: parent.width - 40px;
            height: parent.height - 90px;
            clip: true;
            background: transparent;
            result-scroll := Flickable {
                width: parent.width;
                height: parent.height;
                viewport-width: parent.width;
                viewport-height: max(self.height, result-gallery.height);
                interactive: true;
                changed viewport-y => { root.maybe-load-more(); root.update-viewport(); }
                changed viewport-height => { root.maybe-load-more(); root.update-viewport(); }
                Rectangle {
                    width: parent.viewport-width;
                    height: parent.viewport-height;
                    background: transparent;
                    if AppState.generations.length == 0 && !root.active-generating(): EmptyState {
                        width: parent.width;
                        height: max(360px, parent.height);
                    }
                    result-gallery := VirtualizedGallery {
                        visible: AppState.generations.length > 0 || root.active-generating();
                        y: 0px;
                        width: parent.width;
                        items: AppState.generations;
                        placements: AppState.generation-layout-items;
                        headers: AppState.generation-layout-headers;
                        loaders: AppState.generation-layout-loaders;
                        content-height: AppState.generation-layout-height;
                        source: "generation";
                    }
                }
            }
        }
    }
    function column-count() -> int {
        return max(1, min(root.visible-count(), min(8, floor((root.grid-width() + root.grid-gap()) / root.item-slot-width()))));
    }
    function grid-width() -> length {
        return max(1px, root.width - 40px);
    }
    function grid-gap() -> length {
        return 10px;
    }
    function base-thumb-width() -> length {
        return 160px;
    }
    function item-slot-width() -> length {
        return root.base-thumb-width() + root.grid-gap();
    }
    function item-width() -> length {
        return min(root.base-thumb-width(), max(91px, (root.grid-width() - (root.column-count() - 1) * root.grid-gap()) / root.column-count()));
    }
    function loading-count() -> int {
        return root.active-generating() ? AppState.generation-loading-count : 0;
    }
    function visible-count() -> int {
        return AppState.generations.length + root.loading-count();
    }
    function active-generating() -> bool {
        return AppState.generating && AppState.generation-active-category == AppState.asset-type;
    }
    function maybe-load-more() {
        let visible-bottom = -result-scroll.viewport-y + result-scroll.height;
        let near-end = visible-bottom + 640px >= result-scroll.viewport-height;
        if !AppState.generation-has-more || !near-end {
            root.load-more-armed = true;
            return;
        }
        if !root.load-more-armed && visible-bottom >= root.last-load-bottom + 240px {
            root.load-more-armed = true;
        }
        if root.load-more-armed {
            root.load-more-armed = false;
            root.last-load-bottom = visible-bottom;
            AppState.load-more-generations();
        }
    }
    function reset-pagination-latch() {
        root.load-more-armed = true;
        root.last-load-bottom = -10000px;
    }
    function update-viewport() {
        AppState.update-gallery-viewport(
            "generation",
            max(0, -result-scroll.viewport-y / 1px),
            max(1, result-scroll.height / 1px),
            max(1, result-scroll.width / 1px),
            AppState.generation-gallery-layout,
            max(1, (AppState.generation-gallery-layout == "waterfall" ? root.base-thumb-width() : root.item-width()) / 1px),
            root.loading-count()
        );
    }
}
