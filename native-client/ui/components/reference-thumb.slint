import { AppState } from "../app-state.slint";
import { AppTheme } from "../theme.slint";
import { ReferenceItem } from "../types.slint";

export component ReferenceThumb {
    in property <ReferenceItem> item;
    width: 88px;
    height: 88px;

    thumb-card := Rectangle {
        background: AppTheme.panel-soft;
        border-radius: 10px;
        border-width: 1px;
        border-color: AppTheme.border;
        clip: true;

        Image {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            source: root.item.image;
            image-fit: contain;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: pointer;
            clicked => { AppState.open-reference(root.item.id); }
        }
    }

    Rectangle {
        x: parent.width - 18px;
        y: -6px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: AppTheme.danger;
        clip: false;

        Text {
            width: parent.width;
            height: parent.height;
            text: "×";
            color: #ffffff;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: 13px;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: pointer;
            clicked => { AppState.remove-reference(root.item.id); }
        }
    }
}
