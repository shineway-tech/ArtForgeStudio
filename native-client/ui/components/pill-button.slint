import { AppState } from "../app-state.slint";
import { AppTheme } from "../theme.slint";
import { GenerateGlowBorder } from "generate-glow-border.slint";

export component PillButton {
    in property <string> text;
    in property <string> secondary-text;
    in property <string> credit-cost;
    in property <bool> active: false;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> disabled: false;
    in property <bool> generate-effect: false;
    in property <length> label-font-size: AppState.settings-font-size * 1px;
    in property <float> visual-opacity: 1.0;
    callback clicked();
    min-width: 72px;
    height: 36px;
    Rectangle {
        width: root.width;
        height: root.height;
        clip: true;
        opacity: root.disabled ? 0.45 : root.visual-opacity;
        background: root.primary || root.active ? AppTheme.accent : (touch.has-hover && !root.disabled ? AppTheme.panel-soft : AppTheme.panel);
        border-radius: 18px;
        border-width: root.primary || root.active ? 0px : 1px;
        border-color: root.danger ? AppTheme.danger : (touch.has-hover && !root.disabled ? AppTheme.accent : AppTheme.border);
        Text {
            visible: root.credit-cost == "";
            x: 0px;
            width: parent.width;
            height: parent.height;
            text: root.secondary-text == "" ? root.text : root.text + "  ·  " + root.secondary-text;
            color: root.primary || root.active ? #ffffff : (root.danger ? AppTheme.danger : AppTheme.text);
            font-size: root.label-font-size;
            font-weight: root.primary ? 500 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
        }
        credit-icon := Image {
            visible: root.credit-cost != "";
            x: (parent.width - (16px + 5px + credit-value.preferred-width + 12px + credit-action.preferred-width)) / 2;
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            source: @image-url("../../assets/icons/credits.svg");
            colorize: root.primary || root.active ? #ffffff : AppTheme.text;
            image-fit: contain;
        }
        credit-value := Text {
            visible: root.credit-cost != "";
            x: credit-icon.x + credit-icon.width + 5px;
            width: self.preferred-width;
            height: parent.height;
            text: root.credit-cost;
            color: root.primary || root.active ? #ffffff : AppTheme.text;
            font-size: root.label-font-size;
            font-weight: root.primary ? 500 : 400;
            vertical-alignment: center;
        }
        credit-action := Text {
            visible: root.credit-cost != "";
            x: credit-value.x + credit-value.width + 12px;
            width: self.preferred-width;
            height: parent.height;
            text: root.text;
            color: root.primary || root.active ? #ffffff : (root.danger ? AppTheme.danger : AppTheme.text);
            font-size: root.label-font-size;
            font-weight: root.primary ? 500 : 400;
            vertical-alignment: center;
        }
        if root.generate-effect: GenerateGlowBorder {
            width: parent.width;
            height: parent.height;
            radius: parent.border-radius;
            active: !root.disabled;
        }
        touch := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: root.disabled ? default : pointer;
            clicked => {
                if !root.disabled {
                    root.clicked();
                }
            }
        }
    }
}
