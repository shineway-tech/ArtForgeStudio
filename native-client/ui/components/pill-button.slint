import { AppState } from "../app-state.slint";
import { AppTheme } from "../theme.slint";

export component PillButton {
    in property <string> text;
    in property <string> secondary-text;
    in property <bool> active: false;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> disabled: false;
    in property <length> label-font-size: AppState.settings-font-size * 1px;
    in property <float> visual-opacity: 1.0;
    callback clicked();
    min-width: 72px;
    height: 36px;
    Rectangle {
        width: root.width;
        height: root.height;
        clip: true;
        opacity: root.disabled ? 0.45 : root.visual-opacity;
        background: root.primary || root.active ? AppTheme.accent : (touch.has-hover && !root.disabled ? AppTheme.panel-soft : AppTheme.panel);
        border-radius: 18px;
        border-width: root.primary || root.active ? 0px : 1px;
        border-color: root.danger ? AppTheme.danger : (touch.has-hover && !root.disabled ? AppTheme.accent : AppTheme.border);
        Text {
            x: 0px;
            y: root.secondary-text == "" ? 0px : 8px;
            width: parent.width;
            height: root.secondary-text == "" ? parent.height : 20px;
            text: root.text;
            color: root.primary || root.active ? #ffffff : (root.danger ? AppTheme.danger : AppTheme.text);
            font-size: root.label-font-size;
            font-weight: root.primary ? 500 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
        }
        if root.secondary-text != "": Text {
            x: 14px;
            y: parent.height - 24px;
            width: parent.width - 28px;
            height: 16px;
            text: root.secondary-text;
            color: root.primary || root.active ? #ffffffcc : AppTheme.muted;
            font-size: 11px;
            font-weight: 400;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        touch := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: root.disabled ? default : pointer;
            clicked => {
                if !root.disabled {
                    root.clicked();
                }
            }
        }
    }
}
