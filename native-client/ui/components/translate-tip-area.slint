import { AppTheme } from "../theme.slint";

export component TranslateTipArea {
    in property <string> label;
    in property <string> text;
    property <bool> open: false;
    height: 22px;

    function sync-popup(hovered: bool) {
            if hovered && !root.open {
                root.open = true;
                popup.show();
            }
            if !hovered && root.open {
                root.open = false;
                popup.close();
            }
    }

    Text {
        x: 0px;
        width: root.width - 18px;
        height: root.height;
        text: root.label;
        color: AppTheme.muted;
        font-size: 12px;
        font-weight: 400;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: root.width - 18px;
        width: 18px;
        height: root.height;
        text: "?";
        color: AppTheme.muted;
        font-size: 12px;
        font-weight: 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    hover := TouchArea {
        width: root.width;
        height: root.height;
        mouse-cursor: help;
        changed has-hover => { root.sync-popup(self.has-hover); }
    }

    popup := PopupWindow {
        x: -84px;
        y: 28px;
        width: 260px;
        height: 82px;
        Rectangle {
            visible: root.open;
            background: AppTheme.panel;
            border-radius: 8px;
            border-width: 1px;
            border-color: AppTheme.border;
            Text {
                x: 12px;
                y: 10px;
                width: parent.width - 24px;
                height: parent.height - 20px;
                text: root.text;
                color: AppTheme.text;
                font-size: 12px;
                font-weight: 400;
                wrap: word-wrap;
            }
        }
    }
}
