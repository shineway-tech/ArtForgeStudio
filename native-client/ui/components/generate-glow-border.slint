import { AppState } from "../app-state.slint";
import { AppTheme } from "../theme.slint";

// A quiet, continuously travelling highlight for actions that start AI work.
// Keeping it separate from the button content lets every generation surface
// share the same motion while preserving its existing layout and click target.
export component GenerateGlowBorder {
    in property <bool> active: true;
    in property <length> radius: root.height / 2;
    in-out property <int> step: 0;
    property <angle> rotation-angle: root.step * 3deg;

    Timer {
        interval: 40ms;
        running: root.active && !AppState.reduced-motion;
        triggered => { root.step = Math.mod(root.step + 1, 120); }
    }

    Rectangle {
        width: root.width;
        height: root.height;
        background: transparent;
        border-radius: root.radius;
        border-width: root.active ? 1px : 0px;
        border-color: AppTheme.accent.with-alpha(AppState.reduced-motion ? 0.50 : 0.28);
    }

    moving-highlight := Rectangle {
        width: root.width;
        height: root.height;
        background: transparent;
        border-radius: root.radius;
        border-width: root.active ? 1.5px : 0px;
        border-color: AppState.reduced-motion
            ? AppTheme.accent.with-alpha(0.50)
            : @conic-gradient(
                from root.rotation-angle,
                AppTheme.accent.with-alpha(0.10) 0deg,
                AppTheme.accent.with-alpha(0.10) 205deg,
                #b8edff1f 238deg,
                #c9f2ff3d 265deg,
                #e5fbff70 292deg,
                #ffffff82 306deg,
                #d7f7ff5c 323deg,
                #b8edff2b 342deg,
                AppTheme.accent.with-alpha(0.10) 360deg
            );
    }
}
