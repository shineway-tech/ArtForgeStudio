import { AppState } from "../app-state.slint";
import { ModelPicker } from "model-picker.slint";
import { PillButton } from "pill-button.slint";
import { AppTheme } from "../theme.slint";

component InvitationGiftButton {
    width: AppState.en ? 112px : 98px;
    height: 36px;
    accessible-role: button;
    accessible-label: AppState.en ? "Invite & earn" : "邀请有礼";

    Rectangle {
        width: parent.width;
        y: 2px;
        height: parent.height - 4px;
        background: gift-touch.pressed ? #ffddb5 : (gift-touch.has-hover ? #ffe4c5 : #ffecd5);
        border-radius: 16px;
        gift-image := Image {
            x: 12px;
            y: (parent.height - 16px) / 2;
            width: 16px;
            height: 16px;
            source: @image-url("../../assets/icons/invitation-gift.svg");
            colorize: #ff850b;
            image-fit: contain;
        }
        Text {
            x: 31px;
            width: parent.width - 41px;
            height: parent.height;
            text: AppState.en ? "Invite & earn" : "邀请有礼";
            color: #f78008;
            font-size: 13px;
            font-weight: 400;
            vertical-alignment: center;
        }
        gift-touch := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: pointer;
            clicked => { AppState.navigate("invitation-gift"); }
        }
    }
}

export component TopBar {
    property <length> action-gap: 8px;
    property <length> gift-width: 48px;
    property <length> language-width: 94px;
    property <length> theme-width: 94px;
    property <length> balance-width: 150px;
    property <length> profile-width: 128px;
    property <length> payment-width: 112px;
    property <length> login-width: 112px;
    property <bool> models-on-second-row: AppState.page == "generation"
        && root.width < root.actions-width() + 36px + 3 * 220px + 2 * 18px + 38px;
    height: root.models-on-second-row ? 112px : 58px;
    Rectangle {
        width: root.width;
        height: root.height;
        background: AppTheme.bg;
        border-width: 1px;
        border-color: AppTheme.border;
        Rectangle {
            x: 18px;
            y: 0px;
            width: 94px;
            height: parent.height;
            background: transparent;
            if AppState.page != "welcome" && AppState.page != "generation": PillButton {
                x: 0px;
                y: (parent.height - 36px) / 2;
                width: 88px;
                text: AppState.en ? "← Back" : "← 返回";
                clicked => { AppState.back(); }
            }
        }
        Rectangle {
            x: 18px;
            y: root.models-on-second-row ? 58px : 0px;
            width: root.models-on-second-row ? parent.width - 36px : parent.width - root.actions-width() - 56px;
            height: 54px;
            background: transparent;
            clip: true;
            if AppState.page == "generation": Rectangle {
                width: parent.width;
                height: parent.height;
                background: transparent;
                ModelPicker {
                    x: 0px;
                    y: 6px;
                    kind: "image";
                    label: AppState.en ? "Image" : "生图";
                    picker-width: root.model-picker-width();
                    select-model(model) => { AppState.select-image-model(model); }
                }
                ModelPicker {
                    x: root.model-picker-width() + 18px;
                    y: 6px;
                    kind: "reasoning";
                    label: AppState.en ? "Reasoning" : "推理";
                    picker-width: root.model-picker-width();
                    select-model(model) => { AppState.select-reasoning-model(model); }
                }
                ModelPicker {
                    x: 2 * (root.model-picker-width() + 18px);
                    y: 6px;
                    kind: "video";
                    label: AppState.en ? "Video" : "视频";
                    picker-width: root.model-picker-width();
                    select-model(model) => { AppState.select-video-model(model); }
                }
            }
        }
        Rectangle {
            x: parent.width - root.actions-width() - 18px;
            y: 0px;
            width: root.actions-width();
            height: 58px;
            background: transparent;
            HorizontalLayout {
                width: parent.width;
                y: (parent.height - 36px) / 2;
                height: 36px;
                spacing: root.action-gap;
                alignment: center;
                if AppState.payment-active: PillButton {
                    width: root.payment-width;
                    text: AppState.en ? "Payment status" : "查看支付状态";
                    clicked => { AppState.payment-dialog-open = true; }
                }
                if AppState.logged-in: InvitationGiftButton {}
                PillButton { width: 94px; text: AppState.language == "zh" ? "中文" : "English"; clicked => { AppState.set-language(AppState.language == "zh" ? "en" : "zh"); } }
                if !AppState.logged-in && AppState.page != "welcome": PillButton {
                    width: root.login-width;
                    text: AppState.en ? "Login" : "登录/注册";
                    primary: true;
                    clicked => {
                        AppState.auth-open = true;
                        if AppState.auth-method == "wechat" && !AppState.auth-wechat-busy && !AppState.auth-wechat-qr-ready {
                            AppState.start-wechat-login();
                        }
                    }
                }
            }
        }
    }
    function actions-width() -> length {
        let count = 1 + (AppState.logged-in || AppState.page != "welcome" ? 1 : 0) + (AppState.payment-active ? 1 : 0);
        return root.language-width
            + (AppState.logged-in ? (AppState.en ? 112px : 98px) : (AppState.page != "welcome" ? root.login-width : 0px))
            + (AppState.payment-active ? root.payment-width : 0px) + (count - 1) * root.action-gap;
    }
    function model-picker-width() -> length {
        return min(280px, (root.width - (root.models-on-second-row ? 36px : root.actions-width() + 56px) - 2 * 18px) / 3);
    }
}
