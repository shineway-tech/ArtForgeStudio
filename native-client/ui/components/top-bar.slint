import { AppState } from "../app-state.slint";
import { ModelPicker } from "model-picker.slint";
import { PillButton } from "pill-button.slint";
import { ThemeMenuButton } from "theme-menu-button.slint";
import { AppTheme } from "../theme.slint";

component InvitationGiftButton {
    property <int> wobble-step: 0;
    property <bool> wobbling: false;
    width: 48px;
    height: 36px;

    Timer {
        interval: 110ms;
        running: root.wobbling;
        triggered => {
            if root.wobble-step >= 6 {
                root.wobble-step = 0;
                root.wobbling = false;
            } else {
                root.wobble-step += 1;
            }
        }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: gift-touch.has-hover ? AppTheme.panel-soft : transparent;
        border-radius: 10px;
        gift-image := Image {
            x: 2px;
            y: -5px;
            width: 44px;
            height: 44px;
            source: @image-url("../../assets/invitation-gift.png");
            image-fit: contain;
            transform-rotation: root.wobble-angle();
            animate transform-rotation { duration: AppState.reduced-motion ? 0ms : 110ms; easing: ease-in-out; }
        }
        gift-touch := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: pointer;
            changed has-hover => {
                if self.has-hover && !AppState.reduced-motion {
                    root.wobble-step = 1;
                    root.wobbling = true;
                }
            }
            clicked => { AppState.navigate("invitation-gift"); }
        }
    }

    function wobble-angle() -> angle {
        return root.wobble-step == 1 ? -7deg
            : root.wobble-step == 2 ? 7deg
            : root.wobble-step == 3 ? -5deg
            : root.wobble-step == 4 ? 5deg
            : root.wobble-step == 5 ? -2deg
            : 0deg;
    }
}

export component TopBar {
    property <length> action-gap: 8px;
    property <length> gift-width: 48px;
    property <length> language-width: 94px;
    property <length> theme-width: 94px;
    property <length> balance-width: 150px;
    property <length> profile-width: 128px;
    property <length> payment-width: 112px;
    property <length> login-width: 112px;
    property <bool> models-on-second-row: AppState.page == "generation"
        && root.width < root.actions-width() + 36px + 2 * 240px + 38px;
    height: root.models-on-second-row ? 112px : 58px;
    Rectangle {
        width: root.width;
        height: root.height;
        background: AppTheme.bg;
        border-width: 1px;
        border-color: AppTheme.border;
        Rectangle {
            x: 18px;
            y: 0px;
            width: 94px;
            height: parent.height;
            background: transparent;
            if AppState.page != "welcome" && AppState.page != "generation": PillButton {
                x: 0px;
                y: (parent.height - 36px) / 2;
                width: 88px;
                text: AppState.en ? "← Back" : "← 返回";
                clicked => { AppState.back(); }
            }
        }
        Rectangle {
            x: 18px;
            y: root.models-on-second-row ? 58px : 0px;
            width: root.models-on-second-row ? parent.width - 36px : parent.width - root.actions-width() - 56px;
            height: 54px;
            background: transparent;
            clip: true;
            if AppState.page == "generation": Rectangle {
                width: parent.width;
                height: parent.height;
                background: transparent;
                ModelPicker {
                    x: 0px;
                    y: 6px;
                    kind: "image";
                    label: AppState.en ? "Image Model" : "生图模型";
                    picker-width: root.model-picker-width();
                    select-model(model) => { AppState.select-image-model(model); }
                }
                ModelPicker {
                    x: root.model-picker-width() + 18px;
                    y: 6px;
                    kind: "reasoning";
                    label: AppState.en ? "Reasoning Model" : "推理模型";
                    picker-width: root.model-picker-width();
                    select-model(model) => { AppState.select-reasoning-model(model); }
                }
            }
        }
        Rectangle {
            x: parent.width - root.actions-width() - 18px;
            y: 0px;
            width: root.actions-width();
            height: 58px;
            background: transparent;
            HorizontalLayout {
                width: parent.width;
                y: (parent.height - 36px) / 2;
                height: 36px;
                spacing: root.action-gap;
                alignment: center;
                if AppState.payment-active: PillButton {
                    width: root.payment-width;
                    text: AppState.en ? "Payment status" : "查看支付状态";
                    clicked => { AppState.payment-dialog-open = true; }
                }
                if AppState.logged-in: InvitationGiftButton { width: root.gift-width; }
                PillButton { width: root.language-width; text: AppState.language == "zh" ? "中文" : "English"; clicked => { AppState.set-language(AppState.language == "zh" ? "en" : "zh"); } }
                ThemeMenuButton { width: root.theme-width; }
                if AppState.logged-in: PillButton {
                    width: root.balance-width;
                    text: AppState.account-amount-label;
                    clicked => {
                        AppState.profile-open = false;
                        AppState.navigate("credits");
                    }
                }
                if AppState.logged-in: PillButton { width: root.profile-width; text: AppState.nickname; clicked => { AppState.account-center-section = "login"; AppState.profile-open = true; AppState.profile-name = AppState.nickname; } }
                if !AppState.logged-in && AppState.page != "welcome": PillButton {
                    width: root.login-width;
                    text: AppState.en ? "Login" : "登录/注册";
                    primary: true;
                    clicked => {
                        AppState.auth-open = true;
                        if AppState.auth-method == "wechat" && !AppState.auth-wechat-busy && !AppState.auth-wechat-qr-ready {
                            AppState.start-wechat-login();
                        }
                    }
                }
            }
        }
    }
    function actions-width() -> length {
        let count = 2 + (AppState.logged-in ? 3 : (AppState.page != "welcome" ? 1 : 0)) + (AppState.payment-active ? 1 : 0);
        return root.language-width + root.theme-width
            + (AppState.logged-in ? root.gift-width + root.balance-width + root.profile-width : (AppState.page != "welcome" ? root.login-width : 0px))
            + (AppState.payment-active ? root.payment-width : 0px) + (count - 1) * root.action-gap;
    }
    function model-picker-width() -> length {
        return min(330px, (root.width - (root.models-on-second-row ? 36px : root.actions-width() + 56px) - 18px) / 2);
    }
}
