import { AppState } from "../app-state.slint";
import { AppTheme } from "../theme.slint";

component BatchActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> destructive: false;
    in property <bool> disabled: false;
    callback clicked();

    height: 34px;
    opacity: root.disabled ? 0.42 : 1;
    background: touch.has-hover && !root.disabled ? AppTheme.panel-soft : AppTheme.panel;
    border-radius: 17px;
    border-width: 1px;
    border-color: touch.has-hover && !root.disabled
        ? (root.destructive ? AppTheme.danger : AppTheme.accent)
        : AppTheme.border;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.destructive ? AppTheme.danger : AppTheme.text;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: !root.disabled;
        mouse-cursor: root.disabled ? default : pointer;
        accessible-role: button;
        accessible-label: root.label;
        clicked => { root.clicked(); }
    }
}

export component GenerationBatchMenu {
    width: AppState.generation-selection-mode ? 312px : 112px;
    height: 34px;

    if !AppState.generation-selection-mode: Rectangle {
        width: root.width;
        height: root.height;
        background: batch-touch.has-hover ? AppTheme.panel-soft : AppTheme.panel;
        border-radius: 17px;
        border-width: 1px;
        border-color: batch-touch.has-hover ? AppTheme.accent : AppTheme.border;
        Image {
            x: 13px;
            y: 9px;
            width: 16px;
            height: 16px;
            source: @image-url("../../assets/icons/select.svg");
            colorize: batch-touch.has-hover ? AppTheme.accent : AppTheme.muted;
            image-fit: contain;
        }
        Text {
            x: 36px;
            width: parent.width - 46px;
            height: parent.height;
            text: AppState.en ? "Batch" : "批量操作";
            color: batch-touch.has-hover ? AppTheme.accent : AppTheme.text;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
        batch-touch := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: AppState.en ? "Batch actions" : "批量操作";
            clicked => { AppState.begin-generation-selection(); }
        }
    }

    if AppState.generation-selection-mode: HorizontalLayout {
        width: root.width;
        height: root.height;
        spacing: 8px;
        BatchActionButton {
            width: 128px;
            label: AppState.en ? "Delete invalid" : "删除全部失效";
            destructive: true;
            disabled: AppState.generation-failed-count == 0;
            clicked => { AppState.delete-all-failed-generations(); }
        }
        BatchActionButton {
            width: 92px;
            label: AppState.generation-result-count > 0
                    && AppState.generation-selected-count == AppState.generation-result-count
                ? (AppState.en ? "Clear all" : "取消全选")
                : (AppState.en ? "Select all" : "全选");
            disabled: AppState.generation-result-count == 0;
            clicked => { AppState.select-all-generations(); }
        }
        BatchActionButton {
            width: 76px;
            label: AppState.en ? "Exit" : "退出";
            clicked => { AppState.clear-generation-selection(); }
        }
    }
}
