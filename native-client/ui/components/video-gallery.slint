import { AppState } from "../app-state.slint";
import { AppTheme } from "../theme.slint";
export component VideoGallery inherits Rectangle {
    property <length> preferred-card-width: 220px;
    property <length> gap: 18px;
    property <int> columns: max(1, floor((root.width + root.gap) / (root.preferred-card-width + root.gap)));
    property <length> card-width: (root.width - (root.columns - 1) * root.gap) / root.columns;
    property <length> row-height: root.card-width + root.gap;
    background: transparent;
    clip: true;

    gallery-scroll := Flickable {
        width: parent.width;
        height: parent.height;
        viewport-width: self.width;
        viewport-height: max(self.height, ceil(AppState.saved-videos.length / root.columns) * root.row-height);
        interactive: true;

        for video[index] in AppState.saved-videos: card := Rectangle {
            x: Math.mod(index, root.columns) * (root.card-width + root.gap);
            y: floor(index / root.columns) * root.row-height;
            width: root.card-width;
            height: root.card-width;
            background: AppTheme.panel-soft;
            border-radius: AppState.card-style == "rounded" ? 10px : 0px;
            clip: true;

            if video.has-preview: Image {
                x: card-touch.has-hover ? -parent.width * 0.05 : 0px;
                y: card-touch.has-hover ? -parent.height * 0.05 : 0px;
                width: card-touch.has-hover ? parent.width * 1.10 : parent.width;
                height: card-touch.has-hover ? parent.height * 1.10 : parent.height;
                source: video.image;
                image-fit: cover;
                animate x, y, width, height { duration: 140ms; }
            }
            if !video.has-preview: Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 38px;
                height: 38px;
                source: @image-url("../../assets/icons/video.svg");
                colorize: AppTheme.accent;
                image-fit: contain;
            }

            Rectangle {
                y: parent.height - 96px;
                width: parent.width;
                height: 96px;
                background: @linear-gradient(0deg, #000000c8, #00000000);
            }
            Text {
                x: 13px;
                y: parent.height - 52px;
                width: parent.width - 26px;
                height: 22px;
                text: video.title;
                color: #ffffff;
                font-size: 14px;
                font-weight: 500;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                x: 13px;
                y: parent.height - 30px;
                width: parent.width - 26px;
                height: 18px;
                text: video.subtitle;
                color: #ffffffc8;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
            }

            card-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: pointer;
                accessible-role: button;
                accessible-label: (AppState.en ? "Play " : "播放 ") + video.title;
                accessible-action-default => { AppState.play-saved-video(video.id); }
                clicked => { AppState.play-saved-video(video.id); }
            }

            Rectangle {
                x: (parent.width - 54px) / 2;
                y: (parent.height - 54px) / 2;
                width: 54px;
                height: 54px;
                background: play-touch.has-hover ? AppTheme.accent : #000000a8;
                border-radius: 27px;
                border-width: 1px;
                border-color: #ffffff90;
                Image {
                    x: 17px;
                    y: 15px;
                    width: 22px;
                    height: 24px;
                    source: @image-url("../../assets/icons/play.svg");
                    colorize: #ffffff;
                    image-fit: contain;
                }
                play-touch := TouchArea {
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: AppState.en ? "Play video" : "播放视频";
                    accessible-action-default => { AppState.play-saved-video(video.id); }
                    clicked => { AppState.play-saved-video(video.id); }
                }
            }

            Rectangle {
                visible: card-touch.has-hover || folder-touch.has-hover;
                x: parent.width - 38px;
                y: 8px;
                width: 30px;
                height: 30px;
                background: folder-touch.has-hover ? AppTheme.accent : #000000b8;
                border-radius: AppState.card-style == "rounded" ? 6px : 0px;
                Image {
                    x: 7px;
                    y: 7px;
                    width: 16px;
                    height: 16px;
                    source: @image-url("../../assets/icons/folder-open.svg");
                    colorize: #ffffff;
                    image-fit: contain;
                }
                folder-touch := TouchArea {
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: AppState.en ? "Open folder" : "打开目录";
                    accessible-action-default => { AppState.reveal-saved-video(video.id); }
                    clicked => { AppState.reveal-saved-video(video.id); }
                }
            }

            if card-touch.has-hover: Rectangle {
                width: parent.width;
                height: parent.height;
                background: transparent;
                border-radius: AppState.card-style == "rounded" ? 10px : 0px;
                border-width: 2px;
                border-color: AppTheme.accent;
            }
        }

        if AppState.saved-videos.length == 0: Text {
            width: gallery-scroll.viewport-width;
            height: max(100px, gallery-scroll.height);
            text: AppState.en ? "No saved videos" : "暂无已保存视频";
            color: AppTheme.muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
