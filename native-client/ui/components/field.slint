import { AppState } from "../app-state.slint";
import { AppTheme } from "../theme.slint";

export component Field {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> value;
    in property <bool> secret: false;
    in-out property <bool> revealed: false;
    in property <bool> required: false;
    in property <bool> enabled: true;
    callback accepted();
    height: 78px;
    VerticalLayout {
        spacing: 7px;
        HorizontalLayout {
            height: 20px;
            spacing: 3px;
            alignment: start;
            Text { height: parent.height; text: root.label; color: AppTheme.text; font-size: AppState.settings-font-size * 1px; font-weight: 400; vertical-alignment: center; }
            if root.required: Text { width: 8px; height: parent.height; text: "*"; color: AppTheme.danger; font-size: AppState.settings-font-size * 1px; font-weight: 400; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; background: transparent; }
        }
        Rectangle {
            height: 46px;
            background: AppTheme.panel;
            border-radius: 8px;
            border-width: 1px;
            border-color: input.has-focus ? AppTheme.accent : AppTheme.border;
            input := TextInput {
                x: 14px;
                width: parent.width - 28px - (root.secret ? 52px : 0px);
                height: parent.height;
                text <=> root.value;
                enabled: root.enabled;
                input-type: root.secret && !root.revealed ? password : text;
                single-line: true;
                color: AppTheme.text;
                font-size: AppState.settings-font-size * 1px;
                font-weight: 400;
                vertical-alignment: center;
                accepted => { root.accepted(); }
            }
            if root.value == "" && !input.has-focus: Text {
                x: 14px;
                width: parent.width - 28px - (root.secret ? 52px : 0px);
                height: parent.height;
                text: root.placeholder;
                color: AppTheme.weak;
                font-size: AppState.settings-font-size * 1px;
                font-weight: 400;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.secret: Text {
                x: parent.width - 58px;
                width: 48px;
                height: parent.height;
                text: root.revealed ? (AppState.en ? "Hide" : "隐藏") : (AppState.en ? "Show" : "显示");
                color: AppTheme.accent;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    enabled: root.enabled;
                    mouse-cursor: root.enabled ? pointer : default;
                    clicked => { root.revealed = !root.revealed; }
                }
            }
        }
    }
}
