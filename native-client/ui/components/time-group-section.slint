import { ThumbnailCard } from "thumbnail-card.slint";
import { GenerationLoadingCard } from "generation-loading-card.slint";
import { GalleryWaterfall } from "gallery-waterfall.slint";
import { GenerationWaterfall } from "generation-waterfall.slint";
import { AppTheme } from "../theme.slint";
import { AssetGroup } from "../types.slint";

export component TimeGroupSection {
    in property <AssetGroup> group;
    in property <length> card-width: 200px;
    in property <string> source: "asset";
    in property <int> loading-count: 0;
    in property <string> layout-mode: "grid";
    in-out property <int> loading-bounce-step: 0;
    height: root.content-height();
    Timer {
        interval: 100ms;
        running: root.loading-count > 0;
        triggered => {
            root.loading-bounce-step = Math.mod(root.loading-bounce-step + 1, 20);
        }
    }
    Rectangle {
        width: root.width;
        height: root.height;
        background: transparent;
        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.header-height();
            text: root.group.title;
            color: AppTheme.text;
            font-size: 20px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.layout-mode == "grid" && root.loading-count > 0: GenerationLoadingCard {
            x: root.item-x(0);
            y: root.item-y(0);
            card-width: root.item-width();
            card-gap: 0px;
            sequence-index: 0;
            bounce-step: root.loading-bounce-step;
        }
        if root.layout-mode == "grid" && root.loading-count > 1: GenerationLoadingCard {
            x: root.item-x(1);
            y: root.item-y(1);
            card-width: root.item-width();
            card-gap: 0px;
            sequence-index: 1;
            bounce-step: root.loading-bounce-step;
        }
        if root.layout-mode == "grid" && root.loading-count > 2: GenerationLoadingCard {
            x: root.item-x(2);
            y: root.item-y(2);
            card-width: root.item-width();
            card-gap: 0px;
            sequence-index: 2;
            bounce-step: root.loading-bounce-step;
        }
        if root.layout-mode == "grid" && root.loading-count > 3: GenerationLoadingCard {
            x: root.item-x(3);
            y: root.item-y(3);
            card-width: root.item-width();
            card-gap: 0px;
            sequence-index: 3;
            bounce-step: root.loading-bounce-step;
        }
        for item[index] in root.group.items: ThumbnailCard {
            active: root.layout-mode == "grid";
            x: root.item-x(index + root.loading-count);
            y: root.item-y(index + root.loading-count);
            item: item;
            card-width: root.item-width();
            card-gap: 0px;
            source: root.source;
        }
    }
    generation-waterfall := GenerationWaterfall {
        visible: root.layout-mode == "waterfall" && root.source == "generation";
        x: 0px;
        y: root.grid-y();
        width: root.width;
        items: root.group.items;
        card-width: root.card-width;
        loading-count: root.loading-count;
        bounce-step: root.loading-bounce-step;
    }
    gallery-waterfall := GalleryWaterfall {
        visible: root.layout-mode == "waterfall" && root.source != "generation";
        x: 0px;
        y: root.grid-y();
        width: root.width;
        items: root.group.items;
        card-width: root.item-width();
        source: root.source;
    }
    function grid-gap() -> length {
        return 8px;
    }
    function header-height() -> length {
        return 32px;
    }
    function section-gap() -> length {
        return 26px;
    }
    function grid-y() -> length {
        return root.header-height() + 8px;
    }
    function grid-width() -> length {
        return max(1px, root.width);
    }
    function column-count() -> int {
        return max(1, min(root.item-count(), min(8, floor((root.grid-width() + root.grid-gap()) / (root.card-width + root.grid-gap())))));
    }
    function item-width() -> length {
        return min(root.card-width, max(118px, (root.grid-width() - (root.column-count() - 1) * root.grid-gap()) / root.column-count()));
    }
    function row-height() -> length {
        return root.item-width() + root.grid-gap();
    }
    function row-count() -> int {
        return (root.item-count() + root.column-count() - 1) / root.column-count();
    }
    function item-x(index: int) -> length {
        return Math.mod(index, root.column-count()) * (root.item-width() + root.grid-gap());
    }
    function item-y(index: int) -> length {
        return root.grid-y() + floor(index / root.column-count()) * root.row-height();
    }
    function content-height() -> length {
        if root.item-count() == 0 {
            return 0px;
        }
        if root.layout-mode == "waterfall" {
            if root.source == "generation" {
                return root.grid-y() + generation-waterfall.height + root.section-gap();
            }
            return root.grid-y() + gallery-waterfall.height + root.section-gap();
        }
        return root.grid-y() + root.row-count() * root.row-height() + root.section-gap();
    }
    function item-count() -> int {
        return root.group.items.length + root.loading-count;
    }
}
