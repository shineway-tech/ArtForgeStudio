import { EmptyState } from "empty-state.slint";
import { TimeGroupedGallery } from "time-grouped-gallery.slint";
import { AssetGroup, AssetItem } from "../types.slint";

export component AssetGallery {
    in property <[AssetItem]> items;
    in property <[AssetGroup]> groups;
    in property <string> source;
    in property <length> card-width: 220px;
    in property <string> layout-mode: "grid";
    Rectangle {
        width: root.width;
        height: root.height;
        clip: true;
        background: transparent;
        Flickable {
            width: parent.width;
            height: parent.height;
            viewport-width: parent.width;
            viewport-height: max(self.height, asset-gallery-content.preferred-height);
            interactive: true;
            Rectangle {
                width: parent.viewport-width;
                height: parent.viewport-height;
                background: transparent;
                if root.is-empty(): EmptyState {
                    width: parent.width;
                    height: max(360px, root.height);
                }
                asset-gallery-content := TimeGroupedGallery {
                    visible: !root.is-empty();
                    width: parent.width;
                    height: self.preferred-height;
                    groups: root.groups;
                    card-width: root.card-width;
                    source: root.source;
                    layout-mode: root.layout-mode;
                }
            }
        }
    }
    function is-empty() -> bool {
        return root.items.length == 0;
    }
}
