import { AppState } from "../app-state.slint";
import { AppTheme } from "../theme.slint";
import { NavGlyph } from "nav-glyph.slint";
import { PillButton } from "pill-button.slint";

component AccountAvatar inherits Rectangle {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: AppTheme.accent-dark;
    Image {
        x: 7px; y: 7px; width: 18px; height: 18px;
        source: AppState.icon-account-person;
        colorize: #ffffff;
        image-fit: contain;
    }
}

component AccountMenuRow inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> show-dot: false;
    callback clicked();
    height: 38px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    border-radius: 8px;
    background: touch.has-hover ? AppTheme.panel-soft : transparent;
    Image {
        x: 10px; y: 10px; width: 18px; height: 18px;
        source: root.icon; colorize: AppTheme.text; image-fit: contain;
    }
    Text {
        x: 40px; width: parent.width - 66px; height: parent.height;
        text: root.label; color: AppTheme.text; font-size: 13px;
        font-weight: 400; vertical-alignment: center; overflow: elide;
    }
    if root.show-dot: Rectangle {
        x: parent.width - 20px; y: 15px; width: 7px; height: 7px;
        border-radius: 4px; background: AppTheme.danger;
    }
    touch := TouchArea {
        width: parent.width; height: parent.height; mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SidebarCreditsButton inherits Rectangle {
    in property <bool> collapsed: false;
    width: root.collapsed ? 56px : 80px;
    height: 38px;
    accessible-role: button;
    accessible-label: AppState.account-amount-label;
    accessible-action-default => { AppState.navigate("credits"); }
    border-radius: 7px;
    border-width: AppState.page == "credits" ? 1px : 0px;
    border-color: AppTheme.accent;
    background: AppState.page == "credits" || credit-touch.has-hover
        ? AppTheme.panel-soft
        : transparent;
    Rectangle {
        x: root.collapsed ? (parent.width - self.width) / 2 : 5px;
        y: 8px;
        width: 22px;
        height: 22px;
        border-radius: 6px;
        background: AppTheme.panel-soft;
        NavGlyph {
            kind: "credits";
            glyph-color: AppTheme.accent-dark;
            width: parent.width;
            height: parent.height;
        }
    }
    if !root.collapsed: Text {
        x: 32px;
        width: parent.width - 36px;
        height: parent.height;
        text: AppState.en ? "Credits" : "积分";
        color: AppTheme.text;
        font-size: AppState.settings-font-size * 1px;
        font-weight: 500;
        vertical-alignment: center;
        overflow: elide;
    }
    credit-touch := TouchArea {
        width: parent.width; height: parent.height; mouse-cursor: pointer;
        clicked => { AppState.navigate("credits"); }
    }
}

export component SidebarAccountButton inherits Rectangle {
    in property <bool> collapsed: false;
    in property <bool> show-dot: false;
    height: 42px;
    accessible-role: button;
    accessible-label: AppState.en ? "Account menu" : "账户菜单";
    accessible-action-default => { account-popup.show(); }
    border-radius: 9px;
    background: account-touch.has-hover ? AppTheme.panel-soft : transparent;
    AccountAvatar {
        x: root.collapsed ? (parent.width - 32px) / 2 : 6px;
        y: 5px;
    }
    if !root.collapsed: Text {
        x: 48px; width: parent.width - 70px; height: parent.height;
        text: AppState.logged-in ? AppState.nickname : (AppState.en ? "Guest" : "未登录");
        color: AppTheme.text; font-size: 13px; font-weight: 400;
        vertical-alignment: center; overflow: elide;
    }
    if root.show-dot: Rectangle {
        x: parent.width - (root.collapsed ? 9px : 12px); y: 5px;
        width: 7px; height: 7px; border-radius: 4px; background: AppTheme.danger;
    }
    account-touch := TouchArea {
        width: parent.width; height: parent.height; mouse-cursor: pointer;
        clicked => { account-popup.show(); }
    }

    function login() {
        AppState.auth-open = true;
        if AppState.auth-method == "wechat" && !AppState.auth-wechat-busy && !AppState.auth-wechat-qr-ready {
            AppState.start-wechat-login();
        }
    }

    account-popup := PopupWindow {
        x: root.width + 12px;
        y: root.height - self.height;
        width: 280px;
        height: 286px;
        close-policy: close-on-click-outside;
        account-popup-panel := Rectangle {
            width: parent.width; height: parent.height;
            background: AppTheme.panel;
            border-radius: 16px; border-width: 1px; border-color: AppTheme.border;
            AccountAvatar { x: 16px; y: 16px; }
            Text {
                x: 60px; y: 16px; width: parent.width - 76px; height: 32px;
                text: AppState.logged-in ? AppState.nickname : (AppState.en ? "Guest" : "未登录");
                color: AppTheme.text; font-size: 15px; font-weight: 500;
                vertical-alignment: center; overflow: elide;
            }
            Text {
                x: 16px; y: 64px; width: 142px; height: 22px;
                text: AppState.logged-in ? AppState.membership-plan-name : (AppState.en ? "Sign in to continue" : "登录后查看账户信息");
                color: AppTheme.muted; font-size: 12px; vertical-alignment: center; overflow: elide;
            }
            if AppState.logged-in: Text {
                x: 162px; y: 64px; width: parent.width - 178px; height: 22px;
                text: AppState.account-amount-label; color: AppTheme.text; font-size: 12px;
                horizontal-alignment: right; vertical-alignment: center; overflow: elide;
            }
            account-membership := PillButton {
                x: 16px; y: 94px; width: parent.width - 32px; height: 32px;
                text: !AppState.logged-in ? (AppState.en ? "Sign in" : "登录/注册")
                    : (AppState.membership-tier-rank > 0 ? (AppState.en ? "Manage membership" : "管理会员")
                    : (AppState.en ? "Upgrade membership" : "开通会员"));
                primary: true;
                clicked => {
                    account-popup.close();
                    if AppState.logged-in {
                        AppState.credits-tab = "membership";
                        AppState.navigate("credits");
                    } else { root.login(); }
                }
            }
            Rectangle { x: 12px; y: 138px; width: parent.width - 24px; height: 1px; background: AppTheme.border; }
            account-profile := AccountMenuRow {
                x: 8px; y: 148px; width: parent.width - 16px;
                label: AppState.en ? "Personal information" : "个人信息";
                icon: AppState.icon-account-person;
                clicked => {
                    account-popup.close();
                    if AppState.logged-in {
                        AppState.account-center-section = "login";
                        AppState.profile-name = AppState.nickname;
                        AppState.profile-open = true;
                    } else { root.login(); }
                }
            }
            account-settings := AccountMenuRow {
                x: 8px; y: 190px; width: parent.width - 16px;
                label: AppState.en ? "Settings" : "设置";
                icon: AppState.icon-settings;
                show-dot: AppState.update-available;
                clicked => { account-popup.close(); AppState.settings-section = "basic"; AppState.navigate("settings"); }
            }
            account-logout := AccountMenuRow {
                x: 8px; y: 232px; width: parent.width - 16px;
                label: AppState.logged-in ? (AppState.en ? "Logout" : "退出登录") : (AppState.en ? "Sign in" : "登录/注册");
                icon: @image-url("../../assets/icons/account-logout.svg");
                clicked => { account-popup.close(); if AppState.logged-in { AppState.logout(); } else { root.login(); } }
            }
        }
    }
}
