import { AppState } from "../app-state.slint";
import { AppTheme } from "../theme.slint";
import { GenerateGlowBorder } from "generate-glow-border.slint";

export component GenerateActionButton {
    in property <bool> disabled: false;
    callback clicked();
    height: 56px;
    Rectangle {
        width: root.width;
        height: root.height;
        opacity: root.disabled ? 0.45 : 1.0;
        background: AppTheme.accent;
        border-radius: root.height / 2;
        if AppState.generating: Text {
            x: 14px;
            width: parent.width - 28px;
            height: parent.height;
            text: AppState.en ? "Stop" : "停止生成";
            color: #ffffff;
            font-size: AppState.settings-font-size * 1px;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        credit-icon := Image {
            visible: !AppState.generating;
            x: (parent.width - (16px + 5px + credit-value.preferred-width + 12px + action-label.preferred-width)) / 2;
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            source: @image-url("../../assets/icons/credits.svg");
            colorize: #ffffff;
            image-fit: contain;
        }
        credit-value := Text {
            visible: !AppState.generating;
            x: credit-icon.x + credit-icon.width + 5px;
            width: self.preferred-width;
            height: parent.height;
            text: AppState.generation-estimated-credit-cost;
            color: #ffffff;
            font-size: AppState.settings-font-size * 1px;
            font-weight: 500;
            vertical-alignment: center;
        }
        action-label := Text {
            visible: !AppState.generating;
            x: credit-value.x + credit-value.width + 12px;
            width: self.preferred-width;
            height: parent.height;
            text: AppState.en ? "Generate" : "生成";
            color: #ffffff;
            font-size: AppState.settings-font-size * 1px;
            font-weight: 500;
            vertical-alignment: center;
        }
        GenerateGlowBorder {
            width: parent.width;
            height: parent.height;
            radius: parent.border-radius;
            active: !root.disabled;
        }
        touch := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: root.disabled ? default : pointer;
            clicked => {
                if !root.disabled {
                    root.clicked();
                }
            }
        }
    }
}
