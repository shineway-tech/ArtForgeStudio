import { ScrollView } from "std-widgets.slint";
import { AppState } from "../app-state.slint";
import { PillButton } from "../components/pill-button.slint";
import { ProgressSpinner } from "../components/progress-spinner.slint";
import { ViewerContextMenuItem } from "../components/viewer-context-menu-item.slint";
import { ViewerNavButton } from "../components/viewer-nav-button.slint";
import { AppTheme } from "../theme.slint";

component ViewerInfoText inherits Text {
    in property <string> value;
    in property <color> foreground: AppTheme.text;
    text: root.value;
    color: root.foreground;
    font-size: 13px;
    font-weight: 500;
    vertical-alignment: center;
    overflow: elide;
    width: min(self.preferred-width, 180px);
}

component ViewerFooterActionButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <color> foreground: AppTheme.text;
    height: 44px;
    background: action-touch.has-hover ? root.foreground.with-alpha(0.12) : root.foreground.with-alpha(0.045);
    border-radius: 8px;
    border-width: 1px;
    border-color: action-touch.has-hover ? root.foreground.with-alpha(0.55) : root.foreground.with-alpha(0.20);
    callback clicked();

    Image {
        x: 14px;
        y: (parent.height - 18px) / 2;
        width: 18px;
        height: 18px;
        source: root.icon;
        colorize: root.foreground;
        image-fit: contain;
    }
    Text {
        x: 40px;
        width: parent.width - 52px;
        height: parent.height;
        text: root.label;
        color: root.foreground;
        font-size: 13px;
        font-weight: 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    action-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ViewerToolActionButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> disabled: false;
    callback clicked();
    height: 44px;
    opacity: root.disabled ? 0.42 : 1;
    background: tool-touch.has-hover && !root.disabled ? AppTheme.accent.with-alpha(0.10) : transparent;
    border-radius: 7px;

    Image {
        x: 12px;
        y: (parent.height - 17px) / 2;
        width: 17px;
        height: 17px;
        source: root.icon;
        colorize: AppTheme.text;
        image-fit: contain;
    }
    Text {
        x: 39px;
        width: parent.width - 50px;
        height: parent.height;
        text: root.label;
        color: AppTheme.text;
        font-size: 13px;
        font-weight: 400;
        vertical-alignment: center;
        overflow: elide;
    }
    tool-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: root.disabled ? default : pointer;
        clicked => {
            if !root.disabled {
                root.clicked();
            }
        }
    }
}

export component ViewerOverlay {
    property <length> viewer-message-width: min(360px, max(220px, root.width - 80px));
    property <bool> detail-collapsed: false;
    property <bool> image-fullscreen: false;
    property <float> image-zoom: 1.0;
    property <length> detail-panel-width: AppState.viewer-source == "reference" || root.detail-collapsed || root.image-fullscreen ? 0px : 460px;
    property <length> viewer-content-right: root.width - root.detail-panel-width;
    property <length> viewer-padding: 24px;
    property <length> viewer-nav-lane: AppState.viewer-source == "reference" ? 0px : 84px;
    property <length> viewer-nav-size: 52px;
    property <bool> context-menu-open: false;
    property <length> context-menu-x: 0px;
    property <length> context-menu-y: 0px;
    property <length> context-menu-width: 188px;
    property <length> context-menu-height: AppState.viewer-category == "character" ? 334px : 214px;
    property <bool> image-drag-armed: false;
    property <bool> image-system-drag-started: false;
    property <length> image-pressed-x: 0px;
    property <length> image-pressed-y: 0px;
    property <bool> image-pan-active: false;
    property <length> image-pan-x: 0px;
    property <length> image-pan-y: 0px;
    property <length> image-pan-start-x: 0px;
    property <length> image-pan-start-y: 0px;
    if AppState.viewer-open: Rectangle {
        background: AppTheme.bg;
        viewer-shortcuts := FocusScope {
            width: 1px;
            height: 1px;
            focus-on-click: false;
            init => { self.focus(); }
            key-pressed(event) => {
                if event.modifiers.control
                    || event.modifiers.alt
                    || event.modifiers.meta
                    || AppState.viewer-processing
                    || AppState.delete-confirm-open {
                    return reject;
                }
                if (event.text == "o" || event.text == "O")
                    && AppState.viewer-source != "reference" {
                    AppState.viewer-open-image();
                    return accept;
                }
                if (event.text == "e" || event.text == "E")
                    && AppState.viewer-source != "reference"
                    && AppState.viewer-source != "inspiration" {
                    AppState.viewer-open-image-editor();
                    return accept;
                }
                if (event.text == "a" || event.text == "A")
                    && AppState.viewer-source != "reference" {
                    AppState.viewer-use-reference();
                    return accept;
                }
                if event.text == Key.Delete
                    && AppState.viewer-source != "reference"
                    && AppState.viewer-source != "inspiration" {
                    AppState.request-delete-asset(AppState.viewer-id);
                    return accept;
                }
                return reject;
            }
        }
        Timer {
            interval: 2200ms;
            running: AppState.viewer-message != "";
            triggered => { AppState.viewer-message = ""; }
        }
        if !root.image-fullscreen: PillButton { x: 24px; y: 24px; width: 88px; text: AppState.en ? "← Back" : "← 返回"; clicked => { root.image-zoom = 1.0; root.image-pan-x = 0px; root.image-pan-y = 0px; root.detail-collapsed = false; AppState.close-viewer(); } }
        if AppState.viewer-source != "reference" && !root.image-fullscreen: viewer-info := HorizontalLayout {
            x: 124px;
            y: 24px;
            width: root.viewer-content-right - 248px;
            height: 40px;
            spacing: 8px;
            alignment: center;
            Rectangle { horizontal-stretch: 1; background: transparent; }
            ViewerInfoText {
                value: AppState.viewer-width + "X" + AppState.viewer-height + " \\";
                foreground: #24b8ff;
            }
            ViewerInfoText {
                value: AppState.viewer-ratio + " \\";
                foreground: #42d79e;
            }
            ViewerInfoText {
                value: AppState.viewer-quality + " \\";
                foreground: #ffb454;
            }
            ViewerInfoText {
                value: AppState.viewer-model;
                foreground: #bda4ff;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
        }
        viewer-image-stage := Rectangle {
            x: root.image-fullscreen ? 0px : (AppState.viewer-source == "reference" ? 128px : root.viewer-padding + root.viewer-nav-lane);
            y: root.image-fullscreen ? 0px : 78px;
            width: root.image-fullscreen ? root.viewer-content-right : (AppState.viewer-source == "reference" ? parent.width - 256px : root.viewer-content-right - root.viewer-padding * 2 - root.viewer-nav-lane * 2);
            height: root.image-fullscreen ? parent.height : (AppState.viewer-source == "reference"
                ? parent.height - 112px
                : AppState.viewer-source == "inspiration" ? parent.height - 96px : parent.height - 172px);
            background: transparent;
            clip: true;
            property <float> source-aspect: AppState.viewer-width > 0 && AppState.viewer-height > 0
                ? AppState.viewer-width * 1.0 / AppState.viewer-height
                : 1;
            property <length> base-image-width: min(self.width, self.height * self.source-aspect);
            property <length> base-image-height: min(self.height, self.width / self.source-aspect);
            property <length> max-pan-x: max(0px, (self.base-image-width * root.image-zoom - self.width) / 2);
            property <length> max-pan-y: max(0px, (self.base-image-height * root.image-zoom - self.height) / 2);
            property <bool> can-pan: self.max-pan-x > 0px || self.max-pan-y > 0px;
            viewer-image := Image {
                x: (parent.width - self.width) / 2 + root.image-pan-x;
                y: (parent.height - self.height) / 2 + root.image-pan-y;
                width: parent.base-image-width * root.image-zoom;
                height: parent.base-image-height * root.image-zoom;
                source: AppState.viewer-image;
                image-fit: contain;
            }
            image-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: viewer-image-stage.can-pan ? move : pointer;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                        root.image-drag-armed = false;
                        root.context-menu-open = true;
                        root.context-menu-x = self.absolute-position.x + self.mouse-x;
                        root.context-menu-y = self.absolute-position.y + self.mouse-y;
                    } else if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.context-menu-open = false;
                        root.image-system-drag-started = false;
                        root.image-pressed-x = self.mouse-x;
                        root.image-pressed-y = self.mouse-y;
                        if viewer-image-stage.can-pan {
                            root.image-pan-active = true;
                            root.image-drag-armed = false;
                            root.image-pan-start-x = root.image-pan-x;
                            root.image-pan-start-y = root.image-pan-y;
                        } else {
                            root.image-pan-active = false;
                            root.image-drag-armed = true;
                        }
                    } else if event.kind == PointerEventKind.move && root.image-pan-active {
                        root.image-pan-x = max(-viewer-image-stage.max-pan-x, min(
                            viewer-image-stage.max-pan-x,
                            root.image-pan-start-x + self.mouse-x - root.image-pressed-x
                        ));
                        root.image-pan-y = max(-viewer-image-stage.max-pan-y, min(
                            viewer-image-stage.max-pan-y,
                            root.image-pan-start-y + self.mouse-y - root.image-pressed-y
                        ));
                    } else if event.kind == PointerEventKind.move
                        && root.image-drag-armed
                        && !root.image-system-drag-started
                        && (Math.abs(self.mouse-x - root.image-pressed-x) >= 7px
                            || Math.abs(self.mouse-y - root.image-pressed-y) >= 7px) {
                        root.image-system-drag-started = true;
                        AppState.start-viewer-file-drag();
                        root.image-drag-armed = false;
                        root.image-system-drag-started = false;
                    } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                        root.image-pan-active = false;
                        root.image-drag-armed = false;
                        root.image-system-drag-started = false;
                    }
                }
                scroll-event(event) => {
                    if event.delta-y != 0 {
                        root.image-zoom = max(0.5, min(3.0, root.image-zoom + (event.delta-y > 0 ? 0.1 : -0.1)));
                        root.image-pan-x = max(-viewer-image-stage.max-pan-x, min(viewer-image-stage.max-pan-x, root.image-pan-x));
                        root.image-pan-y = max(-viewer-image-stage.max-pan-y, min(viewer-image-stage.max-pan-y, root.image-pan-y));
                        return accept;
                    }
                    return reject;
                }
            }
            fullscreen-button := Rectangle {
                x: parent.width - 52px;
                y: 12px;
                width: 40px;
                height: 40px;
                opacity: image-touch.has-hover || fullscreen-touch.has-hover || root.image-fullscreen ? 1 : 0;
                background: fullscreen-touch.has-hover ? #111827e8 : #111827b8;
                border-radius: 8px;
                border-width: 1px;
                border-color: #ffffff38;
                Image {
                    x: 10px;
                    y: 10px;
                    width: 20px;
                    height: 20px;
                    source: root.image-fullscreen
                        ? @image-url("../../assets/icons/restore.svg")
                        : @image-url("../../assets/icons/fit.svg");
                    colorize: #ffffff;
                    image-fit: contain;
                }
                fullscreen-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => {
                        root.image-fullscreen = !root.image-fullscreen;
                        root.image-zoom = 1.0;
                        root.image-pan-x = 0px;
                        root.image-pan-y = 0px;
                        root.context-menu-open = false;
                    }
                }
            }
            if AppState.viewer-processing: Rectangle {
                width: parent.width;
                height: parent.height;
                background: #00000099;
                ProgressSpinner {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    label: AppState.viewer-processing-label;
                    progress: AppState.viewer-processing-progress;
                }
                TouchArea { width: parent.width; height: parent.height; }
            }
        }
        if AppState.viewer-source != "reference" && !root.image-fullscreen: ViewerNavButton {
            x: root.viewer-padding + (root.viewer-nav-lane - root.viewer-nav-size) / 2;
            y: (parent.height - 52px) / 2;
            direction: "prev";
            clicked => { root.image-zoom = 1.0; root.image-pan-x = 0px; root.image-pan-y = 0px; AppState.viewer-prev(); }
        }
        if AppState.viewer-source != "reference" && !root.image-fullscreen: ViewerNavButton {
            x: root.viewer-content-right - root.viewer-padding - root.viewer-nav-lane + (root.viewer-nav-lane - root.viewer-nav-size) / 2;
            y: (parent.height - 52px) / 2;
            direction: "next";
            clicked => { root.image-zoom = 1.0; root.image-pan-x = 0px; root.image-pan-y = 0px; AppState.viewer-next(); }
        }
        if AppState.viewer-source != "reference" && AppState.viewer-source != "inspiration" && !root.image-fullscreen: Rectangle {
            x: 0px;
            y: parent.height - 76px;
            width: root.viewer-content-right;
            height: 76px;
            background: AppTheme.bg;
            viewer-footer-actions := HorizontalLayout {
                x: 24px;
                y: 12px;
                width: parent.width - 48px;
                height: 44px;
                spacing: 10px;
                ViewerFooterActionButton {
                    horizontal-stretch: 1;
                    icon: @image-url("../../assets/icons/download.svg");
                    label: AppState.en ? "Open Folder" : "打开文件夹";
                    foreground: AppTheme.custom-prompt-name-3;
                    clicked => { AppState.viewer-download-image(); }
                }
                ViewerFooterActionButton {
                    horizontal-stretch: 1;
                    icon: @image-url("../../assets/icons/video.svg");
                    label: AppState.en ? "Generate Video" : "生成视频";
                    foreground: AppTheme.custom-prompt-name;
                    clicked => { AppState.viewer-generate-video(); }
                }
                ViewerFooterActionButton {
                    horizontal-stretch: 1;
                    icon: @image-url("../../assets/icons/upload.svg");
                    label: AppState.en ? "Add as Reference" : "添加到参考图";
                    foreground: AppTheme.success;
                    clicked => { AppState.viewer-use-reference(); }
                }
                ViewerFooterActionButton {
                    horizontal-stretch: 1;
                    icon: @image-url("../../assets/icons/canvas.svg");
                    label: AppState.en ? "Import to Canvas" : "导入无限画布";
                    foreground: AppTheme.custom-prompt-name-2;
                    clicked => { AppState.viewer-import-to-canvas(); }
                }
                ViewerFooterActionButton {
                    horizontal-stretch: 1;
                    icon: @image-url("../../assets/icons/trash.svg");
                    label: AppState.en ? "Delete" : "删除";
                    foreground: AppTheme.danger;
                    clicked => { AppState.request-delete-asset(AppState.viewer-id); }
                }
            }
        }
        if AppState.viewer-message != "": Rectangle {
            x: (parent.width - root.viewer-message-width) / 2;
            y: parent.height - 130px;
            width: root.viewer-message-width;
            height: 42px;
            background: #111827d8;
            border-radius: 21px;
            Text {
                x: 18px;
                width: parent.width - 36px;
                height: parent.height;
                text: AppState.viewer-message;
                color: #ffffff;
                font-size: 14px;
                font-weight: 400;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if AppState.viewer-source != "reference" && !root.detail-collapsed && !root.image-fullscreen: Rectangle {
            x: root.viewer-content-right;
            y: 0px;
            width: root.detail-panel-width;
            height: parent.height;
            background: AppTheme.panel;
            border-width: 1px;
            border-color: AppTheme.border;
            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                if AppState.viewer-source == "asset": Rectangle {
                    height: 40px;
                    background: transparent;
                    PillButton { x: 0px; width: 128px; text: AppState.en ? "Open Folder" : "打开文件夹位置"; primary: true; clicked => { AppState.viewer-download-image(); } }
                    PillButton { x: parent.width - 72px; width: 72px; text: "删除"; danger: true; clicked => { AppState.request-delete-asset(AppState.viewer-id); } }
                }
                Rectangle {
                    height: 36px;
                    background: transparent;
                    Rectangle {
                        x: 0px;
                        width: 32px;
                        height: 32px;
                        background: collapse-detail-touch.has-hover ? AppTheme.panel-soft : transparent;
                        border-radius: 8px;
                        Text { width: parent.width; height: parent.height; text: "›"; color: AppTheme.muted; font-size: 24px; horizontal-alignment: center; vertical-alignment: center; }
                        collapse-detail-touch := TouchArea { width: parent.width; height: parent.height; mouse-cursor: pointer; clicked => { root.detail-collapsed = true; } }
                    }
                    Text { x: 42px; width: parent.width - 42px; height: parent.height; text: AppState.en ? "Prompt" : "图片提示词"; color: AppTheme.muted; font-size: 14px; font-weight: 400; vertical-alignment: center; }
                }
                prompt-scroll := ScrollView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    viewport-width: self.width;
                    viewport-height: max(self.height, AppState.viewer-prompt-lines * 18px);
                    prompt-selection-input := TextInput {
                        width: parent.width;
                        height: parent.viewport-height;
                        text: AppState.viewer-prompt;
                        color: AppTheme.text;
                        font-size: 13px;
                        font-weight: 400;
                        single-line: false;
                        wrap: word-wrap;
                        read-only: true;
                    }
                }
                Text { text: AppState.viewer-time; color: AppTheme.muted; font-size: 12px; font-weight: 400; }
                Rectangle { height: 1px; background: AppTheme.border; }
                if AppState.viewer-source != "inspiration": cutout-tools-card := Rectangle {
                    height: 62px;
                    background: AppTheme.panel-soft;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: AppTheme.border;
                    HorizontalLayout {
                        x: 8px;
                        y: 8px;
                        width: parent.width - 16px;
                        height: parent.height - 16px;
                        spacing: 4px;
                        ViewerToolActionButton {
                            horizontal-stretch: 1;
                            icon: @image-url("../../assets/icons/fit.svg");
                            label: AppState.en ? "Cutout" : "抠图";
                            disabled: AppState.viewer-processing || AppState.cutout-processing || AppState.viewer-cutout-done;
                            clicked => { AppState.viewer-cutout-image(); }
                        }
                        ViewerToolActionButton {
                            horizontal-stretch: 1;
                            icon: @image-url("../../assets/icons/focus.svg");
                            label: AppState.en ? "Clear Upscale" : "清晰放大";
                            disabled: AppState.viewer-processing || AppState.viewer-upscale-done;
                            clicked => { AppState.open-upscale-dialog(); }
                        }
                        ViewerToolActionButton {
                            horizontal-stretch: 1;
                            icon: @image-url("../../assets/icons/edit.svg");
                            label: AppState.en ? "Local Edit" : "局部修改";
                            clicked => { AppState.viewer-open-image-editor(); }
                        }
                    }
                }
                if AppState.viewer-source != "inspiration" && AppState.viewer-repeat-enabled: viewer-repeat-card := Rectangle {
                    height: 62px;
                    background: AppTheme.panel-soft;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: AppTheme.border;
                    HorizontalLayout {
                        x: 8px;
                        y: 8px;
                        width: parent.width - 16px;
                        height: parent.height - 16px;
                        spacing: 4px;
                        ViewerToolActionButton {
                            horizontal-stretch: 1;
                            icon: @image-url("../../assets/icons/edit.svg");
                            label: AppState.en ? "Use Prompt" : "使用提示词";
                            clicked => { AppState.viewer-edit(); }
                        }
                        ViewerToolActionButton {
                            horizontal-stretch: 1;
                            icon: @image-url("../../assets/icons/redo.svg");
                            label: AppState.en ? "Generate Again" : "再次生成";
                            clicked => { AppState.viewer-regenerate(); }
                        }
                    }
                }
                if AppState.viewer-source == "inspiration": HorizontalLayout {
                    spacing: 10px;
                    PillButton { horizontal-stretch: 1; text: AppState.en ? "Use Style" : "做同款"; primary: true; clicked => { AppState.viewer-use-same(); } }
                    PillButton { horizontal-stretch: 1; text: AppState.en ? "Use as Ref" : "用作参考图"; primary: true; clicked => { AppState.viewer-use-reference(); } }
                }
            }
        }
        if AppState.viewer-source != "reference" && root.detail-collapsed && !root.image-fullscreen: Rectangle {
            x: parent.width - 42px;
            y: 18px;
            width: 32px;
            height: 32px;
            background: expand-detail-touch.has-hover ? AppTheme.panel-soft : AppTheme.panel;
            border-radius: 8px;
            border-width: 1px;
            border-color: AppTheme.border;
            Text { width: parent.width; height: parent.height; text: "‹"; color: AppTheme.muted; font-size: 24px; horizontal-alignment: center; vertical-alignment: center; }
            expand-detail-touch := TouchArea { width: parent.width; height: parent.height; mouse-cursor: pointer; clicked => { root.detail-collapsed = false; } }
        }
        if root.context-menu-open: Rectangle {
            x: max(12px, min(root.context-menu-x, parent.width - root.context-menu-width - 12px));
            y: max(12px, min(root.context-menu-y, parent.height - root.context-menu-height - 12px));
            width: root.context-menu-width;
            height: root.context-menu-height;
            background: AppTheme.panel;
            border-radius: 8px;
            border-width: 1px;
            border-color: AppTheme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: #0000002d;
            VerticalLayout {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: parent.height - 16px;
                spacing: 2px;
                if AppState.viewer-category == "character": ViewerContextMenuItem {
                    text: AppState.en ? "Character Age Progression" : "角色年龄变化";
                    clicked => {
                        root.context-menu-open = false;
                        AppState.canvas-workflow-artwork = @image-url("../../assets/free-canvas/character-age.png");
                        AppState.viewer-open-character-workflow(
                            "character-age",
                            AppState.en ? "Character Age Progression" : "角色年龄变化",
                            AppState.en
                                ? "Create exactly {count} consecutive age stages of the reference character from infancy to old age, distributed evenly across the lifespan. Preserve identity cues, outfit theme, palette, and art style while changing face, height, body proportions, and posture appropriately. Arrange all {count} full characters evenly in one horizontal character sheet."
                                : "根据参考角色生成从婴儿到老年的{count}个连续年龄阶段，并按所选数量均匀分布人生阶段。保持角色身份特征、服装主题、配色和绘制风格连贯，让面部、身高、体型和姿态符合年龄变化。将{count}个完整角色均匀排列在同一张横向设定图中。",
                            AppState.en
                                ? "Describe the character cue, e.g. blue-robed mage, keep the blue magic"
                                : "简单描述角色特征，例如：蓝袍法师，始终保留蓝色魔法"
                        );
                    }
                }
                if AppState.viewer-category == "character": ViewerContextMenuItem {
                    text: AppState.en ? "Character Outfit Swap" : "角色换装";
                    clicked => {
                        root.context-menu-open = false;
                        AppState.canvas-workflow-artwork = @image-url("../../assets/free-canvas/character-outfit.png");
                        AppState.viewer-open-character-workflow(
                            "character-outfit",
                            AppState.en ? "Character Outfit Swap" : "角色换装",
                            AppState.en
                                ? "Create exactly {count} outfit variations for the reference character. Preserve identity, face, hair, body shape, pose, camera, and rendering style; change only clothing, footwear, and accessories. Arrange all {count} full-body designs evenly in one clean horizontal character sheet."
                                : "根据参考角色生成{count}套不同服装造型。保持角色身份、面部、发型、体型、姿势、视角和绘制风格一致，只改变服装、鞋履和配饰。将{count}套完整造型均匀排列在同一张横向角色设定图中，背景干净。",
                            AppState.en
                                ? "Describe the character and outfit direction, e.g. swordswoman, formal and battle outfits"
                                : "简单描述角色和换装方向，例如：女剑士，礼服与战斗服"
                        );
                    }
                }
                if AppState.viewer-category == "character": ViewerContextMenuItem {
                    text: AppState.en ? "Character Body Variations" : "角色体型修改";
                    clicked => {
                        root.context-menu-open = false;
                        AppState.canvas-workflow-artwork = @image-url("../../assets/free-canvas/character-body.png");
                        AppState.viewer-open-character-workflow(
                            "character-body",
                            AppState.en ? "Character Body Variations" : "角色体型修改器",
                            AppState.en
                                ? "Create exactly {count} clearly different body-shape variations of the reference character in a deliberate progression. Preserve identity, face, hair, outfit theme, weapon, and art style; change only height, shoulder width, muscle mass, body-fat distribution, and silhouette. Arrange all {count} full characters evenly in one horizontal character sheet."
                                : "根据参考角色生成{count}种明显不同且变化有序的体型。保持角色身份、面部、发型、服装主题、武器和绘制风格一致，只改变身高、肩宽、肌肉量、脂肪比例和身体轮廓。将{count}个完整角色均匀排列在同一张横向设定图中。",
                            AppState.en
                                ? "Describe the character cue, e.g. green orc warrior, lean to massive"
                                : "简单描述角色特征，例如：绿色兽人战士，从瘦小到魁梧"
                        );
                    }
                }
                ViewerContextMenuItem {
                    text: AppState.en ? "Open Folder" : "打开文件夹位置";
                    clicked => {
                        root.context-menu-open = false;
                        AppState.viewer-download-image();
                    }
                }
                ViewerContextMenuItem {
                    text: AppState.en ? "Copy" : "复制";
                    clicked => {
                        root.context-menu-open = false;
                        AppState.viewer-copy-image();
                    }
                }
                ViewerContextMenuItem {
                    text: AppState.en ? "Use as Ref" : "用作参考图";
                    clicked => {
                        root.context-menu-open = false;
                        AppState.viewer-use-reference();
                    }
                }
                ViewerContextMenuItem {
                    text: AppState.en ? "Import to Canvas" : "导入无限画布";
                    clicked => {
                        root.context-menu-open = false;
                        AppState.viewer-import-to-canvas();
                    }
                }
                ViewerContextMenuItem {
                    text: AppState.en ? "Delete" : "删除";
                    danger: true;
                    clicked => {
                        root.context-menu-open = false;
                        AppState.request-delete-asset(AppState.viewer-id);
                    }
                }
            }
        }
    }
}
