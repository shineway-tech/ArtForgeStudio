import { AppState } from "../app-state.slint";
import { PillButton } from "../components/pill-button.slint";
import { AppTheme } from "../theme.slint";

export component CloseBehaviorDialog {
    if AppState.close-choice-open: Rectangle {
        background: #00000066;
        TouchArea { width: parent.width; height: parent.height; }

        dialog := Rectangle {
            width: min(460px, root.width - 32px);
            height: min(238px, root.height - 40px);
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            background: AppTheme.panel;
            border-radius: 16px;
            border-width: 1px;
            border-color: AppTheme.border;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000044;
            drop-shadow-offset-y: 10px;

            Text {
                x: 24px;
                y: 24px;
                width: parent.width - 48px;
                text: AppState.en ? "Close or minimize Elunvi Canvas?" : "关闭程序还是最小化程序？";
                color: AppTheme.text;
                font-size: 19px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                x: 28px;
                y: 62px;
                width: parent.width - 56px;
                height: 52px;
                text: AppState.en
                    ? "Closing ends the application. Minimizing keeps it running in the system tray."
                    : "关闭程序将结束运行；最小化程序将在系统托盘继续运行。";
                color: AppTheme.muted;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            HorizontalLayout {
                x: 24px;
                y: 142px;
                width: parent.width - 48px;
                height: 48px;
                spacing: 12px;
                PillButton {
                    horizontal-stretch: 1;
                    text: AppState.en ? "Close application" : "关闭程序";
                    danger: true;
                    clicked => { AppState.confirm-close-behavior("exit"); }
                }
                PillButton {
                    horizontal-stretch: 1;
                    text: AppState.en ? "Minimize application" : "最小化程序";
                    primary: true;
                    clicked => { AppState.confirm-close-behavior("tray"); }
                }
            }
            Text {
                x: 24px;
                y: 202px;
                width: parent.width - 48px;
                text: AppState.en ? "Your first choice will be remembered and can be changed in Settings." : "首次选择会被记住，也可以随时在设置中修改。";
                color: AppTheme.weak;
                font-size: 11px;
                horizontal-alignment: center;
            }
        }
    }
}
