import { AppState } from "../app-state.slint";
import { ContactItem } from "../components/contact-item.slint";
import { AppTheme } from "../theme.slint";

export component ContactPopup inherits Rectangle {
    background: AppTheme.panel;
    border-radius: 18px;
    border-width: 1px;
    border-color: AppTheme.accent.with-alpha(0.62);
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000055;
    drop-shadow-offset-y: 8px;

    Text {
        x: 22px;
        y: 20px;
        width: parent.width - 122px;
        height: 28px;
        text: AppState.en ? "Community & Support" : "官方群与客服";
        color: AppTheme.text;
        font-size: 19px;
        font-weight: 600;
        vertical-alignment: center;
    }
    Text {
        x: 22px;
        y: 50px;
        width: parent.width - 44px;
        height: 20px;
        text: AppState.en ? "Feedback / tutorials / community" : "问题反馈 / 教程交流";
        color: AppTheme.muted;
        font-size: 12px;
        font-weight: 400;
        vertical-alignment: center;
    }

    Rectangle {
        x: parent.width - 88px;
        y: 18px;
        width: 32px;
        height: 32px;
        border-radius: 10px;
        border-width: 1px;
        border-color: AppTheme.border;
        background: transparent;
        Text {
            text: "›";
            color: AppTheme.muted;
            font-size: 23px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: pointer;
            clicked => { AppState.open-contact-settings(); }
        }
    }
    Rectangle {
        x: parent.width - 46px;
        y: 18px;
        width: 32px;
        height: 32px;
        border-radius: 10px;
        border-width: 1px;
        border-color: AppTheme.border;
        background: transparent;
        Text {
            text: "×";
            color: AppTheme.muted;
            font-size: 18px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: pointer;
            clicked => { AppState.dismiss-contact-popup(); }
        }
    }

    ContactItem {
        x: 20px;
        y: 88px;
        width: parent.width - 40px;
        label: AppState.en ? "Official group" : "官方群";
        value: "1090665775";
        join-group: true;
    }
    ContactItem {
        x: 20px;
        y: 176px;
        width: parent.width - 40px;
        label: AppState.en ? "Customer service WeChat" : "客服微信";
        value: "dyx346";
    }
    ContactItem {
        x: 20px;
        y: 264px;
        width: parent.width - 40px;
        label: AppState.en ? "Customer service email" : "客服邮箱";
        value: "business@honeykid.cn";
    }

    Text {
        x: 20px;
        y: parent.height - 42px;
        width: parent.width - 40px;
        height: 22px;
        text: AppState.en
            ? "View again in Settings > Contact Us"
            : "可在“设置 > 联系我们”中再次查看";
        color: AppTheme.weak;
        font-size: 11px;
        font-weight: 400;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}
