import { AppState } from "../app-state.slint";
import { AssetGallery } from "../components/asset-gallery.slint";
import { CategoryTabs } from "../components/category-tabs.slint";
import { GalleryLayoutToggle } from "../components/gallery-layout-toggle.slint";
import { VideoGallery } from "../components/video-gallery.slint";
import { AppTheme } from "../theme.slint";

export component AssetsPage {
    function content-width() -> length {
        return root.width - 40px;
    }
    function content-x() -> length {
        return 20px;
    }
    function card-width() -> length {
        return 200px;
    }
    Rectangle {
        background: AppTheme.bg;
        Rectangle {
            x: root.content-x();
            y: 0px;
            width: root.content-width();
            height: parent.height;
            background: transparent;
            CategoryTabs {
                x: 0px;
                y: 20px;
                width: max(1px, parent.width - 128px);
                height: 64px;
                for-assets: true;
            }
            if AppState.asset-category-filter != "video": GalleryLayoutToggle {
                x: parent.width - 112px;
                y: 20px;
                mode <=> AppState.asset-gallery-layout;
                preference-key: "assets";
            }
            if AppState.asset-category-filter == "video": VideoGallery {
                x: 0px;
                y: 116px;
                width: parent.width;
                height: parent.height - 116px;
                group-by-date: true;
            }
            if AppState.asset-category-filter != "video": AssetGallery {
                x: 0px;
                y: 116px;
                width: parent.width;
                height: parent.height - 116px;
                items: AppState.assets;
                groups: AppState.asset-groups;
                placements: AppState.asset-layout-items;
                headers: AppState.asset-layout-headers;
                content-height: AppState.asset-layout-height;
                source: "asset";
                card-width: root.card-width();
                layout-mode: AppState.asset-gallery-layout;
                has-more: AppState.asset-has-more;
                pagination-key: AppState.asset-category-filter;
                request-more => { AppState.load-more-assets(); }
            }
        }
    }
}
