import { GenerationResultPanel } from "../components/generation-result-panel.slint";
import { PromptHistoryPreview } from "../components/prompt-history-preview.slint";
import { StudioWorkPanel } from "../components/studio-work-panel.slint";
import { AppTheme } from "../theme.slint";

export component StudioSplitPage {
    in property <bool> generation: false;
    Rectangle {
        background: AppTheme.bg;
        work-panel := StudioWorkPanel {
            x: 0px;
            y: 0px;
            width: 540px;
            height: parent.height;
            generation: root.generation;
        }
        Rectangle { x: 540px; y: 0px; width: 1px; height: parent.height; background: AppTheme.border; }
        GenerationResultPanel {
            x: 541px;
            y: 0px;
            width: parent.width - 541px;
            height: parent.height;
        }
        history-preview := PromptHistoryPreview {
            visible: work-panel.prompt-history-preview-open;
            x: work-panel.x + work-panel.prompt-history-preview-x;
            y: work-panel.y + work-panel.prompt-history-preview-y;
            width: 420px;
            height: 300px;
            prompt: work-panel.prompt-history-preview-text;
        }
    }
}
