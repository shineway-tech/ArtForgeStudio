import { AppState } from "../app-state.slint";
import { PillButton } from "../components/pill-button.slint";
import { AppTheme } from "../theme.slint";

export component InvitationGiftPage {
    Rectangle {
        width: root.width;
        height: root.height;
        background: AppTheme.bg;

        Rectangle {
            x: 48px;
            y: 34px;
            width: parent.width - 96px;
            height: parent.height - 68px;
            background: transparent;

            Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 46px;
                text: AppState.en ? "Invitation Rewards" : "邀请有礼";
                color: AppTheme.text;
                font-size: 28px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                x: 0px;
                y: 50px;
                width: parent.width;
                height: 28px;
                text: AppState.en
                    ? "Enter an invitation code to join the invitation rewards program"
                    : "填写邀请码，参与邀请有礼活动";
                color: AppTheme.muted;
                font-size: 14px;
                vertical-alignment: center;
            }

            hero := Rectangle {
                x: 0px;
                y: 104px;
                width: parent.width;
                height: min(260px, parent.height * 0.38);
                background: AppTheme.panel-soft;
                border-radius: 18px;
                border-width: 1px;
                border-color: AppTheme.border;
                clip: true;

                Rectangle {
                    x: 34px;
                    y: 34px;
                    width: parent.width - 300px;
                    height: parent.height - 68px;
                    background: transparent;
                    Text {
                        x: 0px;
                        y: 4px;
                        width: parent.width;
                        height: 38px;
                        text: AppState.en ? "A gift for every connection" : "每一次邀请，都值得一份好礼";
                        color: AppTheme.text;
                        font-size: 22px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 0px;
                        y: 50px;
                        width: parent.width;
                        height: 56px;
                        text: AppState.en
                            ? "Reward details and invitation records are provided by the server and will appear here when available."
                            : "奖励规则与邀请记录由服务端统一返回，开放后将在这里展示。";
                        color: AppTheme.muted;
                        font-size: 14px;
                        wrap: word-wrap;
                        vertical-alignment: top;
                    }
                }
                Image {
                    x: parent.width - 246px;
                    y: (parent.height - 220px) / 2;
                    width: 220px;
                    height: 220px;
                    source: @image-url("../../assets/invitation-gift.png");
                    image-fit: contain;
                }
            }

            form-card := Rectangle {
                x: 0px;
                y: hero.y + hero.height + 22px;
                width: min(720px, parent.width);
                height: 220px;
                background: AppTheme.panel;
                border-radius: 14px;
                border-width: 1px;
                border-color: AppTheme.border;
                Text {
                    x: 24px;
                    y: 20px;
                    width: parent.width - 48px;
                    height: 32px;
                    text: AppState.en ? "Enter invitation code" : "填写邀请码";
                    color: AppTheme.text;
                    font-size: 18px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Text {
                    x: 24px;
                    y: 54px;
                    width: parent.width - 48px;
                    height: 24px;
                    text: AppState.en ? "The code will be validated by the server after confirmation" : "点击确认后，将由服务端判断邀请码是否正确";
                    color: AppTheme.muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                Rectangle {
                    x: 24px;
                    y: 94px;
                    width: parent.width - 196px;
                    height: 48px;
                    background: AppTheme.panel-soft;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: page-invitation-input.has-focus ? AppTheme.accent : AppTheme.border;
                    page-invitation-input := TextInput {
                        x: 16px;
                        width: parent.width - 32px;
                        height: parent.height;
                        text <=> AppState.invitation-code;
                        single-line: true;
                        color: AppTheme.text;
                        font-size: 14px;
                        vertical-alignment: center;
                        accepted => { AppState.submit-invitation-code(); }
                    }
                    if AppState.invitation-code == "" && !page-invitation-input.has-focus: Text {
                        x: 16px;
                        width: parent.width - 32px;
                        height: parent.height;
                        text: AppState.en ? "Enter invitation code" : "请填写邀请码";
                        color: AppTheme.weak;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                }
                PillButton {
                    x: parent.width - 156px;
                    y: 98px;
                    width: 132px;
                    height: 40px;
                    primary: true;
                    disabled: AppState.invitation-code-busy;
                    text: AppState.invitation-code-busy
                        ? (AppState.en ? "Validating..." : "验证中...")
                        : (AppState.en ? "Confirm" : "确认");
                    clicked => { AppState.submit-invitation-code(); }
                }
                Text {
                    x: 24px;
                    y: 154px;
                    width: parent.width - 48px;
                    height: 46px;
                    text: AppState.invitation-code-status;
                    color: AppState.invitation-code-success ? AppTheme.success : AppTheme.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                    vertical-alignment: top;
                }
            }
        }
    }
}
