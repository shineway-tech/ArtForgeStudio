import { ScrollView } from "std-widgets.slint";
import { AppState } from "../app-state.slint";
import { PillButton } from "../components/pill-button.slint";
import { AppTheme } from "../theme.slint";
import { InvitedUserView } from "../types.slint";

component RewardSummaryCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> suffix;
    in property <string> note;
    in property <bool> highlighted: false;

    background: AppTheme.panel;
    border-radius: 14px;
    border-width: 1px;
    border-color: AppTheme.border;

    Text {
        x: 20px;
        y: 16px;
        width: parent.width - 40px;
        height: 22px;
        text: root.title;
        color: AppTheme.muted;
        font-size: 13px;
        font-weight: 400;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 20px;
        y: 43px;
        width: parent.width - 40px;
        height: 36px;
        text: root.value + root.suffix;
        color: root.highlighted ? AppTheme.accent-dark : AppTheme.text;
        font-size: 24px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.note != "": Text {
        x: 20px;
        y: 84px;
        width: parent.width - 40px;
        height: 20px;
        text: root.note;
        color: AppTheme.weak;
        font-size: 11px;
        font-weight: 400;
        vertical-alignment: center;
        overflow: elide;
    }
}

component InvitationCopyField {
    in property <string> label;
    in property <string> value;
    in property <string> empty-value;
    in property <string> button-text;

    Text {
        width: parent.width;
        height: 22px;
        text: root.label;
        color: AppTheme.text;
        font-size: 12px;
        font-weight: 400;
        vertical-alignment: center;
    }
    Rectangle {
        y: 28px;
        width: parent.width;
        height: 48px;
        background: AppTheme.panel-soft;
        border-radius: 9px;
        border-width: 1px;
        border-color: AppTheme.border;

        Text {
            x: 14px;
            width: parent.width - 142px;
            height: parent.height;
            text: root.value == "" ? root.empty-value : root.value;
            color: root.value == "" ? AppTheme.weak : AppTheme.text;
            font-size: 12px;
            font-weight: 400;
            vertical-alignment: center;
            overflow: elide;
        }
        PillButton {
            x: parent.width - 118px;
            y: 7px;
            width: 106px;
            height: 34px;
            label-font-size: 12px;
            disabled: root.value == "";
            text: root.button-text;
            clicked => { AppState.copy-contact-detail(root.value); }
        }
    }
}

component InvitedUserRow inherits Rectangle {
    in property <InvitedUserView> item;

    height: 52px;
    background: transparent;

    Text {
        x: 16px;
        width: (parent.width - 32px) * 0.30;
        height: parent.height;
        text: root.item.email;
        color: AppTheme.text;
        font-size: 12px;
        font-weight: 400;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 16px + (parent.width - 32px) * 0.30;
        width: (parent.width - 32px) * 0.28;
        height: parent.height;
        text: root.item.username == "" ? "-" : root.item.username;
        color: AppTheme.text;
        font-size: 12px;
        font-weight: 400;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 16px + (parent.width - 32px) * 0.58;
        width: (parent.width - 32px) * 0.18;
        height: parent.height;
        text: root.item.reward-detail;
        color: AppTheme.success;
        font-size: 12px;
        font-weight: 400;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 16px + (parent.width - 32px) * 0.76;
        width: (parent.width - 32px) * 0.24;
        height: parent.height;
        text: root.item.registered-at;
        color: AppTheme.muted;
        font-size: 12px;
        font-weight: 400;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: AppTheme.border;
    }
}

export component InvitationGiftPage {
    function invited-list-height() -> length {
        return max(1, AppState.invitation-users.length) * 52px;
    }
    function content-height() -> length {
        return max(root.height, 720px + root.invited-list-height());
    }

    Rectangle {
        width: root.width;
        height: root.height;
        background: AppTheme.bg;

        ScrollView {
            width: parent.width;
            height: parent.height;
            viewport-width: parent.width;
            viewport-height: root.content-height();

            content := Rectangle {
                x: 24px;
                y: 22px;
                width: parent.width - 48px;
                height: root.content-height() - 44px;
                background: transparent;

                Text {
                    width: parent.width;
                    height: 36px;
                    text: AppState.en ? "Invitation Rewards" : "邀请有礼";
                    color: AppTheme.text;
                    font-size: 24px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Text {
                    y: 38px;
                    width: parent.width;
                    height: 24px;
                    text: AppState.en ? "Invite friends and enjoy rewards together" : "邀请好友，共享专属奖励";
                    color: AppTheme.muted;
                    font-size: 13px;
                    font-weight: 400;
                    vertical-alignment: center;
                }

                summary := Rectangle {
                    y: 82px;
                    width: parent.width;
                    height: 122px;
                    background: transparent;

                    RewardSummaryCard {
                        width: (parent.width - 32px) / 3;
                        height: parent.height;
                        title: AppState.en ? "My reward rate" : "我的返利比例";
                        value: AppState.invitation-reward-rate;
                        suffix: "%";
                        note: AppState.en ? "Current promotional rate" : "当前暂定返利比例";
                        highlighted: true;
                    }
                    RewardSummaryCard {
                        x: (parent.width - 32px) / 3 + 16px;
                        width: (parent.width - 32px) / 3;
                        height: parent.height;
                        title: AppState.en ? "Invited users" : "邀请人数";
                        value: AppState.invitation-count;
                        suffix: "";
                        note: "";
                    }
                    RewardSummaryCard {
                        x: ((parent.width - 32px) / 3 + 16px) * 2;
                        width: (parent.width - 32px) / 3;
                        height: parent.height;
                        title: AppState.en ? "Historical rewards" : "历史返利额度";
                        value: AppState.invitation-history-reward;
                        suffix: "";
                        note: "";
                    }
                }

                invitation-card := Rectangle {
                    y: 226px;
                    width: parent.width;
                    height: 288px;
                    background: AppTheme.panel;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    Text {
                        x: 24px;
                        y: 18px;
                        width: parent.width - 48px;
                        height: 30px;
                        text: AppState.en ? "Invitation rewards" : "邀请返利";
                        color: AppTheme.text;
                        font-size: 17px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 24px;
                        y: 48px;
                        width: parent.width - 48px;
                        height: 22px;
                        text: AppState.en ? "Share your invitation code with new users" : "将邀请码分享给新用户";
                        color: AppTheme.muted;
                        font-size: 12px;
                        font-weight: 400;
                        vertical-alignment: center;
                    }

                    InvitationCopyField {
                        x: 24px;
                        y: 82px;
                        width: parent.width - 48px;
                        height: 76px;
                        label: AppState.en ? "My invitation code" : "我的邀请码";
                        value: AppState.invitation-own-code;
                        empty-value: AppState.en ? "Not available yet" : "待服务端开放";
                        button-text: AppState.en ? "Copy code" : "复制邀请码";
                    }

                    Rectangle {
                        x: 24px;
                        y: 178px;
                        width: parent.width - 48px;
                        height: 86px;
                        background: AppTheme.panel-soft;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: AppTheme.accent;

                        Text {
                            x: 16px;
                            y: 10px;
                            width: parent.width - 32px;
                            height: 20px;
                            text: AppState.en ? "How it works" : "使用说明";
                            color: AppTheme.accent-dark;
                            font-size: 13px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                        Text {
                            x: 16px;
                            y: 34px;
                            width: parent.width - 32px;
                            height: 44px;
                            text: AppState.en
                                ? "1. Share your invitation code with a new user.\n2. The current reward rate is 10%; settlement rules are subject to the server."
                                : "1. 将邀请码分享给新用户。\n2. 当前返利比例暂定为 10%，结算规则以服务端实际规则为准。";
                            color: AppTheme.muted;
                            font-size: 12px;
                            font-weight: 400;
                            wrap: word-wrap;
                            vertical-alignment: top;
                        }
                    }
                }

                invited-card := Rectangle {
                    y: 536px;
                    width: parent.width;
                    height: 108px + root.invited-list-height();
                    background: AppTheme.panel;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    Text {
                        x: 24px;
                        y: 16px;
                        width: parent.width - 48px;
                        height: 28px;
                        text: AppState.en ? "Invited users" : "已邀请用户";
                        color: AppTheme.text;
                        font-size: 15px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    header := Rectangle {
                        x: 24px;
                        y: 54px;
                        width: parent.width - 48px;
                        height: 36px;
                        background: transparent;

                        Text { x: 16px; width: (parent.width - 32px) * 0.30; height: parent.height; text: AppState.en ? "Email" : "邮箱"; color: AppTheme.muted; font-size: 12px; font-weight: 400; vertical-alignment: center; }
                        Text { x: 16px + (parent.width - 32px) * 0.30; width: (parent.width - 32px) * 0.28; height: parent.height; text: AppState.en ? "Username" : "用户名"; color: AppTheme.muted; font-size: 12px; font-weight: 400; vertical-alignment: center; }
                        Text { x: 16px + (parent.width - 32px) * 0.58; width: (parent.width - 32px) * 0.18; height: parent.height; text: AppState.en ? "Reward" : "返利明细"; color: AppTheme.muted; font-size: 12px; font-weight: 400; vertical-alignment: center; }
                        Text { x: 16px + (parent.width - 32px) * 0.76; width: (parent.width - 32px) * 0.24; height: parent.height; text: AppState.en ? "Registered at" : "注册时间"; color: AppTheme.muted; font-size: 12px; font-weight: 400; vertical-alignment: center; }
                        Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: AppTheme.border; }
                    }

                    if AppState.invitation-users.length == 0: Text {
                        x: 24px;
                        y: 90px;
                        width: parent.width - 48px;
                        height: 52px;
                        text: AppState.en ? "No invited users yet" : "暂无已邀请用户";
                        color: AppTheme.weak;
                        font-size: 12px;
                        font-weight: 400;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if AppState.invitation-users.length > 0: VerticalLayout {
                        x: 24px;
                        y: 90px;
                        width: parent.width - 48px;
                        height: root.invited-list-height();
                        spacing: 0px;
                        for user in AppState.invitation-users: InvitedUserRow {
                            item: user;
                        }
                    }
                }
            }
        }
    }
}
