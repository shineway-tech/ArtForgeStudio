import { AppState } from "../app-state.slint";
import { AppTheme } from "../theme.slint";
import { PillButton } from "../components/pill-button.slint";

component PreviewPanel {
    in property <string> title;
    in property <string> detail;
    in property <image> preview;
    in property <bool> has-image: false;
    in property <bool> processing: false;
    in property <int> progress: 0;
    in property <bool> result-panel: false;
    in property <bool> drop-enabled: false;
    callback choose-image();
    callback dropped(data-transfer) -> bool;

    Rectangle {
        background: transparent;

        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 28px;
            text: root.processing
                ? (AppState.en ? "Removing watermark (" + root.progress + "%)..." : "去水印中(" + root.progress + "%)...")
                : root.title;
            color: AppTheme.text;
            font-size: 16px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            x: 0px;
            y: 30px;
            width: parent.width;
            height: 20px;
            text: root.detail;
            color: AppTheme.muted;
            font-size: 12px;
            font-weight: 400;
            vertical-alignment: center;
            overflow: elide;
        }

        preview-frame := Rectangle {
            x: 0px;
            y: 62px;
            width: parent.width;
            height: parent.height - 62px;
            background: source-drop.has-drag
                ? AppTheme.accent.with-alpha(0.08)
                : AppTheme.panel;
            border-radius: 12px;
            border-width: source-drop.has-drag ? 2px : 1px;
            border-color: source-drop.has-drag || root.processing
                ? AppTheme.accent
                : AppTheme.border;
            clip: true;

            if root.has-image: Image {
                x: 12px;
                y: 12px;
                width: parent.width - 24px;
                height: parent.height - 24px;
                source: root.preview;
                image-fit: contain;
            }

            if !root.has-image: Rectangle {
                background: transparent;

                Rectangle {
                    x: (parent.width - 58px) / 2;
                    y: (parent.height - 108px) / 2;
                    width: 58px;
                    height: 58px;
                    border-radius: 14px;
                    background: AppTheme.panel-soft;
                    Image {
                        x: 16px;
                        y: 16px;
                        width: 26px;
                        height: 26px;
                        source: root.result-panel
                            ? @image-url("../../assets/icons/image.svg")
                            : @image-url("../../assets/icons/upload.svg");
                        colorize: AppTheme.muted;
                        image-fit: contain;
                    }
                }

                Text {
                    x: 24px;
                    y: (parent.height - 108px) / 2 + 72px;
                    width: parent.width - 48px;
                    height: 24px;
                    text: source-drop.has-drag
                        ? (AppState.en ? "Release to upload image" : "松开即可上传图片")
                        : root.result-panel
                        ? (AppState.en ? "The processed image will appear here" : "处理后的图片将显示在这里")
                        : (AppState.en ? "Drag an image here, or click to upload" : "拖放图片到这里，或点击上传");
                    color: source-drop.has-drag ? AppTheme.accent : AppTheme.muted;
                    font-size: 13px;
                    font-weight: 400;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if !root.result-panel: TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => { root.choose-image(); }
                }
            }

            if root.processing: Rectangle {
                x: 0px;
                y: parent.height - 4px;
                width: parent.width * root.progress / 100;
                height: 4px;
                background: AppTheme.accent;
            }

            if source-drop.has-drag && root.has-image: Rectangle {
                background: AppTheme.accent.with-alpha(0.12);

                Rectangle {
                    x: (parent.width - 220px) / 2;
                    y: (parent.height - 48px) / 2;
                    width: 220px;
                    height: 48px;
                    border-radius: 12px;
                    background: AppTheme.panel;
                    border-width: 1px;
                    border-color: AppTheme.accent;

                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: AppState.en ? "Release to replace image" : "松开即可更换图片";
                        color: AppTheme.accent;
                        font-size: 14px;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            source-drop := DropArea {
                width: parent.width;
                height: parent.height;
                can-drop(event) => {
                    return root.drop-enabled ? DragAction.copy : DragAction.none;
                }
                dropped(event) => {
                    return root.dropped(event.data) ? DragAction.copy : DragAction.none;
                }
            }
        }
    }
}

export component ToolboxWatermarkPage {
    in property <bool> remove-black-mode: false;
    function panel-gap() -> length {
        return 20px;
    }

    function panel-width() -> length {
        return (root.width - 64px - root.panel-gap()) / 2;
    }

    Rectangle {
        background: AppTheme.bg;

        Text {
            x: 32px;
            y: 28px;
            width: parent.width - 64px;
            height: 32px;
            text: root.remove-black-mode
                ? (AppState.en ? "Remove Black" : "去黑")
                : (AppState.en ? "Remove Watermark" : "去水印");
            color: AppTheme.text;
            font-size: 24px;
            font-weight: 600;
            vertical-alignment: center;
        }

        source-panel := PreviewPanel {
            x: 32px;
            y: 76px;
            width: root.panel-width();
            height: parent.height - 182px;
            title: AppState.en ? "Original" : "原图";
            detail: AppState.watermark-source-name;
            preview: AppState.watermark-source-image;
            has-image: AppState.watermark-source-path != "";
            drop-enabled: !AppState.watermark-processing;
            choose-image => { AppState.choose-watermark-source(); }
            dropped(data) => {
                return AppState.add-watermark-source-from-drag(data);
            }
        }

        result-panel := PreviewPanel {
            x: 32px + root.panel-width() + root.panel-gap();
            y: 76px;
            width: root.panel-width();
            height: parent.height - 182px;
            title: AppState.watermark-result-path != ""
                ? (root.remove-black-mode
                    ? (AppState.en ? "Transparent result" : "透明背景结果")
                    : (AppState.en ? "Processed image" : "去水印结果"))
                : (AppState.en ? "Waiting for processing" : "等待处理");
            detail: AppState.watermark-result-name;
            preview: AppState.watermark-result-image;
            has-image: AppState.watermark-result-path != "";
            processing: AppState.watermark-processing;
            progress: AppState.watermark-progress;
            result-panel: true;
        }

        if AppState.watermark-source-path != "": PillButton {
            x: 32px + root.panel-width() - 304px;
            y: parent.height - 78px;
            width: 126px;
            height: 42px;
            text: AppState.en ? "Change image" : "更换图片";
            disabled: AppState.watermark-processing;
            clicked => { AppState.choose-watermark-source(); }
        }

        PillButton {
            x: 32px + root.panel-width() - 166px;
            y: parent.height - 78px;
            width: 166px;
            height: 42px;
            text: AppState.watermark-processing
                ? (AppState.en ? "Processing..." : "处理中...")
                : root.remove-black-mode
                    ? (AppState.en ? "Remove black" : "去黑")
                    : (AppState.en ? "Remove watermark" : "去水印");
            primary: true;
            disabled: AppState.watermark-source-path == "" || AppState.watermark-processing;
            clicked => {
                if root.remove-black-mode {
                    AppState.start-remove-black-tool();
                } else {
                    AppState.start-watermark-removal();
                }
            }
        }

        if !root.remove-black-mode: Text {
            x: 32px + root.panel-width() - 166px;
            y: parent.height - 33px;
            width: 166px;
            height: 20px;
            text: AppState.en
                ? "Estimated charge: " + AppState.watermark-estimated-credits + " credits"
                : "本次预计扣除 " + AppState.watermark-estimated-credits + " 积分";
            color: AppTheme.muted;
            font-size: 10px;
            font-weight: 400;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        PillButton {
            x: parent.width - 174px;
            y: parent.height - 78px;
            width: 142px;
            height: 42px;
            text: AppState.en ? "View image" : "查看图片";
            disabled: AppState.watermark-result-path == "";
            clicked => { AppState.reveal-watermark-result(); }
        }

        if AppState.watermark-message != "": Text {
            x: 32px;
            y: parent.height - 69px;
            width: root.panel-width() - 182px;
            height: 24px;
            text: AppState.watermark-message;
            color: AppTheme.muted;
            font-size: 12px;
            font-weight: 400;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
