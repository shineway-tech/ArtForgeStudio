import { AppState } from "../app-state.slint";
import { CategoryTabs } from "../components/category-tabs.slint";
import { EmptyState } from "../components/empty-state.slint";
import { GalleryLayoutToggle } from "../components/gallery-layout-toggle.slint";
import { VirtualizedGallery } from "../components/virtualized-gallery.slint";
import { AppTheme } from "../theme.slint";

export component InspirationPage {
    property <string> pagination-key: AppState.inspiration-category-filter;
    property <bool> load-more-armed: true;
    property <length> last-load-bottom: -10000px;
    property <string> viewport-key: root.pagination-key + ":" + AppState.inspiration-gallery-layout;
    changed pagination-key => { root.reset-pagination-latch(); }
    init => { root.update-viewport(); }
    changed viewport-key => { root.update-viewport(); }
    changed width => { root.update-viewport(); }
    changed height => { root.update-viewport(); }
    function content-width() -> length {
        return root.width - 40px;
    }
    function content-x() -> length {
        return 20px;
    }
    function card-width() -> length {
        return 200px;
    }
    function gallery-y() -> length {
        return 124px;
    }
    function gallery-top-gap() -> length {
        return 18px;
    }
    Rectangle {
        background: AppTheme.bg;
        Rectangle {
            y: root.gallery-y();
            width: parent.width;
            height: max(0px, parent.height - root.gallery-y());
            clip: true;
            background: transparent;
            inspiration-scroll := Flickable {
                width: parent.width;
                height: parent.height;
                viewport-width: parent.width;
                viewport-height: max(self.height, gallery-content.preferred-height);
                interactive: true;
                changed viewport-y => { root.maybe-load-more(); root.update-viewport(); }
                changed viewport-height => { root.maybe-load-more(); root.update-viewport(); }
                gallery-content := VerticalLayout {
                    x: root.content-x();
                    width: root.content-width();
                    height: self.preferred-height;
                    spacing: 0px;
                    Rectangle { height: root.gallery-top-gap(); background: transparent; }
                    if root.is-empty(): EmptyState {
                        width: root.content-width();
                        height: max(360px, root.height - 106px);
                    }
                    if !root.is-empty(): VirtualizedGallery {
                        width: root.content-width();
                        items: AppState.inspiration;
                        placements: AppState.inspiration-layout-items;
                        headers: AppState.inspiration-layout-headers;
                        content-height: AppState.inspiration-layout-height;
                        source: "inspiration";
                    }
                    Rectangle { height: 32px; background: transparent; }
                }
            }
        }
        Rectangle {
            y: 0px;
            width: parent.width;
            height: root.gallery-y();
            background: AppTheme.bg;
        }
        CategoryTabs {
            x: root.content-x();
            y: 14px;
            width: max(1px, root.content-width() - 128px);
            for-assets: false;
        }
        GalleryLayoutToggle {
            x: root.content-x() + root.content-width() - 112px;
            y: 14px;
            mode <=> AppState.inspiration-gallery-layout;
            preference-key: "inspiration";
        }
    }
    function is-empty() -> bool {
        return AppState.inspiration.length == 0;
    }
    function column-count() -> int {
        return max(1, min(AppState.inspiration.length, min(8, floor((root.content-width() + 18px) / (root.card-width() + 18px)))));
    }
    function item-width() -> length {
        return min(root.card-width(), max(139px, (root.content-width() - (root.column-count() - 1) * 18px) / root.column-count()));
    }
    function row-height() -> length {
        return root.item-width() + 48px;
    }
    function row-count() -> int {
        return (AppState.inspiration.length + root.column-count() - 1) / root.column-count();
    }
    function maybe-load-more() {
        let visible-bottom = -inspiration-scroll.viewport-y + inspiration-scroll.height;
        let near-end = visible-bottom + 640px >= inspiration-scroll.viewport-height;
        if !AppState.inspiration-has-more || !near-end {
            root.load-more-armed = true;
            return;
        }
        if !root.load-more-armed && visible-bottom >= root.last-load-bottom + 240px {
            root.load-more-armed = true;
        }
        if root.load-more-armed {
            root.load-more-armed = false;
            root.last-load-bottom = visible-bottom;
            AppState.load-more-inspiration();
        }
    }
    function reset-pagination-latch() {
        root.load-more-armed = true;
        root.last-load-bottom = -10000px;
    }
    function update-viewport() {
        AppState.update-gallery-viewport(
            "inspiration",
            max(0, -inspiration-scroll.viewport-y / 1px),
            max(1, inspiration-scroll.height / 1px),
            max(1, root.content-width() / 1px),
            AppState.inspiration-gallery-layout,
            max(1, root.card-width() / 1px),
            0
        );
    }
}
