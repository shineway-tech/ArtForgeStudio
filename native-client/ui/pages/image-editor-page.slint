import { AppState } from "../app-state.slint";
import { PillButton } from "../components/pill-button.slint";
import { AppTheme } from "../theme.slint";

export component ImageEditorPage inherits Rectangle {
    property <[string]> edit-qualities: ["1K", "2K", "4K"];
    property <[color]> brush-palette: [
        #ff4d4f,
        #ff9f43,
        #ffd43b,
        #42d79e,
        #24b8ff,
        #6c5ce7,
        #111827,
        #ffffff,
    ];

    function source-aspect() -> float {
        return AppState.image-editor-source-width > 0 && AppState.image-editor-source-height > 0
            ? AppState.image-editor-source-width / AppState.image-editor-source-height
            : 1;
    }

    function fitted-image-width() -> length {
        return min(editor-stage.width - 40px, (editor-stage.height - 40px) * root.source-aspect());
    }

    function fitted-image-height() -> length {
        return root.fitted-image-width() / root.source-aspect();
    }

    background: AppTheme.bg;

    Rectangle {
        x: 28px;
        y: 16px;
        width: parent.width - 56px;
        height: 44px;
        background: transparent;

        PillButton {
            x: 0px;
            width: 88px;
            height: 40px;
            text: AppState.en ? "Close" : "关闭";
            clicked => { AppState.close-image-editor(); }
        }

        Text {
            x: 112px;
            width: parent.width - 224px;
            height: 40px;
            text: AppState.en ? "Image Editor" : "图片编辑";
            color: AppTheme.text;
            font-size: 22px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    workspace := Rectangle {
        x: 28px;
        y: 72px;
        width: parent.width - 56px;
        height: parent.height - 90px;
        background: transparent;

        editor-stage := Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width - 340px;
            height: parent.height - 112px;
            background: AppTheme.panel-soft;
            border-radius: 12px;
            border-width: 1px;
            border-color: AppTheme.border;
            clip: true;

            image-frame := Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: root.fitted-image-width();
                height: root.fitted-image-height();
                background: #090d16;
                border-radius: 6px;
                clip: true;

                Image {
                    width: parent.width;
                    height: parent.height;
                    source: AppState.image-editor-image;
                    image-fit: fill;
                }

                for point in AppState.image-editor-points: Rectangle {
                    x: point.x * image-frame.width - self.width / 2;
                    y: point.y * image-frame.height - self.height / 2;
                    width: point.size * image-frame.width;
                    height: self.width;
                    background: point.color.with-alpha(0.52);
                    border-radius: point.shape == "circle" ? self.width / 2 : 1px;
                }

                draw-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: none;
                    pointer-event(event) => {
                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                            AppState.image-editor-status = "";
                            AppState.begin-image-editor-stroke(
                                self.mouse-x / self.width,
                                self.mouse-y / self.height,
                                AppState.image-editor-brush-size / (self.width / 1px),
                                root.source-aspect(),
                                AppState.image-editor-brush-shape,
                                AppState.image-editor-brush-color
                            );
                        } else if event.button == PointerEventButton.left
                            && (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                            AppState.end-image-editor-stroke();
                        }
                    }
                    moved => {
                        if self.pressed {
                            AppState.continue-image-editor-stroke(
                                max(0, min(1, self.mouse-x / self.width)),
                                max(0, min(1, self.mouse-y / self.height)),
                                AppState.image-editor-brush-size / (self.width / 1px),
                                root.source-aspect(),
                                AppState.image-editor-brush-shape,
                                AppState.image-editor-brush-color
                            );
                        }
                    }
                }

                if draw-touch.has-hover: Rectangle {
                    x: max(-self.width / 2, min(image-frame.width - self.width / 2, draw-touch.mouse-x - self.width / 2));
                    y: max(-self.height / 2, min(image-frame.height - self.height / 2, draw-touch.mouse-y - self.height / 2));
                    width: AppState.image-editor-brush-size * 1px;
                    height: self.width;
                    background: AppState.image-editor-brush-color.with-alpha(0.18);
                    border-radius: AppState.image-editor-brush-shape == "circle" ? self.width / 2 : 1px;
                    border-width: 1px;
                    border-color: AppState.image-editor-brush-color;
                    z: 20;
                }
            }
        }

        brush-toolbar := Rectangle {
            x: (editor-stage.width - self.width) / 2;
            y: parent.height - 96px;
            width: min(760px, editor-stage.width);
            height: 84px;
            background: AppTheme.panel;
            border-radius: 12px;
            border-width: 1px;
            border-color: AppTheme.border;

            Text {
                x: 16px;
                y: 8px;
                width: 42px;
                height: 30px;
                text: AppState.en ? "Brush" : "笔刷";
                color: AppTheme.text;
                font-size: 13px;
                font-weight: 500;
                vertical-alignment: center;
            }

            circle-shape := Rectangle {
                x: 62px;
                y: 8px;
                width: 42px;
                height: 30px;
                background: AppState.image-editor-brush-shape == "circle" ? AppTheme.accent.with-alpha(0.13) : transparent;
                border-radius: 8px;
                border-width: 1px;
                border-color: AppState.image-editor-brush-shape == "circle" ? AppTheme.accent : AppTheme.border;

                Rectangle {
                    x: 14px;
                    y: 8px;
                    width: 14px;
                    height: 14px;
                    background: AppTheme.accent;
                    border-radius: 7px;
                }
                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => { AppState.image-editor-brush-shape = "circle"; }
                }
            }

            square-shape := Rectangle {
                x: 112px;
                y: 8px;
                width: 42px;
                height: 30px;
                background: AppState.image-editor-brush-shape == "square" ? AppTheme.accent.with-alpha(0.13) : transparent;
                border-radius: 8px;
                border-width: 1px;
                border-color: AppState.image-editor-brush-shape == "square" ? AppTheme.accent : AppTheme.border;

                Rectangle {
                    x: 14px;
                    y: 8px;
                    width: 14px;
                    height: 14px;
                    background: AppTheme.accent;
                    border-radius: 1px;
                }
                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => { AppState.image-editor-brush-shape = "square"; }
                }
            }

            Text {
                x: 172px;
                y: 8px;
                width: 36px;
                height: 30px;
                text: AppState.en ? "Size" : "大小";
                color: AppTheme.muted;
                font-size: 13px;
                font-weight: 400;
                vertical-alignment: center;
            }

            brush-slider := Rectangle {
                x: 216px;
                y: 8px;
                width: parent.width - 306px;
                height: 30px;
                background: transparent;

                Rectangle {
                    x: 0px;
                    y: 13px;
                    width: parent.width;
                    height: 4px;
                    background: AppTheme.border;
                    border-radius: 2px;
                }
                Rectangle {
                    x: 0px;
                    y: 13px;
                    width: parent.width * (AppState.image-editor-brush-size - 8) / 72;
                    height: 4px;
                    background: AppTheme.accent;
                    border-radius: 2px;
                }
                Rectangle {
                    x: (parent.width - self.width) * (AppState.image-editor-brush-size - 8) / 72;
                    y: 6px;
                    width: 18px;
                    height: 18px;
                    background: AppTheme.accent;
                    border-radius: 9px;
                    border-width: 2px;
                    border-color: AppTheme.panel;
                }
                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => {
                        AppState.image-editor-brush-size = max(8, min(80, round(self.mouse-x / self.width * 72 + 8)));
                    }
                    moved => {
                        if self.pressed {
                            AppState.image-editor-brush-size = max(8, min(80, round(max(0px, min(self.width, self.mouse-x)) / self.width * 72 + 8)));
                        }
                    }
                }
            }

            Text {
                x: parent.width - 78px;
                y: 8px;
                width: 60px;
                height: 30px;
                text: round(AppState.image-editor-brush-size) + " px";
                color: AppTheme.accent;
                font-size: 13px;
                font-weight: 500;
                horizontal-alignment: right;
                vertical-alignment: center;
            }

            Text {
                x: 16px;
                y: 48px;
                width: 42px;
                height: 26px;
                text: AppState.en ? "Color" : "颜色";
                color: AppTheme.muted;
                font-size: 13px;
                font-weight: 400;
                vertical-alignment: center;
            }

            for color[index] in root.brush-palette: Rectangle {
                x: 62px + index * 34px;
                y: 48px;
                width: 26px;
                height: 26px;
                background: color;
                border-radius: 13px;
                border-width: AppState.image-editor-brush-color == color ? 3px : 1px;
                border-color: AppState.image-editor-brush-color == color ? AppTheme.accent : AppTheme.border;
                drop-shadow-blur: AppState.image-editor-brush-color == color ? 5px : 0px;
                drop-shadow-color: AppTheme.accent.with-alpha(0.35);

                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => { AppState.image-editor-brush-color = color; }
                }
            }
        }

        instruction-panel := Rectangle {
            x: parent.width - 320px;
            y: 0px;
            width: 320px;
            height: parent.height;
            background: AppTheme.panel-soft;
            border-radius: 12px;
            border-width: 1px;
            border-color: AppTheme.border;

            Text {
                x: 20px;
                y: 18px;
                width: parent.width - 40px;
                height: 26px;
                text: AppState.en ? "Edit instruction" : "编辑指令";
                color: AppTheme.text;
                font-size: 17px;
                font-weight: 600;
                vertical-alignment: center;
            }

            Text {
                x: 20px;
                y: 54px;
                width: 48px;
                height: 28px;
                text: AppState.en ? "Output" : "输出";
                color: AppTheme.muted;
                font-size: 12px;
                vertical-alignment: center;
            }

            for quality[index] in root.edit-qualities: Rectangle {
                property <bool> available: quality == "4K"
                    ? AppState.image-editor-price-4k > 0
                    : (quality == "2K" ? AppState.image-editor-price-2k > 0 : AppState.image-editor-price-1k > 0);
                x: 72px + index * 70px;
                y: 54px;
                width: 62px;
                height: 28px;
                background: AppState.image-editor-quality == quality ? AppTheme.accent.with-alpha(0.14) : AppTheme.panel;
                border-radius: 7px;
                border-width: 1px;
                border-color: AppState.image-editor-quality == quality ? AppTheme.accent : AppTheme.border;
                opacity: self.available ? 1 : 0.42;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: quality;
                    color: AppState.image-editor-quality == quality ? AppTheme.accent : AppTheme.text;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    enabled: parent.available;
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => { AppState.image-editor-quality = quality; }
                }
            }

            prompt-frame := Rectangle {
                x: 20px;
                y: 94px;
                width: parent.width - 40px;
                height: parent.height - 228px;
                background: AppTheme.panel;
                border-radius: 10px;
                border-width: 1px;
                border-color: edit-prompt.has-focus ? AppTheme.accent : AppTheme.border;

                edit-prompt := TextInput {
                    x: 12px;
                    y: 10px;
                    width: parent.width - 24px;
                    height: parent.height - 20px;
                    text <=> AppState.image-editor-prompt;
                    single-line: false;
                    color: AppTheme.text;
                    font-size: AppState.settings-font-size * 1px;
                    font-weight: 400;
                    wrap: word-wrap;
                    edited => { AppState.image-editor-status = ""; }
                }

                if AppState.image-editor-prompt == "" && !edit-prompt.has-focus: Text {
                    x: 12px;
                    y: 10px;
                    width: parent.width - 24px;
                    height: parent.height - 20px;
                    text: AppState.en
                        ? "Describe what should replace or change inside the painted area"
                        : "描述涂抹区域需要替换或修改成什么内容";
                    color: AppTheme.weak;
                    font-size: AppState.settings-font-size * 1px;
                    font-weight: 400;
                    wrap: word-wrap;
                }
            }

            if AppState.image-editor-status != "": Text {
                x: 20px;
                y: parent.height - 126px;
                width: parent.width - 40px;
                height: 38px;
                text: AppState.image-editor-status;
                color: AppTheme.muted;
                font-size: 12px;
                font-weight: 400;
                wrap: word-wrap;
                vertical-alignment: center;
            }

            Text {
                x: 20px;
                y: parent.height - 154px;
                width: parent.width - 40px;
                height: 24px;
                text: AppState.image-editor-model-name == ""
                    ? (AppState.en ? "No image-edit model available" : "暂无可用的图片编辑模型")
                    : (AppState.en
                        ? AppState.image-editor-model-name + " · " + AppState.image-editor-quality + " · Estimated " + AppState.image-editor-estimated-credit-cost + " credits"
                        : AppState.image-editor-model-name + " · " + AppState.image-editor-quality + " · 预计 " + AppState.image-editor-estimated-credit-cost + " 积分");
                color: AppTheme.weak;
                font-size: 11px;
                font-weight: 400;
                wrap: word-wrap;
                vertical-alignment: center;
            }

            submit-button := Rectangle {
                x: 20px;
                y: parent.height - 72px;
                width: parent.width - 40px;
                height: 48px;
                background: submit-touch.has-hover ? AppTheme.accent-dark : AppTheme.accent;
                border-radius: 24px;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: AppState.image-editor-generating
                        ? (AppState.en ? "Generating..." : "生成中...")
                        : (AppState.en ? "Generate" : "生成");
                    color: #ffffff;
                    font-size: 14px;
                    font-weight: 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                submit-touch := TouchArea {
                    enabled: !AppState.image-editor-generating && AppState.image-editor-model != "";
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => { AppState.submit-image-edit(); }
                }
            }
        }
    }
}
