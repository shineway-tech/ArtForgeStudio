import { AppState } from "../app-state.slint";
import { PillButton } from "../components/pill-button.slint";
import { AppTheme } from "../theme.slint";

component EnhanceQualityButton {
    in property <string> value;
    property <bool> selected: AppState.enhance-quality == root.value;
    callback clicked();

    Rectangle {
        background: root.selected
            ? AppTheme.accent.with-alpha(0.16)
            : (quality-touch.has-hover ? AppTheme.panel-soft : transparent);
        border-radius: 8px;
        border-width: 1px;
        border-color: root.selected ? AppTheme.accent : AppTheme.border;

        Text {
            width: parent.width;
            height: parent.height;
            text: root.value;
            color: root.selected ? AppTheme.accent-dark : AppTheme.text;
            font-size: 15px;
            font-weight: root.selected ? 500 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        quality-touch := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
}

component EnhancePreviewPanel {
    in property <string> title;
    in property <string> detail;
    in property <image> preview;
    in property <bool> has-image: false;
    in property <bool> upload-panel: false;
    callback choose-image();

    Rectangle {
        background: AppTheme.panel;
        border-radius: 12px;
        border-width: 1px;
        border-color: AppTheme.border;

        Text {
            x: 20px;
            y: 16px;
            width: 100px;
            height: 28px;
            text: root.title;
            color: AppTheme.text;
            font-size: 16px;
            font-weight: 600;
            vertical-alignment: center;
        }

        Text {
            x: 120px;
            y: 16px;
            width: parent.width - 140px;
            height: 28px;
            text: root.detail;
            color: AppTheme.muted;
            font-size: 12px;
            font-weight: 400;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }

        preview-frame := Rectangle {
            x: 20px;
            y: 56px;
            width: parent.width - 40px;
            height: parent.height - (root.upload-panel ? 164px : 76px);
            background: AppTheme.bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: root.upload-panel && preview-touch.has-hover
                ? AppTheme.accent
                : AppTheme.border;
            clip: true;

            if root.has-image: Image {
                width: parent.width;
                height: parent.height;
                source: root.preview;
                image-fit: contain;
            }

            if !root.has-image: Image {
                x: (parent.width - 44px) / 2;
                y: (parent.height - 88px) / 2;
                width: 44px;
                height: 44px;
                source: @image-url("../../assets/icons/image.svg");
                colorize: AppTheme.muted;
                image-fit: contain;
            }

            if !root.has-image: Text {
                x: 20px;
                y: (parent.height - 88px) / 2 + 54px;
                width: parent.width - 40px;
                height: 28px;
                text: root.upload-panel
                    ? (AppState.en ? "Click to upload an image" : "点击上传图片")
                    : (AppState.en ? "The enhanced result will appear here" : "清晰处理结果将在这里显示");
                color: AppTheme.muted;
                font-size: 14px;
                font-weight: 400;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            preview-touch := TouchArea {
                enabled: root.upload-panel;
                width: parent.width;
                height: parent.height;
                mouse-cursor: root.upload-panel ? pointer : default;
                clicked => {
                    if root.upload-panel {
                        root.choose-image();
                    }
                }
            }
        }

        if root.upload-panel: Text {
            x: 20px;
            y: parent.height - 94px;
            width: 76px;
            height: 40px;
            text: AppState.en ? "Quality" : "清晰度";
            color: AppTheme.text;
            font-size: 14px;
            font-weight: 400;
            vertical-alignment: center;
        }

        if root.upload-panel: HorizontalLayout {
            x: 92px;
            y: parent.height - 94px;
            width: max(138px, min(260px, parent.width - 278px));
            height: 40px;
            spacing: 8px;

            EnhanceQualityButton {
                horizontal-stretch: 1;
                value: "1K";
                clicked => {
                    AppState.enhance-quality = "1K";
                    AppState.enhance-message = "";
                }
            }
            EnhanceQualityButton {
                horizontal-stretch: 1;
                value: "2K";
                clicked => {
                    AppState.enhance-quality = "2K";
                    AppState.enhance-message = "";
                }
            }
            EnhanceQualityButton {
                horizontal-stretch: 1;
                value: "4K";
                clicked => {
                    AppState.enhance-quality = "4K";
                    AppState.enhance-message = "";
                }
            }
        }

        if root.upload-panel: PillButton {
            x: parent.width - 166px;
            y: parent.height - 94px;
            width: 146px;
            height: 40px;
            text: AppState.enhance-processing
                ? (AppState.en ? "Enhancing..." : "处理中...")
                : (AppState.en ? "Start Enhance" : "开始变清晰");
            primary: true;
            disabled: AppState.enhance-processing;
            clicked => { AppState.start-enhance(AppState.enhance-quality); }
        }
    }
}

export component ToolboxEnhancePage {
    function panel-width() -> length {
        return max(420px, (root.width - 84px) / 2);
    }

    Rectangle {
        background: AppTheme.bg;

        Text {
            x: 32px;
            y: 28px;
            width: parent.width - 64px;
            height: 32px;
            text: AppState.en ? "Image Enhance" : "图片变清晰";
            color: AppTheme.text;
            font-size: 24px;
            font-weight: 600;
            vertical-alignment: center;
        }

        Text {
            x: 32px;
            y: 68px;
            width: parent.width - 64px;
            height: 22px;
            text: AppState.en
                ? "Upload an image, choose the target quality, and compare the result"
                : "上传图片，选择目标清晰度并对比处理结果";
            color: AppTheme.muted;
            font-size: 13px;
            font-weight: 400;
            vertical-alignment: center;
        }

        source-panel := EnhancePreviewPanel {
            x: 32px;
            y: 112px;
            width: root.panel-width();
            height: parent.height - 144px;
            title: AppState.en ? "Original" : "原图";
            detail: AppState.enhance-source-name;
            preview: AppState.enhance-source-image;
            has-image: AppState.enhance-source-path != "";
            upload-panel: true;
            choose-image => { AppState.choose-enhance-source(); }
        }

        result-panel := EnhancePreviewPanel {
            x: 52px + root.panel-width();
            y: 112px;
            width: root.panel-width();
            height: parent.height - 144px;
            title: AppState.en ? "Result" : "处理结果";
            detail: AppState.enhance-result-name;
            preview: AppState.enhance-result-image;
            has-image: AppState.enhance-result-path != "";
        }

        if AppState.enhance-message != "": Text {
            x: 72px + root.panel-width();
            y: parent.height - 86px;
            width: root.panel-width() - 40px;
            height: 40px;
            text: AppState.enhance-message;
            color: AppTheme.muted;
            font-size: 12px;
            font-weight: 400;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
