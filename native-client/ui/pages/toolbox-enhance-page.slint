import { AppState } from "../app-state.slint";
import { PillButton } from "../components/pill-button.slint";
import { AppTheme } from "../theme.slint";

component EnhanceQualityButton {
    in property <string> value;
    in property <bool> disabled: false;
    property <bool> selected: AppState.enhance-quality == root.value;
    callback clicked();

    Rectangle {
        background: root.selected
            ? AppTheme.accent.with-alpha(0.16)
            : (quality-touch.has-hover && !root.disabled ? AppTheme.panel-soft : transparent);
        border-radius: 8px;
        border-width: 1px;
        border-color: root.selected ? AppTheme.accent : AppTheme.border;

        Text {
            width: parent.width;
            height: parent.height;
            text: root.value;
            color: root.disabled
                ? AppTheme.muted
                : (root.selected ? AppTheme.accent-dark : AppTheme.text);
            font-size: 15px;
            font-weight: root.selected ? 500 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        quality-touch := TouchArea {
            enabled: !root.disabled;
            width: parent.width;
            height: parent.height;
            mouse-cursor: root.disabled ? default : pointer;
            clicked => { root.clicked(); }
        }
    }
}

component EnhancePreviewPanel {
    in property <string> title;
    in property <string> detail;
    in property <image> preview;
    in property <bool> has-image: false;
    in property <bool> processing: false;
    in property <int> progress: 0;
    in property <bool> result-panel: false;
    in property <bool> drop-enabled: false;
    callback choose-image();
    callback dropped(data-transfer) -> bool;

    Rectangle {
        background: transparent;

        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 28px;
            text: root.processing
                ? (AppState.en ? "Enhancing image (" + root.progress + "%)..." : "图片清晰处理中(" + root.progress + "%)...")
                : root.title;
            color: AppTheme.text;
            font-size: 16px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            x: 0px;
            y: 30px;
            width: parent.width;
            height: 20px;
            text: root.detail;
            color: AppTheme.muted;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }

        preview-frame := Rectangle {
            x: 0px;
            y: 62px;
            width: parent.width;
            height: parent.height - 62px;
            background: source-drop.has-drag
                ? AppTheme.accent.with-alpha(0.08)
                : AppTheme.panel;
            border-radius: 12px;
            border-width: source-drop.has-drag ? 2px : 1px;
            border-color: source-drop.has-drag || root.processing
                ? AppTheme.accent
                : AppTheme.border;
            clip: true;

            if root.has-image: Image {
                x: 12px;
                y: 12px;
                width: parent.width - 24px;
                height: parent.height - 24px;
                source: root.preview;
                image-fit: contain;
            }

            if !root.has-image: Rectangle {
                background: transparent;

                Rectangle {
                    x: (parent.width - 58px) / 2;
                    y: (parent.height - 108px) / 2;
                    width: 58px;
                    height: 58px;
                    border-radius: 14px;
                    background: AppTheme.panel-soft;

                    Image {
                        x: 16px;
                        y: 16px;
                        width: 26px;
                        height: 26px;
                        source: root.result-panel
                            ? @image-url("../../assets/icons/image.svg")
                            : @image-url("../../assets/icons/upload.svg");
                        colorize: AppTheme.muted;
                        image-fit: contain;
                    }
                }

                Text {
                    x: 24px;
                    y: (parent.height - 108px) / 2 + 72px;
                    width: parent.width - 48px;
                    height: 24px;
                    text: source-drop.has-drag
                        ? (AppState.en ? "Release to upload image" : "松开即可上传图片")
                        : root.result-panel
                        ? (AppState.en ? "The enhanced image will appear here" : "清晰增强结果将在这里显示")
                        : (AppState.en ? "Drag an image here, or click to upload" : "拖放图片到这里，或点击上传");
                    color: source-drop.has-drag ? AppTheme.accent : AppTheme.muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if !root.result-panel: TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => { root.choose-image(); }
                }
            }

            if root.processing: Rectangle {
                x: 0px;
                y: parent.height - 4px;
                width: parent.width * root.progress / 100;
                height: 4px;
                background: AppTheme.accent;
            }

            if source-drop.has-drag && root.has-image: Rectangle {
                background: AppTheme.accent.with-alpha(0.12);

                Rectangle {
                    x: (parent.width - 220px) / 2;
                    y: (parent.height - 48px) / 2;
                    width: 220px;
                    height: 48px;
                    border-radius: 12px;
                    background: AppTheme.panel;
                    border-width: 1px;
                    border-color: AppTheme.accent;

                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: AppState.en ? "Release to replace image" : "松开即可更换图片";
                        color: AppTheme.accent;
                        font-size: 14px;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            source-drop := DropArea {
                width: parent.width;
                height: parent.height;
                can-drop(event) => {
                    return root.drop-enabled ? DragAction.copy : DragAction.none;
                }
                dropped(event) => {
                    return root.dropped(event.data) ? DragAction.copy : DragAction.none;
                }
            }
        }
    }
}

export component ToolboxEnhancePage {
    function panel-gap() -> length {
        return 20px;
    }

    function panel-width() -> length {
        return (root.width - 64px - root.panel-gap()) / 2;
    }

    Rectangle {
        background: AppTheme.bg;

        Text {
            x: 32px;
            y: 28px;
            width: parent.width - 64px;
            height: 32px;
            text: AppState.en ? "Image Enhance" : "图片清晰";
            color: AppTheme.text;
            font-size: 24px;
            font-weight: 600;
            vertical-alignment: center;
        }

        source-panel := EnhancePreviewPanel {
            x: 32px;
            y: 76px;
            width: root.panel-width();
            height: parent.height - 182px;
            title: AppState.en ? "Original" : "原图";
            detail: AppState.enhance-source-name;
            preview: AppState.enhance-source-image;
            has-image: AppState.enhance-source-path != "";
            drop-enabled: !AppState.enhance-processing;
            choose-image => { AppState.choose-enhance-source(); }
            dropped(data) => {
                return AppState.add-enhance-source-from-drag(data);
            }
        }

        result-panel := EnhancePreviewPanel {
            x: 32px + root.panel-width() + root.panel-gap();
            y: 76px;
            width: root.panel-width();
            height: parent.height - 182px;
            title: AppState.enhance-result-path != ""
                ? (AppState.en ? "Enhanced image" : "清晰增强结果")
                : (AppState.en ? "Waiting for processing" : "等待处理");
            detail: AppState.enhance-result-name;
            preview: AppState.enhance-result-image;
            has-image: AppState.enhance-result-path != "";
            processing: AppState.enhance-processing;
            progress: AppState.enhance-progress;
            result-panel: true;
        }

        Text {
            x: 32px;
            y: parent.height - 78px;
            width: 58px;
            height: 42px;
            text: AppState.en ? "Quality" : "清晰度";
            color: AppTheme.text;
            font-size: 14px;
            vertical-alignment: center;
        }

        HorizontalLayout {
            x: 96px;
            y: parent.height - 78px;
            width: 140px;
            height: 42px;
            spacing: 8px;

            EnhanceQualityButton {
                horizontal-stretch: 1;
                value: "2K";
                disabled: AppState.enhance-processing;
                clicked => {
                    AppState.enhance-quality = "2K";
                    AppState.enhance-message = "";
                }
            }

            EnhanceQualityButton {
                horizontal-stretch: 1;
                value: "4K";
                disabled: AppState.enhance-processing;
                clicked => {
                    AppState.enhance-quality = "4K";
                    AppState.enhance-message = "";
                }
            }
        }

        if AppState.enhance-source-path != "": PillButton {
            x: 32px + root.panel-width() - 304px;
            y: parent.height - 78px;
            width: 126px;
            height: 42px;
            text: AppState.en ? "Change image" : "更换图片";
            disabled: AppState.enhance-processing;
            clicked => { AppState.choose-enhance-source(); }
        }

        PillButton {
            x: 32px + root.panel-width() - 166px;
            y: parent.height - 78px;
            width: 166px;
            height: 42px;
            text: AppState.enhance-processing
                ? (AppState.en ? "Enhancing..." : "处理中...")
                : (AppState.en ? "Enhance image" : "一键变清晰");
            primary: true;
            disabled: AppState.enhance-source-path == "" || AppState.enhance-processing;
            clicked => { AppState.start-enhance(AppState.enhance-quality); }
        }

        Text {
            x: 32px + root.panel-width() - 166px;
            y: parent.height - 33px;
            width: 166px;
            height: 20px;
            text: AppState.en
                ? "Estimated charge: " + AppState.enhance-estimated-credits + " credits"
                : "本次预计扣除 " + AppState.enhance-estimated-credits + " 积分";
            color: AppTheme.muted;
            font-size: 10px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        PillButton {
            x: parent.width - 174px;
            y: parent.height - 78px;
            width: 142px;
            height: 42px;
            text: AppState.en ? "View image" : "查看图片";
            disabled: AppState.enhance-result-path == "";
            clicked => { AppState.reveal-enhance-result(); }
        }

        if AppState.enhance-message != "": Text {
            x: 32px + root.panel-width() + root.panel-gap();
            y: parent.height - 69px;
            width: root.panel-width() - 162px;
            height: 24px;
            text: AppState.enhance-message;
            color: AppTheme.muted;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
