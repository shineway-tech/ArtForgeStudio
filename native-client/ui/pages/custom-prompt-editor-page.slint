import { ScrollView } from "std-widgets.slint";
import { AppState } from "../app-state.slint";
import { PillButton } from "../components/pill-button.slint";
import { AppTheme } from "../theme.slint";

component PromptCategorySelect {
    in-out property <string> value: "default";
    property <bool> open: false;
    height: 42px;

    Rectangle {
        background: AppTheme.bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: root.open ? AppTheme.accent : AppTheme.border;
        Text {
            x: 12px;
            width: parent.width - 44px;
            height: parent.height;
            text: root.category-label(root.value);
            color: AppTheme.text;
            font-size: AppState.settings-font-size * 1px;
            font-weight: 400;
            vertical-alignment: center;
            overflow: elide;
        }
        Image {
            x: parent.width - 30px;
            y: (parent.height - 12px) / 2;
            width: 12px;
            height: 12px;
            source: @image-url("../../assets/icons/dropdown.svg");
            colorize: AppTheme.muted;
            image-fit: contain;
        }
        TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: pointer;
            clicked => {
                root.open = true;
                category-popup.show();
            }
        }
    }

    category-popup := PopupWindow {
        x: 0px;
        y: 46px;
        width: root.width;
        height: 210px;
        close-policy: close-on-click-outside;
        Rectangle {
            visible: root.open;
            background: AppTheme.panel;
            border-radius: 8px;
            border-width: 1px;
            border-color: AppTheme.border;
            VerticalLayout {
                padding: 5px;
                spacing: 2px;
                for option in [
                    { value: "default", label: AppState.en ? "Default" : "默认" },
                    { value: "character", label: AppState.en ? "Character" : "角色" },
                    { value: "scene", label: AppState.en ? "Scene" : "场景" },
                    { value: "ui", label: "UI" },
                    { value: "effect", label: AppState.en ? "Effect" : "特效" },
                ]: Rectangle {
                    height: 38px;
                    background: option-touch.has-hover || root.value == option.value
                        ? AppTheme.panel-soft
                        : transparent;
                    border-radius: 6px;
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text: option.label;
                        color: root.value == option.value ? AppTheme.accent : AppTheme.text;
                        font-size: AppState.settings-font-size * 1px;
                        font-weight: 400;
                        vertical-alignment: center;
                    }
                    option-touch := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: pointer;
                        clicked => {
                            root.value = option.value;
                            root.open = false;
                            category-popup.close();
                        }
                    }
                }
            }
        }
    }

    function category-label(value: string) -> string {
        if value == "character" { return AppState.en ? "Character" : "角色"; }
        if value == "scene" { return AppState.en ? "Scene" : "场景"; }
        if value == "ui" { return "UI"; }
        if value == "effect" { return AppState.en ? "Effect" : "特效"; }
        return AppState.en ? "Default" : "默认";
    }
}

component FormatOption {
    in property <string> value;
    in property <string> label;
    property <bool> active: AppState.custom-prompt-format == root.value;
    callback selected();
    width: 86px;
    height: 38px;

    Rectangle {
        background: root.active ? AppTheme.accent : AppTheme.bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: root.active ? AppTheme.accent : AppTheme.border;
        Text {
            width: parent.width;
            height: parent.height;
            text: root.label;
            color: root.active ? #ffffff : AppTheme.text;
            font-size: 12px;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: pointer;
            clicked => { root.selected(); }
        }
    }
}

export component CustomPromptEditorPage {
    function save-prompt() {
        AppState.save-custom-prompt(
            AppState.custom-prompt-editing-original,
            AppState.custom-prompt-input,
        );
    }

    Rectangle {
        background: AppTheme.bg;

        editor := Rectangle {
            x: 28px;
            y: 18px;
            width: parent.width - 56px;
            height: parent.height - 36px;
            background: AppTheme.panel;
            border-radius: 12px;
            border-width: 1px;
            border-color: AppTheme.border;
            clip: true;
            init => { prompt-name-input.focus(); }

            Text {
                x: 24px;
                y: 16px;
                width: parent.width - 180px;
                height: 36px;
                text: AppState.custom-prompt-editing-original == ""
                    ? (AppState.en ? "Create prompt" : "创建提示词")
                    : (AppState.en ? "Edit prompt" : "编辑提示词");
                color: AppTheme.text;
                font-size: 20px;
                font-weight: 600;
                vertical-alignment: center;
            }
            PillButton {
                x: parent.width - 104px;
                y: 16px;
                width: 80px;
                height: 36px;
                text: AppState.en ? "Close" : "关闭";
                clicked => { AppState.close-custom-prompt-editor(); }
            }

            body := Rectangle {
                x: 24px;
                y: 68px;
                width: parent.width - 48px;
                height: parent.height - 136px;
                background: transparent;

                left-panel := Rectangle {
                    x: 0px;
                    width: max(310px, min(430px, (parent.width - 18px) * 0.37));
                    height: parent.height;
                    background: AppTheme.bg;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: AppTheme.border;
                    clip: true;

                    Text {
                        x: 20px;
                        y: 16px;
                        width: parent.width - 40px;
                        height: 18px;
                        text: AppState.en ? "Prompt name *" : "提示词名称 *";
                        color: AppTheme.text;
                        font-size: 13px;
                        font-weight: 400;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        x: 20px;
                        y: 42px;
                        width: parent.width - 40px;
                        height: 42px;
                        background: AppTheme.panel;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: prompt-name-input.has-focus ? AppTheme.accent : AppTheme.border;
                        prompt-name-input := TextInput {
                            x: 12px;
                            width: parent.width - 24px;
                            height: parent.height;
                            text <=> AppState.custom-prompt-name;
                            input-type: text;
                            single-line: true;
                            color: AppTheme.text;
                            font-size: AppState.settings-font-size * 1px;
                            font-weight: 400;
                            vertical-alignment: center;
                        }
                        if AppState.custom-prompt-name == "" && !prompt-name-input.has-focus: Text {
                            x: 12px;
                            width: parent.width - 24px;
                            height: parent.height;
                            text: AppState.en ? "For example: Dark Style V5" : "例如：暗黑风格V5";
                            color: AppTheme.weak;
                            font-size: AppState.settings-font-size * 1px;
                            font-weight: 400;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        x: 20px;
                        y: 100px;
                        width: parent.width - 40px;
                        height: 18px;
                        text: AppState.en ? "Category" : "分类";
                        color: AppTheme.text;
                        font-size: 13px;
                        font-weight: 400;
                        vertical-alignment: center;
                    }
                    PromptCategorySelect {
                        x: 20px;
                        y: 126px;
                        width: parent.width - 40px;
                        value <=> AppState.custom-prompt-category;
                    }

                    Text {
                        x: 20px;
                        y: 184px;
                        width: parent.width - 40px;
                        height: 18px;
                        text: AppState.en ? "Save format" : "保存格式";
                        color: AppTheme.text;
                        font-size: 13px;
                        font-weight: 400;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        x: 20px;
                        y: 210px;
                        width: parent.width - 40px;
                        height: 38px;
                        spacing: 10px;
                        FormatOption {
                            value: "json";
                            label: "JSON";
                            selected => { AppState.custom-prompt-format = "json"; }
                        }
                        FormatOption {
                            value: "txt";
                            label: "TXT";
                            selected => { AppState.custom-prompt-format = "txt"; }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }

                    Text {
                        x: 20px;
                        y: 266px;
                        width: parent.width - 40px;
                        height: 18px;
                        text: AppState.en ? "Reference image" : "参考图";
                        color: AppTheme.text;
                        font-size: 13px;
                        font-weight: 400;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        x: 20px;
                        y: 292px;
                        width: parent.width - 40px;
                        height: 36px;
                        spacing: 8px;
                        PillButton {
                            horizontal-stretch: 1;
                            height: 36px;
                            text: AppState.en ? "Upload image" : "上传参考图";
                            clicked => { AppState.choose-custom-prompt-reference(); }
                        }
                        PillButton {
                            horizontal-stretch: 1;
                            height: 36px;
                            text: AppState.custom-prompt-analyzing
                                ? (AppState.en ? "Analyzing..." : "分析中...")
                                : (AppState.en ? "AI style analysis" : "AI 分析风格");
                            disabled: AppState.custom-prompt-reference-path == "" || AppState.custom-prompt-analyzing;
                            clicked => { AppState.analyze-custom-prompt-reference(); }
                        }
                    }
                    Rectangle {
                        x: 20px;
                        y: 340px;
                        width: parent.width - 40px;
                        height: max(116px, parent.height - 360px);
                        background: AppTheme.panel;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: AppTheme.border;
                        clip: true;

                        if AppState.custom-prompt-reference-path == "": Text {
                            x: 14px;
                            width: parent.width - 28px;
                            height: parent.height;
                            text: AppState.en
                                ? "The uploaded reference image will appear here."
                                : "已上传参考图会显示在这里。";
                            color: AppTheme.weak;
                            font-size: 12px;
                            font-weight: 400;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        if AppState.custom-prompt-reference-path != "": Image {
                            x: 12px;
                            y: 12px;
                            width: min(132px, parent.width * 0.42);
                            height: parent.height - 24px;
                            source: AppState.custom-prompt-reference-image;
                            image-fit: contain;
                        }
                        if AppState.custom-prompt-reference-path != "": Text {
                            x: min(156px, parent.width * 0.48);
                            y: 16px;
                            width: parent.width - self.x - 16px;
                            height: parent.height - 66px;
                            text: AppState.custom-prompt-reference-path;
                            color: AppTheme.muted;
                            font-size: 12px;
                            font-weight: 400;
                            wrap: word-wrap;
                            overflow: elide;
                        }
                        if AppState.custom-prompt-reference-path != "": PillButton {
                            x: parent.width - 88px;
                            y: parent.height - 44px;
                            width: 72px;
                            height: 30px;
                            text: AppState.en ? "Remove" : "移除";
                            clicked => { AppState.clear-custom-prompt-reference(); }
                        }
                    }
                }

                right-panel := Rectangle {
                    x: left-panel.width + 18px;
                    width: parent.width - self.x;
                    height: parent.height;
                    background: AppTheme.bg;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: AppTheme.border;
                    clip: true;

                    Text {
                        x: 20px;
                        y: 16px;
                        width: parent.width - 40px;
                        height: 18px;
                        text: AppState.en ? "Prompt content *" : "提示词内容 *";
                        color: AppTheme.text;
                        font-size: 13px;
                        font-weight: 400;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        x: 20px;
                        y: 42px;
                        width: parent.width - 40px;
                        height: max(220px, parent.height - 198px);
                        background: AppTheme.panel;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: prompt-input.has-focus ? AppTheme.accent : AppTheme.border;
                        clip: true;
                        optimize-content-button := Rectangle {
                            x: parent.width - 112px;
                            y: 10px;
                            width: 100px;
                            height: 30px;
                            background: optimize-content-touch.has-hover ? AppTheme.panel-soft : transparent;
                            border-radius: 15px;
                            border-width: 1px;
                            border-color: AppTheme.border;
                            opacity: AppState.optimizing-prompt ? 0.5 : 1;
                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: AppState.optimizing-prompt
                                    ? (AppState.en ? "Optimizing" : "优化中")
                                    : (AppState.en ? "AI Optimize" : "AI优化");
                                color: AppTheme.accent-dark;
                                font-size: 12px;
                                font-weight: 400;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            optimize-content-touch := TouchArea {
                                width: parent.width;
                                height: parent.height;
                                enabled: !AppState.optimizing-prompt;
                                mouse-cursor: AppState.optimizing-prompt ? default : pointer;
                                clicked => { AppState.optimize-custom-prompt-content(); }
                            }
                        }
                        prompt-scroll := ScrollView {
                            x: 12px;
                            y: 48px;
                            width: parent.width - 24px;
                            height: parent.height - 58px;
                            viewport-width: self.visible-width;
                            viewport-height: max(self.visible-height, prompt-input.preferred-height);
                            prompt-input := TextInput {
                                text <=> AppState.custom-prompt-input;
                                input-type: text;
                                single-line: false;
                                wrap: word-wrap;
                                color: AppTheme.text;
                                font-size: AppState.settings-font-size * 1px;
                                font-weight: 400;
                                page-height: prompt-scroll.visible-height;
                            }
                        }
                        if AppState.custom-prompt-input == "" && !prompt-input.has-focus: Text {
                            x: 12px;
                            y: 48px;
                            width: parent.width - 24px;
                            height: parent.height - 58px;
                            text: AppState.en
                                ? "Enter the reusable prompt content"
                                : "输入可复用的提示词内容";
                            color: AppTheme.weak;
                            font-size: AppState.settings-font-size * 1px;
                            font-weight: 400;
                            vertical-alignment: top;
                        }
                    }

                    Text {
                        x: 20px;
                        y: parent.height - 138px;
                        width: parent.width - 40px;
                        height: 18px;
                        text: AppState.en
                            ? "Negative prompt (JSON only)"
                            : "反向提示词（仅 JSON 格式有效）";
                        color: AppState.custom-prompt-format == "json" ? AppTheme.text : AppTheme.weak;
                        font-size: 13px;
                        font-weight: 400;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        x: 20px;
                        y: parent.height - 112px;
                        width: parent.width - 40px;
                        height: 92px;
                        background: AppTheme.panel;
                        opacity: AppState.custom-prompt-format == "json" ? 1 : 0.55;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: negative-input.has-focus ? AppTheme.accent : AppTheme.border;
                        clip: true;
                        negative-input := TextInput {
                            x: 12px;
                            y: 10px;
                            width: parent.width - 24px;
                            height: parent.height - 20px;
                            enabled: AppState.custom-prompt-format == "json";
                            text <=> AppState.custom-prompt-negative;
                            input-type: text;
                            single-line: false;
                            wrap: word-wrap;
                            color: AppTheme.text;
                            font-size: AppState.settings-font-size * 1px;
                            font-weight: 400;
                        }
                        if AppState.custom-prompt-negative == "" && !negative-input.has-focus: Text {
                            x: 12px;
                            y: 10px;
                            width: parent.width - 24px;
                            height: parent.height - 20px;
                            text: AppState.en ? "Optional negative prompt" : "可选：输入反向提示词";
                            color: AppTheme.weak;
                            font-size: AppState.settings-font-size * 1px;
                            font-weight: 400;
                            vertical-alignment: top;
                        }
                    }
                }
            }

            Text {
                x: 24px;
                y: parent.height - 52px;
                width: parent.width - 300px;
                height: 32px;
                text: AppState.custom-prompt-message;
                color: AppTheme.danger;
                font-size: 12px;
                font-weight: 400;
                vertical-alignment: center;
                overflow: elide;
            }
            HorizontalLayout {
                x: parent.width - 270px;
                y: parent.height - 54px;
                width: 246px;
                height: 38px;
                spacing: 10px;
                PillButton {
                    width: 104px;
                    height: 38px;
                    text: AppState.en ? "Cancel" : "取消";
                    clicked => { AppState.close-custom-prompt-editor(); }
                }
                PillButton {
                    width: 132px;
                    height: 38px;
                    text: AppState.custom-prompt-editing-original == ""
                        ? (AppState.en ? "Save" : "保存")
                        : (AppState.en ? "Save changes" : "保存修改");
                    primary: true;
                    clicked => { root.save-prompt(); }
                }
            }
        }
    }
}
