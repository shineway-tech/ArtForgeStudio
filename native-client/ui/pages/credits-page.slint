import { ScrollView } from "std-widgets.slint";
import { AppState } from "../app-state.slint";
import { CreditPlan } from "../components/credit-plan.slint";
import { CreditRecordRow } from "../components/credit-record-row.slint";
import { EmptyState } from "../components/empty-state.slint";
import { MembershipPlans } from "../components/membership-plans.slint";
import { PillButton } from "../components/pill-button.slint";
import { PurchaseAgreements } from "../components/purchase-agreements.slint";
import { SectionTitle } from "../components/section-title.slint";
import { AppTheme } from "../theme.slint";

component CreditBalanceCard inherits Rectangle {
    height: 148px;
    background: AppTheme.panel;
    border-radius: 14px;
    border-width: 1px;
    border-color: AppTheme.border;

    Text {
        x: 22px;
        y: 20px;
        text: AppState.en ? "Remaining Credits" : "剩余积分";
        color: AppTheme.muted;
        font-size: 14px;
        font-weight: 400;
    }
    Text {
        x: 22px;
        y: 48px;
        width: parent.width - 180px;
        height: 42px;
        text: AppState.credit-balance;
        color: AppTheme.text;
        font-size: 40px;
        font-weight: 600;
    }
    Text {
        x: parent.width - 146px;
        y: 54px;
        width: 124px;
        height: 24px;
        text: AppState.en ? ("Frozen " + AppState.credit-reserved) : ("冻结 " + AppState.credit-reserved);
        color: AppTheme.muted;
        font-size: 13px;
        font-weight: 500;
        horizontal-alignment: right;
    }
    Text {
        x: 22px;
        y: 98px;
        width: parent.width - 44px;
        height: 36px;
        text: AppState.en
            ? "Credits are used for image generation and prompt services."
            : "积分用于图片生成、提示词优化等服务。";
        color: AppTheme.muted;
        font-size: 13px;
        font-weight: 400;
        overflow: elide;
    }
}

component MidAutumnHero inherits Rectangle {
    height: 154px;
    background: #1f2452;
    border-radius: 16px;
    clip: true;

    Rectangle {
        x: parent.width - 118px;
        y: 18px;
        width: 72px;
        height: 72px;
        background: #f7d477;
        border-radius: 36px;
    }
    Rectangle { x: 26px; y: 24px; width: 4px; height: 4px; background: #f7d477; border-radius: 2px; }
    Rectangle { x: 74px; y: 18px; width: 3px; height: 3px; background: #f7d477; border-radius: 2px; }
    Rectangle { x: parent.width - 164px; y: 86px; width: 4px; height: 4px; background: #f7d477; border-radius: 2px; }
    Rectangle { x: parent.width - 204px; y: 38px; width: 3px; height: 3px; background: #f7d477; border-radius: 2px; }

    // A light, low-density rabbit outline keeps the seasonal cue quiet.
    Rectangle {
        x: parent.width - 196px;
        y: 84px;
        width: 34px;
        height: 30px;
        background: transparent;
        border-width: 1px;
        border-color: #d8c488;
        border-radius: 17px;
    }
    Rectangle { x: parent.width - 190px; y: 67px; width: 7px; height: 22px; background: transparent; border-width: 1px; border-color: #d8c488; border-radius: 4px; }
    Rectangle { x: parent.width - 175px; y: 67px; width: 7px; height: 22px; background: transparent; border-width: 1px; border-color: #d8c488; border-radius: 4px; }

    Rectangle {
        x: 22px;
        y: 120px;
        width: 12px;
        height: 18px;
        background: #e08c55;
        border-radius: 5px;
    }
    Rectangle { x: 27px; y: 111px; width: 2px; height: 10px; background: #d8c488; }
    Rectangle { x: 24px; y: 107px; width: 8px; height: 5px; background: #e08c55; border-radius: 2px; }
    Rectangle {
        x: 54px;
        y: 128px;
        width: 8px;
        height: 12px;
        background: #e08c55;
        border-radius: 4px;
    }

    Text {
        x: 24px;
        y: 18px;
        width: parent.width - 172px;
        height: 26px;
        text: AppState.credit-promotion-label == "" ? (AppState.en ? "Mid-Autumn Festival" : "中秋福利") : AppState.credit-promotion-label;
        color: #f7d477;
        font-size: 12px;
        font-weight: 600;
        overflow: elide;
    }
    Text {
        x: 24px;
        y: 44px;
        width: parent.width - 172px;
        height: 30px;
        text: AppState.credit-promotion-title;
        color: #ffffff;
        font-size: 21px;
        font-weight: 700;
        overflow: elide;
    }
    Text {
        x: 24px;
        y: 78px;
        width: parent.width - 172px;
        height: 20px;
        text: AppState.credit-promotion-description;
        color: #e7e4d8;
        font-size: 12px;
        font-weight: 400;
        overflow: elide;
    }
    Text {
        x: 24px;
        y: 104px;
        width: parent.width - 172px;
        height: 20px;
        text: AppState.credit-promotion-deadline-label != ""
            ? AppState.credit-promotion-deadline-label
            : (AppState.credit-promotion-ends-at == ""
                ? (AppState.en ? "Limited-time bonus" : "限时加赠")
                : (AppState.en ? ("Ends " + AppState.credit-promotion-ends-at) : ("活动截止 " + AppState.credit-promotion-ends-at)));
        color: #f7d477;
        font-size: 11px;
        font-weight: 500;
        overflow: elide;
    }
    Text {
        x: parent.width - 146px;
        y: 118px;
        width: 112px;
        height: 20px;
        text: AppState.en ? "View rules →" : "查看活动规则 →";
        color: #f7d477;
        font-size: 11px;
        font-weight: 500;
        horizontal-alignment: right;
    }
    TouchArea {
        x: parent.width - 152px;
        y: 110px;
        width: 132px;
        height: 34px;
        mouse-cursor: pointer;
        clicked => { AppState.open-agreement(AppState.purchase-credit-rules-title, AppState.purchase-credit-rules-url); }
    }
}

component CreditLedgerSection {
    height: 46px
        + (AppState.credit-records.length == 0 ? 220px : AppState.credit-records.length * 86px)
        + (AppState.credit-ledger-message == "" ? 0px : 42px)
        + (AppState.credit-records.length > 0 || AppState.credit-ledger-page > 1 ? 58px : 0px);

    VerticalLayout {
        width: root.width;
        spacing: 10px;

        SectionTitle { text: AppState.en ? "Credit Details" : "积分明细"; }
        if AppState.credit-records.length == 0: EmptyState {}
        if AppState.credit-records.length > 0: VerticalLayout {
            spacing: 10px;
            for record in AppState.credit-records: CreditRecordRow { item: record; }
        }
        if AppState.credit-ledger-message != "": Rectangle {
            height: 32px;
            background: transparent;
            Text {
                width: parent.width;
                height: parent.height;
                text: AppState.credit-ledger-message;
                color: AppTheme.danger;
                font-size: 12px;
                font-weight: 400;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if AppState.credit-records.length > 0 || AppState.credit-ledger-page > 1: Rectangle {
            height: 48px;
            background: transparent;
            PillButton {
                x: parent.width / 2 - 174px;
                y: 6px;
                width: 108px;
                text: AppState.en ? "Previous" : "上一页";
                disabled: !AppState.credit-ledger-has-previous || AppState.credit-ledger-loading;
                clicked => { AppState.credit-ledger-previous-page(); }
            }
            Text {
                x: parent.width / 2 - 54px;
                width: 108px;
                height: parent.height;
                text: AppState.credit-ledger-loading
                    ? (AppState.en ? "Loading..." : "加载中…")
                    : (AppState.en ? ("Page " + AppState.credit-ledger-page) : ("第 " + AppState.credit-ledger-page + " 页"));
                color: AppTheme.muted;
                font-size: 13px;
                font-weight: 400;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            PillButton {
                x: parent.width / 2 + 66px;
                y: 6px;
                width: 108px;
                text: AppState.en ? "Next" : "下一页";
                disabled: !AppState.credit-ledger-has-next || AppState.credit-ledger-loading;
                clicked => { AppState.credit-ledger-next-page(); }
            }
        }
    }
}

component CreditRedemptionPanel inherits Rectangle {
    property <bool> joined-team: AppState.team-role-label == "成员" || AppState.team-role-label == "Member";
    height: 296px;
    background: AppTheme.panel;
    border-radius: 14px;
    border-width: 1px;
    border-color: AppTheme.border;

    Text {
        x: 22px;
        y: 18px;
        width: parent.width - 44px;
        height: 28px;
        text: AppState.en ? "Enter a redemption code" : "输入兑换码";
        color: AppTheme.text;
        font-size: 18px;
        font-weight: 600;
        vertical-alignment: center;
    }
    Text {
        x: 22px;
        y: 50px;
        width: parent.width - 44px;
        height: 22px;
        text: AppState.en
            ? "Redeem an official code in My Team. Credits are added to your own account."
            : "请在“自己的团队”中输入官方兑换码，积分将到账你自己的主账号。";
        color: AppTheme.muted;
        font-size: 13px;
        font-weight: 400;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 22px;
        y: 82px;
        width: parent.width - 44px;
        height: 20px;
        text: root.joined-team
            ? (AppState.en ? "You are in a joined team. Switch to My Team to redeem a code." : "当前为加入的团队，请切换到“自己的团队”后兑换。")
            : (AppState.en ? "Receiving account · " : "到账账号 · ")
            + (AppState.nickname == ""
                ? (AppState.email-mask == "" ? "--" : AppState.email-mask)
                : AppState.nickname + (AppState.email-mask == "" ? "" : " · " + AppState.email-mask));
        color: AppTheme.accent-dark;
        font-size: 12px;
        font-weight: 500;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 22px;
        y: 116px;
        width: parent.width - 44px;
        height: 20px;
        text: AppState.en ? "Redemption code" : "兑换码";
        color: AppTheme.text;
        font-size: 12px;
        font-weight: 500;
        vertical-alignment: center;
    }
    Rectangle {
        x: 22px;
        y: 142px;
        width: parent.width - 190px;
        height: 48px;
        background: AppTheme.panel-soft;
        border-radius: 9px;
        border-width: 1px;
        border-color: redemption-input.has-focus ? AppTheme.accent : AppTheme.border;

        redemption-input := TextInput {
            x: 16px;
            width: parent.width - 32px;
            height: parent.height;
            text <=> AppState.credit-redemption-code;
            enabled: !AppState.credit-redemption-busy;
            single-line: true;
            color: AppTheme.text;
            font-size: 14px;
            vertical-alignment: center;
            edited => {
                AppState.credit-redemption-success = false;
                AppState.credit-redemption-message = "";
            }
            accepted => { AppState.redeem-credits(redemption-input.text); }
        }
        if redemption-input.text == "" && !redemption-input.has-focus: Text {
            x: 16px;
            width: parent.width - 32px;
            height: parent.height;
            text: AppState.en ? "Enter or paste a redemption code" : "请输入或粘贴兑换码";
            color: AppTheme.weak;
            font-size: 14px;
            vertical-alignment: center;
        }
    }
    PillButton {
        x: parent.width - 146px;
        y: 146px;
        width: 124px;
        height: 40px;
        primary: true;
        disabled: redemption-input.text == "" || AppState.credit-redemption-busy;
        text: AppState.credit-redemption-busy
            ? (AppState.en ? "Redeeming..." : "兑换中...")
            : (AppState.en ? "Redeem now" : "立即兑换");
        clicked => { AppState.redeem-credits(redemption-input.text); }
    }
    if AppState.credit-redemption-message != "": Text {
        x: 22px;
        y: 202px;
        width: parent.width - 44px;
        height: 40px;
        text: AppState.credit-redemption-message;
        color: AppState.credit-redemption-success ? AppTheme.accent-dark : AppTheme.danger;
        font-size: 12px;
        font-weight: 400;
        vertical-alignment: top;
        wrap: word-wrap;
    }
    Rectangle {
        x: 22px;
        y: 246px;
        width: parent.width - 44px;
        height: 1px;
        background: AppTheme.border;
    }
    Text {
        x: 22px;
        y: 258px;
        width: parent.width - 44px;
        height: 32px;
        text: root.joined-team
            ? (AppState.en ? "Redeemed credits do not increase your monthly limit in other teams." : "兑换积分不会增加你在其他团队中的月额度。")
            : (AppState.en ? "After redemption, credits are added automatically to your own account." : "兑换成功后，积分将自动到账你自己的主账号。");
        color: AppTheme.muted;
        font-size: 12px;
        font-weight: 400;
        wrap: word-wrap;
        vertical-alignment: center;
    }
}

export component CreditsPage {
    function content-width() -> length {
        return root.width - 48px;
    }
    function content-height() -> length {
        return AppState.credits-tab == "membership"
            ? max(root.height + 80px, 860px)
            : (AppState.credits-tab == "redeem"
                ? max(root.height - 48px, 520px)
                : (AppState.credits-tab == "ledger"
                    ? max(root.height + 80px, 470px + max(1, AppState.credit-records.length) * 96px)
                    : max(root.height + 80px, 720px + (AppState.credit-promotion-active ? 170px : 0))));
    }
    Rectangle {
        background: AppTheme.bg;
        ScrollView {
            width: parent.width;
            height: parent.height;
            viewport-width: parent.width;
            viewport-height: root.content-height() + 48px;
            Rectangle {
                x: 24px;
                y: 24px;
                width: root.content-width();
                height: root.content-height();
                background: transparent;
                VerticalLayout {
                    spacing: 16px;
                    Rectangle {
                        height: 32px;
                        background: transparent;
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: AppState.en ? "Credits" : "积分";
                            color: AppTheme.text;
                            font-size: 22px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        Text {
                            x: parent.width - 92px;
                            width: 92px;
                            height: parent.height;
                            text: AppState.en ? "Credit rules" : "积分规则";
                            color: rule-touch.has-hover ? AppTheme.accent : AppTheme.muted;
                            font-size: 12px;
                            font-weight: 400;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        rule-touch := TouchArea {
                            x: parent.width - 92px;
                            width: 92px;
                            height: parent.height;
                            mouse-cursor: pointer;
                            clicked => { AppState.open-agreement(AppState.purchase-credit-rules-title, AppState.purchase-credit-rules-url); }
                        }
                    }
                    HorizontalLayout {
                        height: 40px;
                        spacing: 8px;
                        PillButton {
                            width: 96px;
                            text: AppState.en ? "Recharge" : "充值";
                            active: AppState.credits-tab == "recharge";
                            clicked => { AppState.credits-tab = "recharge"; }
                        }
                        PillButton {
                            width: 108px;
                            text: AppState.en ? "Credit details" : "积分明细";
                            active: AppState.credits-tab == "ledger";
                            clicked => { AppState.credits-tab = "ledger"; }
                        }
                        PillButton {
                            width: 96px;
                            text: AppState.en ? "Redeem" : "兑换码";
                            active: AppState.credits-tab == "redeem";
                            clicked => { AppState.credits-tab = "redeem"; }
                        }
                        PillButton {
                            width: 96px;
                            text: AppState.en ? "Subscription" : "订阅";
                            active: AppState.credits-tab == "membership";
                            clicked => { AppState.credits-tab = "membership"; }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    if AppState.credits-tab == "membership": MembershipPlans { horizontal-stretch: 1; }
                    if AppState.credits-tab == "redeem": VerticalLayout {
                        spacing: 16px;
                        CreditRedemptionPanel { horizontal-stretch: 1; }
                        Rectangle {
                            height: 86px;
                            background: AppTheme.panel-soft;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: AppTheme.border;

                            Text {
                                x: 16px;
                                y: 12px;
                                width: parent.width - 32px;
                                height: 20px;
                                text: AppState.en ? "Redemption notes" : "兑换说明";
                                color: AppTheme.text;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            Text {
                                x: 16px;
                                y: 38px;
                                width: parent.width - 32px;
                                height: 34px;
                                text: AppState.en
                                    ? "Codes are issued through official campaigns. Credit amounts and usage limits are determined by each campaign."
                                    : "兑换码由官方活动发放；可兑换积分、使用次数及适用范围以对应活动规则为准。";
                                color: AppTheme.muted;
                                font-size: 12px;
                                font-weight: 400;
                                wrap: word-wrap;
                                vertical-alignment: top;
                            }
                        }
                    }
                    if AppState.credits-tab == "recharge": VerticalLayout {
                        spacing: 16px;
                        CreditBalanceCard { horizontal-stretch: 1; }
                        if AppState.credit-promotion-active: MidAutumnHero { horizontal-stretch: 1; }
                        SectionTitle { text: AppState.en ? "Recharge" : "充值积分"; }
                        HorizontalLayout {
                            height: 174px;
                            spacing: 12px;
                            for pack in AppState.credit-packs: CreditPlan {
                                horizontal-stretch: 1;
                                code: pack.code;
                                amount: pack.credits;
                                bonus: pack.bonus-credits;
                                total: pack.total-credits;
                                title: pack.name;
                                note: pack.note;
                                price: pack.price;
                            }
                        }
                        PurchaseAgreements { horizontal-stretch: 1; }
                        Rectangle {
                            height: AppState.credit-payment-message == "" ? 82px : 108px;
                            background: transparent;
                            Text {
                                x: 0px;
                                y: 4px;
                                width: parent.width - 168px;
                                height: 24px;
                                text: AppState.selected-credit-pack-code == ""
                                    ? (AppState.en ? "Choose a pack to continue" : "充值档位待定")
                                    : (AppState.en
                                        ? ("Receive " + AppState.selected-credit-total + " credits · " + AppState.selected-credit-price)
                                        : ("到账 " + AppState.selected-credit-total + " 积分 · " + AppState.selected-credit-price));
                                color: AppTheme.text;
                                font-size: 14px;
                                font-weight: 500;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            PillButton {
                                x: parent.width - 144px;
                                y: 0px;
                                width: 144px;
                                height: 42px;
                                text: AppState.en ? "Recharge now" : "立即充值";
                                primary: true;
                                disabled: AppState.selected-credit-pack-code == "" || AppState.credit-payment-busy;
                                clicked => { AppState.recharge-credits(AppState.selected-credit-pack-code); }
                            }
                            if AppState.credit-payment-message != "": Text {
                                x: 0px;
                                y: 52px;
                                width: parent.width;
                                height: 20px;
                                text: AppState.credit-payment-message;
                                color: AppState.credit-payment-busy ? AppTheme.accent : AppTheme.danger;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        Rectangle {
                            height: 58px;
                            background: AppTheme.panel-soft;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: AppTheme.border;
                            Text {
                                x: 14px;
                                width: parent.width - 28px;
                                height: parent.height;
                                text: AppState.en ? "Generation pricing and available qualities come from the current server model catalog." : "生图价格、可用画质和提示词服务价格均以服务端当前模型目录为准。";
                                color: AppTheme.muted;
                                font-size: 13px;
                                font-weight: 400;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                    if AppState.credits-tab == "ledger": VerticalLayout {
                        spacing: 16px;
                        CreditBalanceCard { horizontal-stretch: 1; }
                        CreditLedgerSection { horizontal-stretch: 1; }
                    }
                }
            }
        }
    }
}
