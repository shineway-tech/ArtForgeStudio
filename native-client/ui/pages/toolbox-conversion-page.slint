import { AppState } from "../app-state.slint";
import { CompressionDropArea, CompressionListRow } from "toolbox-compression-page.slint";
import { PillButton } from "../components/pill-button.slint";
import { AppTheme } from "../theme.slint";

component ConversionFormatSelect {
    in-out property <string> value: "jpeg";
    property <bool> open: false;
    in property <bool> disabled: false;

    function format-label(value: string) -> string {
        if value == "png" {
            return "PNG (.png)";
        }
        if value == "webp" {
            return "WebP (.webp)";
        }
        if value == "bmp" {
            return "BMP (.bmp)";
        }
        if value == "avif" {
            return "AVIF (.avif)";
        }
        return "JPEG (.jpg)";
    }

    Rectangle {
        opacity: root.disabled ? 0.55 : 1.0;
        background: AppTheme.bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: root.open ? AppTheme.accent : AppTheme.border;

        Text {
            x: 12px;
            width: parent.width - 42px;
            height: parent.height;
            text: root.format-label(root.value);
            color: AppTheme.text;
            font-size: 13px;
            font-weight: 400;
            vertical-alignment: center;
            overflow: elide;
        }

        Image {
            x: parent.width - 28px;
            y: (parent.height - 12px) / 2;
            width: 12px;
            height: 12px;
            source: @image-url("../../assets/icons/dropdown.svg");
            colorize: AppTheme.muted;
            image-fit: contain;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: root.disabled ? default : pointer;
            clicked => {
                if !root.disabled {
                    root.open = true;
                    format-popup.show();
                }
            }
        }
    }

    format-popup := PopupWindow {
        x: 0px;
        y: 46px;
        width: root.width;
        height: 213px;
        close-policy: close-on-click-outside;

        Rectangle {
            visible: root.open;
            background: AppTheme.panel;
            border-radius: 8px;
            border-width: 1px;
            border-color: AppTheme.border;

            VerticalLayout {
                padding: 5px;
                spacing: 2px;

                for option in [
                    { value: "jpeg", label: "JPEG (.jpg)" },
                    { value: "png", label: "PNG (.png)" },
                    { value: "webp", label: "WebP (.webp)" },
                    { value: "bmp", label: "BMP (.bmp)" },
                    { value: "avif", label: "AVIF (.avif)" },
                ]: Rectangle {
                    height: 39px;
                    background: option-touch.has-hover || root.value == option.value
                        ? AppTheme.panel-soft
                        : transparent;
                    border-radius: 6px;

                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text: option.label;
                        color: root.value == option.value ? AppTheme.accent-dark : AppTheme.text;
                        font-size: 13px;
                        font-weight: 400;
                        vertical-alignment: center;
                    }

                    option-touch := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: pointer;
                        clicked => {
                            root.value = option.value;
                            root.open = false;
                            format-popup.close();
                        }
                    }
                }
            }
        }
    }
}

export component ToolboxConversionPage {
    function content-width() -> length {
        return max(820px, root.width - 64px);
    }

    function left-width() -> length {
        return max(480px, (root.content-width() - 20px) * 0.58);
    }

    function target-format-label() -> string {
        if AppState.conversion-target-format == "png" {
            return "PNG (.png)";
        }
        if AppState.conversion-target-format == "webp" {
            return "WebP (.webp)";
        }
        if AppState.conversion-target-format == "bmp" {
            return "BMP (.bmp)";
        }
        if AppState.conversion-target-format == "avif" {
            return "AVIF (.avif)";
        }
        return "JPEG (.jpg)";
    }

    function accept-drop(data: data-transfer) -> bool {
        if AppState.add-conversion-images-from-drag(data) {
            conversion-keys.focus();
            return true;
        }
        return false;
    }

    Rectangle {
        background: AppTheme.bg;

        Text {
            x: 32px;
            y: 28px;
            width: parent.width - 64px;
            height: 32px;
            text: AppState.en ? "Convert Image Format" : "图片转格式";
            color: AppTheme.text;
            font-size: 24px;
            font-weight: 600;
            vertical-alignment: center;
        }

        Text {
            x: 32px;
            y: 68px;
            width: parent.width - 64px;
            height: 22px;
            text: AppState.en
                ? "Upload up to 50 images and configure one output format for the batch"
                : "一次最多上传 50 张图片，并统一设置本批次输出格式";
            color: AppTheme.muted;
            font-size: 13px;
            font-weight: 400;
            vertical-alignment: center;
        }

        if AppState.conversion-images.length == 0: CompressionDropArea {
            x: 32px;
            y: 112px;
            width: root.content-width();
            height: 178px;
            choose-images => { AppState.choose-conversion-images(); }
            dropped(data) => { return root.accept-drop(data); }
        }

        if AppState.conversion-images.length > 0: Rectangle {
            x: 32px;
            y: 112px;
            width: root.left-width();
            height: parent.height - 144px;
            background: AppTheme.panel;
            border-radius: 12px;
            border-width: 1px;
            border-color: AppTheme.border;

            Text {
                x: 18px;
                y: 14px;
                width: 180px;
                height: 32px;
                text: (AppState.en ? "Uploaded " : "已上传 ")
                    + AppState.conversion-images.length
                    + (AppState.en ? " / 50" : " / 50 张");
                color: AppTheme.text;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
            }

            PillButton {
                x: parent.width - 204px;
                y: 12px;
                width: 92px;
                height: 34px;
                text: AppState.en ? "Add images" : "继续添加";
                disabled: AppState.conversion-processing || AppState.conversion-saving;
                clicked => { AppState.choose-conversion-images(); }
            }

            PillButton {
                x: parent.width - 102px;
                y: 12px;
                width: 84px;
                height: 34px;
                text: AppState.en ? "Clear" : "清空";
                danger: true;
                disabled: AppState.conversion-processing || AppState.conversion-saving;
                clicked => { AppState.clear-conversion-images(); }
            }

            list := Flickable {
                x: 16px;
                y: 58px;
                width: parent.width - 32px;
                height: parent.height - 74px;
                viewport-width: self.width;
                viewport-height: max(self.height, AppState.conversion-images.length * 70px);

                for item[index] in AppState.conversion-images: CompressionListRow {
                    x: 0px;
                    y: index * 70px;
                    width: list.width;
                    height: 62px;
                    item: item;
                    processing-text: AppState.en ? "Converting" : "转换中";
                    result-action-text: AppState.en ? "Save" : "保存";
                    result-action-visible: item.status == "completed" && item.result-path != "";
                    result-action-disabled: AppState.conversion-saving;
                    remove-disabled: AppState.conversion-processing || AppState.conversion-saving;
                    remove => { AppState.remove-conversion-image(item.id); }
                    result-action => { AppState.save-conversion-result(item.id); }
                }
            }

            list-drop := DropArea {
                width: parent.width;
                height: parent.height;
                can-drop(event) => {
                    return !AppState.conversion-processing && !AppState.conversion-saving
                        ? DragAction.copy
                        : DragAction.none;
                }
                dropped(event) => {
                    return root.accept-drop(event.data) ? DragAction.copy : DragAction.none;
                }
            }

            if list-drop.has-drag: Rectangle {
                x: 8px;
                y: 56px;
                width: parent.width - 16px;
                height: parent.height - 64px;
                background: AppTheme.accent.with-alpha(0.10);
                border-radius: 10px;
                border-width: 2px;
                border-color: AppTheme.accent;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: AppState.en ? "Release to add images" : "松开即可添加图片";
                    color: AppTheme.accent;
                    font-size: 15px;
                    font-weight: 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if AppState.conversion-images.length > 0: Rectangle {
            x: 52px + root.left-width();
            y: 112px;
            width: root.content-width() - root.left-width() - 20px;
            height: parent.height - 144px;
            background: AppTheme.panel;
            border-radius: 12px;
            border-width: 1px;
            border-color: AppTheme.border;

            Text {
                x: 22px;
                y: 18px;
                width: parent.width - 44px;
                height: 24px;
                text: AppState.en ? "Conversion settings" : "转换设置";
                color: AppTheme.text;
                font-size: 16px;
                font-weight: 600;
                vertical-alignment: center;
            }

            Text {
                x: 22px;
                y: 56px;
                width: parent.width - 44px;
                height: 20px;
                text: AppState.conversion-source-format + " → " + root.target-format-label();
                color: AppTheme.muted;
                font-size: 12px;
                font-weight: 400;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                x: 22px;
                y: 92px;
                width: 72px;
                height: 42px;
                text: AppState.en ? "Convert to" : "转换为";
                color: AppTheme.muted;
                font-size: 12px;
                font-weight: 400;
                vertical-alignment: center;
            }

            ConversionFormatSelect {
                x: 96px;
                y: 92px;
                width: min(190px, parent.width - 118px);
                height: 42px;
                value <=> AppState.conversion-target-format;
                disabled: AppState.conversion-processing || AppState.conversion-saving;
            }

            Text {
                x: 22px;
                y: 158px;
                width: parent.width - 44px;
                height: 22px;
                text: (AppState.en ? "Total " : "共 ")
                    + AppState.conversion-images.length
                    + (AppState.en ? " image(s)" : " 张");
                color: AppTheme.muted;
                font-size: 12px;
                font-weight: 400;
                vertical-alignment: center;
            }

            if AppState.conversion-message != "": Text {
                x: 22px;
                y: parent.height - 132px;
                width: parent.width - 44px;
                height: 24px;
                text: AppState.conversion-message;
                color: AppTheme.muted;
                font-size: 12px;
                font-weight: 400;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                x: 22px;
                y: parent.height - 104px;
                width: parent.width - 44px;
                height: 20px;
                text: AppState.en
                    ? "Conversion runs locally. Images are not uploaded."
                    : "转换仅在本地进行，不会上传图片";
                color: AppTheme.muted;
                font-size: 12px;
                font-weight: 400;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }

            PillButton {
                x: 22px;
                y: parent.height - 72px;
                width: parent.width - 44px;
                height: 48px;
                text: AppState.conversion-processing
                    ? (AppState.en ? "Converting..." : "转换中...")
                    : (AppState.conversion-has-results
                        ? (AppState.en ? "Convert again" : "重新转换")
                        : (AppState.en ? "Start conversion" : "开始转换"));
                primary: true;
                disabled: AppState.conversion-images.length == 0
                    || AppState.conversion-processing
                    || AppState.conversion-saving;
                clicked => { AppState.start-conversion(); }
            }
        }

        if AppState.conversion-images.length == 0 && AppState.conversion-message != "": Text {
            x: 32px;
            y: 304px;
            width: root.content-width();
            height: 24px;
            text: AppState.conversion-message;
            color: AppTheme.muted;
            font-size: 12px;
            font-weight: 400;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        conversion-keys := FocusScope {
            width: parent.width;
            height: parent.height;
            init => { self.focus(); }
            key-pressed(event) => {
                if event.modifiers.control && (event.text == "v" || event.text == "V") {
                    if AppState.paste-conversion-images() {
                        return accept;
                    }
                }
                return reject;
            }
        }
    }
}
