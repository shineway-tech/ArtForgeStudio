import { ScrollView } from "std-widgets.slint";
import { AppState } from "../app-state.slint";
import { CardStyleOption } from "../components/card-style-option.slint";
import { CustomPromptSettings } from "../components/custom-prompt-settings.slint";
import { DirRow } from "../components/dir-row.slint";
import { FontPicker } from "../components/font-picker.slint";
import { FontStepButton } from "../components/font-step-button.slint";
import { LoadingDots } from "../components/loading-dots.slint";
import { ModelsPage } from "models-page.slint";
import { PillButton } from "../components/pill-button.slint";
import { ThemeTile } from "../components/theme-tile.slint";
import { AppTheme } from "../theme.slint";

component RecommendationCard inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> url;
    in property <image> artwork;

    background: transparent;

    surface := Rectangle {
        y: card-touch.has-hover ? -5px : 0px;
        width: parent.width;
        height: parent.height;
        background: card-touch.has-hover ? AppTheme.panel-soft : AppTheme.panel;
        border-radius: 14px;
        border-width: 1px;
        border-color: card-touch.has-hover ? AppTheme.accent : AppTheme.border;
        drop-shadow-blur: card-touch.has-hover ? 18px : 8px;
        drop-shadow-color: card-touch.has-hover ? #00000045 : #00000024;
        drop-shadow-offset-y: card-touch.has-hover ? 9px : 3px;

        animate y { duration: 180ms; easing: ease-out; }
        animate background { duration: 160ms; }
        animate border-color { duration: 160ms; }

        artwork-frame := Rectangle {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: (parent.height - 24px) * 0.58;
            border-radius: 10px;
            clip: true;
            background: AppTheme.panel-soft;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.artwork;
                image-fit: cover;
            }
        }
        Text {
            x: 16px;
            y: artwork-frame.y + artwork-frame.height + 12px;
            width: parent.width - 32px;
            text: root.title;
            color: AppTheme.text;
            font-size: 17px;
            font-weight: 600;
            overflow: elide;
        }
        Text {
            x: 16px;
            y: artwork-frame.y + artwork-frame.height + 40px;
            width: parent.width - 32px;
            height: parent.height - self.y - 12px;
            text: root.description;
            color: AppTheme.muted;
            font-size: 12px;
            font-weight: 400;
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: top;
        }
    }

    card-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { AppState.open-external-link(root.url); }
    }
}

export component SettingsPage {
    out property <length> card-size: min(230px, max(160px, (root.width - 370px) / 2));
    out property <bool> recommendations-wrap: root.width < 1080px;

    function models-height() -> length {
        if AppState.catalog-models.length == 0 {
            return 360px;
        }
        return 132px + AppState.catalog-models.length * 148px;
    }

    function page-height() -> length {
        if AppState.settings-section == "models" {
            return max(960px, 126px + root.models-height());
        }
        return 960px;
    }

    Rectangle {
        background: AppTheme.bg;
        ScrollView {
            width: parent.width;
            height: parent.height;
            viewport-width: parent.width;
            viewport-height: max(root.page-height(), parent.height);
            Rectangle {
                property <length> left-w: 250px;
                property <length> gap: 28px;
                property <length> content-x: 24px + left-w + gap;
                property <length> content-w: parent.width - content-x - 48px;
                x: 0px;
                y: 0px;
                width: parent.width;
                height: max(root.page-height(), parent.height);
                background: transparent;

                Rectangle {
                    x: 24px;
                    y: 30px;
                    width: left-w;
                    height: parent.height - 60px;
                    background: AppTheme.panel;
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: AppTheme.border;
                    Text { x: 18px; y: 24px; text: AppState.en ? "Settings" : "设置"; color: AppTheme.text; font-size: 22px; font-weight: 600; }
                    Rectangle {
                        x: 16px;
                        y: 86px;
                        width: parent.width - 32px;
                        height: 62px;
                        background: AppState.settings-section == "basic" ? AppTheme.panel-soft : transparent;
                        border-radius: 10px;
                        if AppState.settings-section == "basic": Rectangle { x: 0px; y: 14px; width: 3px; height: 24px; border-radius: 2px; background: AppTheme.accent; }
                        Text { x: 18px; y: 10px; text: AppState.en ? "Basic" : "基础设置"; color: AppState.settings-section == "basic" ? AppTheme.text : AppTheme.muted; font-size: 14px; font-weight: 400; }
                        Text { x: 18px; y: 34px; text: AppState.en ? "Theme, font, folders" : "主题、字体、目录"; color: AppTheme.weak; font-size: 12px; font-weight: 400; }
                        TouchArea { width: parent.width; height: parent.height; mouse-cursor: pointer; clicked => { AppState.settings-section = "basic"; } }
                    }
                    Rectangle {
                        x: 16px;
                        y: 168px;
                        width: parent.width - 32px;
                        height: 62px;
                        background: AppState.settings-section == "prompts" ? AppTheme.panel-soft : transparent;
                        border-radius: 10px;
                        if AppState.settings-section == "prompts": Rectangle { x: 0px; y: 14px; width: 3px; height: 24px; border-radius: 2px; background: AppTheme.accent; }
                        Text { x: 18px; y: 10px; text: AppState.en ? "Custom prompts" : "自定义提示词"; color: AppState.settings-section == "prompts" ? AppTheme.text : AppTheme.muted; font-size: 14px; font-weight: 400; }
                        Text { x: 18px; y: 34px; text: AppState.en ? "Personal prompt library" : "个人提示词库"; color: AppTheme.weak; font-size: 12px; font-weight: 400; }
                        TouchArea { width: parent.width; height: parent.height; mouse-cursor: pointer; clicked => { AppState.settings-section = "prompts"; } }
                    }
                    Rectangle {
                        x: 16px;
                        y: 250px;
                        width: parent.width - 32px;
                        height: 62px;
                        background: AppState.settings-section == "models" ? AppTheme.panel-soft : transparent;
                        border-radius: 10px;
                        if AppState.settings-section == "models": Rectangle { x: 0px; y: 14px; width: 3px; height: 24px; border-radius: 2px; background: AppTheme.accent; }
                        Text { x: 18px; y: 10px; text: AppState.en ? "Model Management" : "模型管理"; color: AppState.settings-section == "models" ? AppTheme.text : AppTheme.muted; font-size: 14px; font-weight: 400; }
                        Text { x: 18px; y: 34px; text: AppState.en ? "Models and pricing" : "服务模型与计费"; color: AppTheme.weak; font-size: 12px; font-weight: 400; }
                        TouchArea { width: parent.width; height: parent.height; mouse-cursor: pointer; clicked => { AppState.settings-section = "models"; } }
                    }
                    Rectangle {
                        x: 16px;
                        y: 332px;
                        width: parent.width - 32px;
                        height: 62px;
                        background: AppState.settings-section == "about" ? AppTheme.panel-soft : transparent;
                        border-radius: 10px;
                        if AppState.settings-section == "about": Rectangle { x: 0px; y: 14px; width: 3px; height: 24px; border-radius: 2px; background: AppTheme.accent; }
                        Text { x: 18px; y: 10px; text: AppState.en ? "About" : "关于"; color: AppState.settings-section == "about" ? AppTheme.text : AppTheme.muted; font-size: 14px; font-weight: 400; }
                        Text { x: 18px; y: 34px; text: AppState.en ? "Version and paths" : "版本与配置位置"; color: AppTheme.weak; font-size: 12px; font-weight: 400; }
                        update-indicator := Rectangle {
                            visible: AppState.update-available;
                            x: parent.width - 24px;
                            y: 12px;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: AppTheme.danger;
                        }
                        TouchArea { width: parent.width; height: parent.height; mouse-cursor: pointer; clicked => { AppState.settings-section = "about"; } }
                    }
                    Rectangle {
                        x: 16px;
                        y: 414px;
                        width: parent.width - 32px;
                        height: 62px;
                        background: AppState.settings-section == "contact" ? AppTheme.panel-soft : transparent;
                        border-radius: 10px;
                        if AppState.settings-section == "contact": Rectangle { x: 0px; y: 14px; width: 3px; height: 24px; border-radius: 2px; background: AppTheme.accent; }
                        Text { x: 18px; y: 10px; text: AppState.en ? "Contact Us" : "联系我们"; color: AppState.settings-section == "contact" ? AppTheme.text : AppTheme.muted; font-size: 14px; font-weight: 400; }
                        Text { x: 18px; y: 34px; text: AppState.en ? "Community and support" : "官方群与客服"; color: AppTheme.weak; font-size: 12px; font-weight: 400; }
                        TouchArea { width: parent.width; height: parent.height; mouse-cursor: pointer; clicked => { AppState.settings-section = "contact"; } }
                    }
                }

                Text {
                    x: content-x;
                    y: 38px;
                    width: content-w;
                    text: AppState.settings-section == "contact"
                        ? (AppState.en ? "Contact Us" : "联系我们")
                        : (AppState.settings-section == "about"
                            ? (AppState.en ? "About" : "关于")
                            : (AppState.settings-section == "models"
                            ? (AppState.en ? "Model Management" : "模型管理")
                            : (AppState.settings-section == "prompts" ? (AppState.en ? "Custom prompts" : "自定义提示词") : (AppState.en ? "Basic Settings" : "基础设置"))));
                    color: AppTheme.text;
                    font-size: 24px;
                    font-weight: 600;
                }
                if AppState.settings-section == "basic": Rectangle {
                    x: content-x;
                    y: 96px;
                    width: content-w;
                    height: 270px;
                    background: transparent;
                    Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: AppTheme.border; }
                    Text { x: 0px; y: 0px; text: AppState.en ? "Theme color" : "主题颜色"; color: AppTheme.text; font-size: 14px; font-weight: 400; }
                    ThemeTile { x: 0px; y: 38px; width: (parent.width - 16px) / 3; id: "light"; label: AppState.en ? "Light" : "素白"; color: #ffffff; }
                    ThemeTile { x: ((parent.width - 16px) / 3 + 8px); y: 38px; width: (parent.width - 16px) / 3; id: "deep"; label: AppState.en ? "Deep Purple" : "深紫"; color: #4f46e5; }
                    ThemeTile { x: 2 * ((parent.width - 16px) / 3 + 8px); y: 38px; width: (parent.width - 16px) / 3; id: "ocean"; label: AppState.en ? "Ocean Blue" : "深海蓝"; color: #0ea5e9; }
                    ThemeTile { x: 0px; y: 94px; width: (parent.width - 16px) / 3; id: "forest"; label: AppState.en ? "Forest Green" : "森林绿"; color: #38c172; }
                    ThemeTile { x: ((parent.width - 16px) / 3 + 8px); y: 94px; width: (parent.width - 16px) / 3; id: "warm"; label: AppState.en ? "Warm Ink" : "暖墨棕"; color: #f59e0b; }
                    ThemeTile { x: 2 * ((parent.width - 16px) / 3 + 8px); y: 94px; width: (parent.width - 16px) / 3; id: "rose"; label: AppState.en ? "Rose" : "暗玫瑰"; color: #e11d48; }
                    ThemeTile { x: 0px; y: 150px; width: (parent.width - 16px) / 3; id: "cream"; label: AppState.en ? "Cream" : "奶白"; color: #c96b73; }
                    ThemeTile { x: ((parent.width - 16px) / 3 + 8px); y: 150px; width: (parent.width - 16px) / 3; id: "cyber"; label: AppState.en ? "Cyber Purple" : "赛博紫"; color: #d946ef; }
                    ThemeTile { x: 2 * ((parent.width - 16px) / 3 + 8px); y: 150px; width: (parent.width - 16px) / 3; id: "oled"; label: AppState.en ? "Black" : "纯黑"; color: #000000; }
                    ThemeTile { x: 0px; y: 206px; width: (parent.width - 16px) / 3; id: "system"; label: AppState.en ? "System" : "跟随系统"; color: #5b6472; }
                    ThemeTile { x: ((parent.width - 16px) / 3 + 8px); y: 206px; width: (parent.width - 16px) / 3; id: "user"; label: AppState.en ? "Custom" : "自定义"; color: #5b5fc7; }
                }
                if AppState.settings-section == "basic": Rectangle {
                    x: content-x;
                    y: 386px;
                    width: content-w;
                    height: 142px;
                    background: transparent;
                    Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: AppTheme.border; }
                    Text { x: 0px; y: 0px; text: AppState.en ? "Font" : "字体"; color: AppTheme.text; font-size: 14px; font-weight: 400; }
                    FontPicker { x: 0px; y: 36px; width: parent.width; }
                    HorizontalLayout {
                        x: 0px;
                        y: 94px;
                        width: 240px;
                        height: 36px;
                        spacing: 12px;
                        FontStepButton { horizontal-stretch: 0; text: "-"; clicked => { AppState.settings-font-size = max(10, AppState.settings-font-size - 1); } }
                        Text { width: 28px; horizontal-stretch: 0; text: AppState.settings-font-size; color: AppTheme.accent-dark; font-size: 16px; font-weight: 400; vertical-alignment: center; }
                        FontStepButton { horizontal-stretch: 0; text: "+"; clicked => { AppState.settings-font-size = min(24, AppState.settings-font-size + 1); } }
                        Text { width: 72px; horizontal-stretch: 0; text: "10 - 24"; color: AppTheme.muted; font-size: 13px; font-weight: 400; vertical-alignment: center; }
                    }
                }
                if AppState.settings-section == "basic": Rectangle {
                    x: content-x;
                    y: 550px;
                    width: content-w;
                    height: 142px;
                    background: transparent;
                    Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: AppTheme.border; }
                    Text { x: 0px; y: 0px; text: AppState.en ? "Card style" : "卡片设置"; color: AppTheme.text; font-size: 14px; font-weight: 400; }
                    HorizontalLayout {
                        x: 0px;
                        y: 36px;
                        width: parent.width;
                        height: 46px;
                        spacing: 12px;
                        CardStyleOption { horizontal-stretch: 1; id: "rounded"; label: AppState.en ? "Rounded" : "圆角"; }
                        CardStyleOption { horizontal-stretch: 1; id: "square"; label: AppState.en ? "Square" : "直角"; }
                    }
                }
                if AppState.settings-section == "basic": DirRow { x: content-x; y: 714px; width: content-w; label: AppState.en ? "Input folder" : "输入素材目录"; value: AppState.input-dir; kind: "input"; }
                if AppState.settings-section == "basic": DirRow { x: content-x; y: 792px; width: content-w; label: AppState.en ? "Output folder" : "输出目录"; value: AppState.output-dir; kind: "output"; }
                if AppState.settings-section == "basic": DirRow { x: content-x; y: 870px; width: content-w; label: AppState.en ? "Prompt folder" : "提示词模板目录"; value: AppState.prompt-dir; kind: "prompt"; }
                if AppState.settings-section == "prompts": CustomPromptSettings {
                    x: content-x;
                    y: 96px;
                    width: content-w;
                    height: parent.height - 126px;
                }
                if AppState.settings-section == "models": ModelsPage {
                    x: content-x;
                    y: 96px;
                    width: content-w;
                    height: root.models-height();
                }
                if AppState.settings-section == "contact": Rectangle {
                    x: content-x;
                    y: 96px;
                    width: content-w;
                    height: 390px;
                    background: AppTheme.panel;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: AppTheme.border;

                    Text {
                        x: 22px;
                        y: 20px;
                        width: parent.width - 44px;
                        height: 26px;
                        text: AppState.en ? "Community & Support" : "官方群与客服";
                        color: AppTheme.text;
                        font-size: 18px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 22px;
                        y: 50px;
                        width: parent.width - 44px;
                        height: 22px;
                        text: AppState.en ? "Feedback, tutorials and product support" : "问题反馈、教程交流与产品支持";
                        color: AppTheme.muted;
                        font-size: 13px;
                        font-weight: 400;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        x: 22px;
                        y: 94px;
                        width: parent.width - 44px;
                        height: 78px;
                        background: AppTheme.panel-soft;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: AppTheme.border;
                        Text { x: 16px; y: 12px; text: AppState.en ? "Official group" : "官方群"; color: AppTheme.muted; font-size: 12px; font-weight: 400; }
                        Text { x: 16px; y: 39px; width: parent.width - 122px; text: "1090665775"; color: AppTheme.text; font-size: 16px; font-weight: 500; overflow: elide; }
                        PillButton { x: parent.width - 88px; y: 21px; width: 72px; height: 36px; label-font-size: 12px; text: AppState.en ? "Copy" : "复制"; clicked => { AppState.copy-contact-detail("1090665775"); } }
                    }
                    Rectangle {
                        x: 22px;
                        y: 184px;
                        width: parent.width - 44px;
                        height: 78px;
                        background: AppTheme.panel-soft;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: AppTheme.border;
                        Text { x: 16px; y: 12px; text: AppState.en ? "Customer service WeChat" : "客服微信"; color: AppTheme.muted; font-size: 12px; font-weight: 400; }
                        Text { x: 16px; y: 39px; width: parent.width - 122px; text: "dyx346"; color: AppTheme.text; font-size: 16px; font-weight: 500; overflow: elide; }
                        PillButton { x: parent.width - 88px; y: 21px; width: 72px; height: 36px; label-font-size: 12px; text: AppState.en ? "Copy" : "复制"; clicked => { AppState.copy-contact-detail("dyx346"); } }
                    }
                    Rectangle {
                        x: 22px;
                        y: 274px;
                        width: parent.width - 44px;
                        height: 78px;
                        background: AppTheme.panel-soft;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: AppTheme.border;
                        Text { x: 16px; y: 12px; text: AppState.en ? "Customer service email" : "客服邮箱"; color: AppTheme.muted; font-size: 12px; font-weight: 400; }
                        Text { x: 16px; y: 39px; width: parent.width - 122px; text: "business@honeykid.cn"; color: AppTheme.text; font-size: 16px; font-weight: 500; overflow: elide; }
                        PillButton { x: parent.width - 88px; y: 21px; width: 72px; height: 36px; label-font-size: 12px; text: AppState.en ? "Copy" : "复制"; clicked => { AppState.copy-contact-detail("business@honeykid.cn"); } }
                    }
                }
                if AppState.settings-section == "about": Rectangle {
                    x: content-x;
                    y: 96px;
                    width: content-w;
                    height: 270px;
                    background: AppTheme.panel;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: AppTheme.border;
                    Text { x: 18px; y: 18px; text: AppState.en ? "Version" : "版本信息"; color: AppTheme.text; font-size: 14px; font-weight: 400; }
                    Text { x: 18px; y: 58px; text: "Elunvi Canvas"; color: AppTheme.text; font-size: 18px; font-weight: 500; }
                    Text { x: 18px; y: 88px; text: AppState.en ? ("Version: " + AppState.current-version) : ("版本：" + AppState.current-version); color: AppTheme.muted; font-size: 13px; font-weight: 400; }
                    if AppState.update-available: Rectangle {
                        x: 18px;
                        y: 116px;
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: AppTheme.danger;
                    }
                    Text {
                        visible: AppState.update-available || AppState.update-checking;
                        x: AppState.update-available ? 34px : 18px;
                        y: 110px;
                        width: parent.width - 300px;
                        height: 22px;
                        text: AppState.update-checking ? (AppState.en ? "Checking for updates..." : "正在检查版本...")
                            : (AppState.update-available ? (AppState.en ? ("New version " + AppState.latest-version + " available") : ("发现新版本 " + AppState.latest-version))
                            : AppState.update-message);
                        color: AppState.update-available ? AppTheme.danger : AppTheme.muted;
                        font-size: 13px;
                        font-weight: 400;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        x: parent.width - 246px;
                        y: 78px;
                        width: 220px;
                        height: 36px;
                        spacing: 10px;
                        PillButton {
                            horizontal-stretch: 1;
                            text: AppState.update-checking ? (AppState.en ? "Checking" : "检查中") : (AppState.en ? "Check" : "检查版本");
                            disabled: AppState.update-checking;
                            clicked => { AppState.check-version(); }
                        }
                        PillButton {
                            horizontal-stretch: 1;
                            text: AppState.en ? "Update" : "更新";
                            primary: AppState.update-available;
                            disabled: !AppState.update-available || AppState.update-checking;
                            clicked => { AppState.start-update(); }
                        }
                    }
                    if AppState.update-checking: LoadingDots {
                        x: parent.width - 268px;
                        y: 75px;
                        width: 28px;
                        height: 28px;
                    }
                    Rectangle { x: 18px; y: 150px; width: parent.width - 36px; height: 1px; background: AppTheme.border; }
                    Text { x: 18px; y: 176px; text: AppState.en ? "Config path" : "配置位置"; color: AppTheme.text; font-size: 14px; font-weight: 400; }
                    Text { x: 18px; y: 206px; width: parent.width - 36px; text: AppState.input-dir; color: AppTheme.muted; font-size: 13px; font-weight: 400; overflow: elide; }
                }
                if AppState.settings-section == "about": Text {
                    x: content-x;
                    y: 404px;
                    text: AppState.en ? "You may also like" : "你可能喜欢";
                    color: AppTheme.text;
                    font-size: 20px;
                    font-weight: 600;
                }
                if AppState.settings-section == "about": RecommendationCard {
                    x: content-x;
                    y: 444px;
                    width: root.card-size;
                    height: root.card-size;
                    title: AppState.en ? "Audio Separation" : "声音分离";
                    description: AppState.en ? "Extract complete audio from a video" : "从视频完整分离音频";
                    url: "https://www.shineway.tech/biyi/feature/audio";
                    artwork: @image-url("../../assets/recommendations/audio-separation.png");
                }
                if AppState.settings-section == "about": RecommendationCard {
                    x: content-x + root.card-size + 20px;
                    y: 444px;
                    width: root.card-size;
                    height: root.card-size;
                    title: AppState.en ? "Beyond Words" : "言外之意";
                    description: AppState.en ? "Understand what they really mean" : "读懂ta的弦外之音";
                    url: "https://www.shineway.tech/biyi/feature/chat";
                    artwork: @image-url("../../assets/recommendations/conversation-insight.png");
                }
                if AppState.settings-section == "about": RecommendationCard {
                    x: root.recommendations-wrap ? content-x : content-x + 2 * (root.card-size + 20px);
                    y: root.recommendations-wrap ? 444px + root.card-size + 20px : 444px;
                    width: root.card-size;
                    height: root.card-size;
                    title: AppState.en ? "Marketing Master" : "营销大师";
                    description: AppState.en ? "AI marketing content creation tool" : "AI 营销内容创作工具";
                    url: "https://www.shineway.tech/product/marketing-master/";
                    artwork: @image-url("../../assets/recommendations/marketing-master.png");
                }
            }
        }
    }
}
